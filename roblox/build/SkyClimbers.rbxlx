          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Always-on HUD: climb counter, cash, stamina, height meter, action buttons,
-- wind warning. Setters only touch the UI when a value actually changes.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Hud = {}
Hud.__index = Hud

export type Actions = {
	shop: () -> (),
	chalk: () -> (),
	ragdoll: () -> (),
	plaza: () -> (),
	letGo: () -> (),
	clip: () -> (),
	rappel: () -> (),
	emotes: () -> (),
	settings: () -> (),
}

local function label(props: { [string]: any }): TextLabel
	return C.new("TextLabel", props)
end

function Hud.new(actions: Actions)
	local self = setmetatable({}, Hud)
	self._cache = {}

	local gui = C.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local root = C.autoScale(gui)
	self.gui = gui

	-- Top centre: the climb counter ---------------------------------------------
	local climbsPanel = C.panel({
		Name = "Climbs",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(320, 64),
		Parent = root,
	}, { C.stroke(Theme.Accent, 2, 0.35) })
	self._climbScale = C.new("UIScale", { Parent = climbsPanel })
	self.climbs = label({
		Size = UDim2.new(1, 0, 0, 38),
		Position = UDim2.fromOffset(0, 6),
		Font = Theme.Title,
		Text = "Tower climbs: 0",
		TextSize = 28,
		Parent = climbsPanel,
	})
	self.subline = label({
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 42),
		Font = Theme.Body,
		Text = "Best height 0  ·  Streak 0",
		TextSize = 14,
		TextColor3 = Theme.Muted,
		Parent = climbsPanel,
	})

	-- Wind warning banner, under the counter.
	self.wind = C.panel({
		Name = "Wind",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 84),
		Size = UDim2.fromOffset(300, 36),
		BackgroundColor3 = Color3.fromRGB(40, 70, 120),
		Visible = false,
		Parent = root,
	})
	self.windText = label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Bold,
		TextSize = 17,
		Text = "",
		Parent = self.wind,
	})

	-- Top left: cash -------------------------------------------------------------
	local cashPanel = C.panel({
		Name = "Cash",
		Position = UDim2.fromOffset(16, 70),
		Size = UDim2.fromOffset(190, 48),
		Parent = root,
	})
	label({
		Size = UDim2.fromOffset(40, 48),
		Position = UDim2.fromOffset(6, 0),
		Font = Theme.Title,
		Text = "$",
		TextSize = 30,
		TextColor3 = Theme.Good,
		Parent = cashPanel,
	})
	self.cash = label({
		Size = UDim2.new(1, -50, 1, 0),
		Position = UDim2.fromOffset(40, 0),
		Font = Theme.Title,
		Text = "0",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = cashPanel,
	})
	self._cashScale = C.new("UIScale", { Parent = cashPanel })

	-- Weather pill under the cash.
	self.weatherPanel = C.panel({
		Name = "Weather",
		Position = UDim2.fromOffset(16, 126),
		Size = UDim2.fromOffset(190, 34),
		Parent = root,
	})
	self.weather = label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Bold,
		Text = "Clear skies",
		TextSize = 14,
		Parent = self.weatherPanel,
	})

	-- Settings button, bottom-left.
	C.button({
		Name = "SettingsButton",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, -24),
		Size = UDim2.fromOffset(150, 46),
		BackgroundColor3 = Color3.fromRGB(45, 52, 72),
		Text = if not UserInputService.TouchEnabled or UserInputService.KeyboardEnabled then "SETTINGS  [O]" else "SETTINGS",
		TextSize = 16,
		Parent = root,
	}, actions.settings)

	-- Rope status under the weather.
	self.ropePanel = C.panel({
		Name = "Rope",
		Position = UDim2.fromOffset(16, 166),
		Size = UDim2.fromOffset(190, 34),
		Parent = root,
	})
	self.rope = label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Bold,
		Text = "Rope: not clipped",
		TextSize = 14,
		TextColor3 = Theme.Muted,
		Parent = self.ropePanel,
	})

	-- Emote bar above the stamina panel (toggled with G / the EMOTES button).
	self.emoteBar = C.new("Frame", {
		Name = "EmoteBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -114),
		Size = UDim2.fromOffset(640, 46),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = root,
	}, {
		C.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	-- Left: altitude meter ---------------------------------------------------------
	local meter = C.panel({
		Name = "Altitude",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(150, 250),
		Parent = root,
	}, { C.padding(12) })
	label({
		Size = UDim2.new(1, 0, 0, 14),
		Font = Theme.Bold,
		Text = "ALTITUDE",
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = meter,
	})
	self.height = label({
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 16),
		Font = Theme.Title,
		Text = "0",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = meter,
	})
	self.towerName = label({
		Size = UDim2.new(1, -24, 0, 34),
		Position = UDim2.fromOffset(0, 54),
		Font = Theme.Bold,
		Text = "Plaza",
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = meter,
	})
	self.towerInfo = label({
		Size = UDim2.new(1, -24, 0, 30),
		Position = UDim2.fromOffset(0, 90),
		Font = Theme.Body,
		Text = "",
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = meter,
	})
	local track = C.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.new(0, 10, 1, -20),
		BackgroundColor3 = Theme.PanelLight,
		Parent = meter,
	}, { C.round() })
	self.progress = C.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Theme.Accent,
		Parent = track,
	}, { C.round(), C.gradient(Theme.Gold, Theme.AccentDark) })
	self.progressText = label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, 0),
		Size = UDim2.fromOffset(80, 16),
		Font = Theme.Bold,
		Text = "",
		TextSize = 13,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = meter,
	})

	-- Bottom centre: stamina --------------------------------------------------------
	local staminaPanel = C.panel({
		Name = "Stamina",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(480, 78),
		Parent = root,
	}, { C.padding(14, 10) })
	self.status = label({
		Size = UDim2.new(1, -110, 0, 20),
		Font = Theme.Bold,
		Text = "Ready to climb",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = staminaPanel,
	})
	self.staminaText = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(110, 20),
		Font = Theme.Bold,
		Text = "100 / 100",
		TextSize = 15,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = staminaPanel,
	})
	local bar = C.new("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = Theme.PanelLight,
		ClipsDescendants = true,
		Parent = staminaPanel,
	}, { C.round() })
	self.staminaFill = C.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.StaminaHigh,
		Parent = bar,
	}, { C.round(), C.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)) })
	self.chalkGlow = C.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Chalk,
		BackgroundTransparency = 1,
		Parent = bar,
	}, { C.round() })
	self._barStroke = C.stroke(Theme.Bad, 2, 1)
	self._barStroke.Parent = bar

	-- Right: action buttons -------------------------------------------------------
	local column = C.new("Frame", {
		Name = "Actions",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(150, 420),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		C.new("UIListLayout", {
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local keyHints = not UserInputService.TouchEnabled or UserInputService.KeyboardEnabled
	local function action(order: number, text: string, key: string, color: Color3, fn: () -> ())
		return C.button({
			LayoutOrder = order,
			Size = UDim2.fromOffset(150, 44),
			BackgroundColor3 = color,
			Text = if keyHints then string.format("%s  [%s]", text, key) else text,
			TextSize = 17,
			Parent = column,
		}, fn)
	end
	action(1, "SHOP", "B", Color3.fromRGB(200, 140, 20), actions.shop)
	self.chalkButton = action(2, "CHALK x0", "C", Color3.fromRGB(70, 80, 110), actions.chalk)
	self.letGoButton = action(3, "LET GO", "Q", Color3.fromRGB(70, 80, 110), actions.letGo)
	self.clipButton = action(4, "CLIP ROPE", "F", Color3.fromRGB(200, 90, 30), actions.clip)
	action(5, "RAPPEL", "V", Color3.fromRGB(40, 120, 170), actions.rappel)
	action(6, "RAGDOLL", "R", Color3.fromRGB(150, 60, 70), actions.ragdoll)
	action(7, "EMOTES", "G", Color3.fromRGB(120, 70, 160), actions.emotes)
	action(8, "TO PLAZA", "P", Color3.fromRGB(50, 110, 90), actions.plaza)

	return self
end

function Hud:_set(key: string, inst: Instance, prop: string, value: any)
	if self._cache[key] ~= value then
		self._cache[key] = value;
		(inst :: any)[prop] = value
	end
end

local function pop(scale: UIScale, amount: number)
	scale.Scale = amount
	C.tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic)
end

function Hud:setClimbs(n: number, animate: boolean?)
	self:_set("climbs", self.climbs, "Text", "Tower climbs: " .. Theme.formatNumber(n))
	if animate then
		pop(self._climbScale, 1.3)
	end
end

function Hud:setSubline(best: number, streak: number)
	self:_set("sub", self.subline, "Text", string.format("Best height %s  ·  Daily streak %d", Theme.formatNumber(best), streak))
end

function Hud:setCash(n: number)
	local text = Theme.formatNumber(n)
	if self._cache.cash ~= text then
		local up = (self._cache.cashValue or n) < n
		self._cache.cashValue = n
		self:_set("cash", self.cash, "Text", text)
		if up then
			pop(self._cashScale, 1.2)
		end
	end
end

function Hud:setChalk(count: number, activeFraction: number)
	self:_set("chalkCount", self.chalkButton, "Text", (self.chalkButton.Text:gsub("x%d+", "x" .. count)))
	self:_set("chalkGlow", self.chalkGlow, "BackgroundTransparency", 1 - activeFraction * 0.45)
end

-- mode: "normal" | "fall" | "blackout" | "ragdoll"
function Hud:setStamina(current: number, max: number, dangerFraction: number, time: number)
	local frac = if max > 0 then current / max else 0
	self:_set("fill", self.staminaFill, "Size", UDim2.fromScale(math.clamp(frac, 0, 1), 1))
	local color = if frac < dangerFraction
		then Theme.StaminaLow
		elseif frac < 0.5 then Theme.StaminaMid:Lerp(Theme.StaminaLow, 1 - (frac - dangerFraction) / (0.5 - dangerFraction))
		else Theme.StaminaHigh:Lerp(Theme.StaminaMid, 1 - (frac - 0.5) / 0.5)
	self.staminaFill.BackgroundColor3 = color
	self:_set("stext", self.staminaText, "Text", string.format("%d / %d", math.floor(current + 0.5), max))
	-- Pulse the outline red when you're about to black out.
	local pulse = if frac < dangerFraction then 0.5 + 0.5 * math.sin(time * 10) else 1
	self._barStroke.Transparency = pulse
end

function Hud:setStatus(text: string, color: Color3?)
	self:_set("status", self.status, "Text", text)
	self:_set("statusColor", self.status, "TextColor3", color or Theme.Text)
end

function Hud:setAltitude(y: number, towerName: string?, towerInfo: string?, progress: number?)
	self:_set("height", self.height, "Text", Theme.formatNumber(math.max(0, y)) .. " studs")
	self:_set("tower", self.towerName, "Text", towerName or "Plaza")
	self:_set("towerInfo", self.towerInfo, "Text", towerInfo or "Walk to a tower to start a climb.")
	local p = math.clamp(progress or 0, 0, 1)
	self:_set("progress", self.progress, "Size", UDim2.fromScale(1, p))
	self:_set("progressText", self.progressText, "Text", if progress then string.format("%d%%", p * 100) else "")
end

-- kind: "carabiner" | "suction" | nil. canClip: a clip point is in reach.
function Hud:setRope(kind: any, canClip: boolean)
	local text, color
	if kind == "carabiner" then
		text, color = "Rope: clipped to beam", Theme.Good
	elseif kind == "suction" then
		text, color = "Rope: suction cup on", Theme.Good
	elseif canClip then
		text, color = "Rope: press F to clip in", Theme.Accent
	else
		text, color = "Rope: not clipped", Theme.Muted
	end
	self:_set("rope", self.rope, "Text", text)
	self:_set("ropeColor", self.rope, "TextColor3", color)
	self:_set("clipGlow", self.clipButton, "BackgroundColor3", if canClip then Color3.fromRGB(255, 130, 40) else Color3.fromRGB(200, 90, 30))
end

local WEATHER_TEXT = {
	Clear = { "Clear skies", Color3.fromRGB(255, 220, 120) },
	Rain = { "Rain: walls slippery!", Color3.fromRGB(120, 180, 255) },
}

function Hud:setWeather(name: string)
	local entry = WEATHER_TEXT[name] or WEATHER_TEXT.Clear
	self.weather.Text = entry[1]
	self.weather.TextColor3 = entry[2]
end

-- Rebuild the emote bar from the owned emotes: { { id, name } }.
function Hud:setEmotes(emotes: { { id: string, name: string } }, onPlay: (id: string) -> ())
	for _, child in self.emoteBar:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	for i, emote in emotes do
		C.button({
			LayoutOrder = i,
			Size = UDim2.fromOffset(84, 42),
			BackgroundColor3 = Color3.fromRGB(120, 70, 160),
			Text = emote.name,
			TextSize = 15,
			Parent = self.emoteBar,
		}, function()
			onPlay(emote.id)
		end)
	end
end

function Hud:toggleEmoteBar()
	self.emoteBar.Visible = not self.emoteBar.Visible
end

-- Highlight the LET GO button while you're on a wall.
function Hud:setClimbing(on: boolean)
	self:_set("climbing", self.letGoButton, "BackgroundColor3", if on then Color3.fromRGB(60, 130, 220) else Color3.fromRGB(70, 80, 110))
end

function Hud:setWind(text: string?)
	self.wind.Visible = text ~= nil
	if text then
		self.windText.Text = text
	end
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Overlay</string>
              <string name="Source"><![CDATA[-- Full-screen moments: blackout, summit celebration, hurt flash, toasts.
local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Overlay = {}
Overlay.__index = Overlay

local BLACKOUT_TIPS = {
	"Tip: hang still on a yellow rest bar to get your breath back.",
	"Tip: Endurance boosts let you climb further without resting.",
	"Tip: chalk halves stamina drain for a while. Press C.",
	"Tip: skyscraper glass is slippery. Sticky Gloves help.",
	"Tip: holding on between rest bars still costs stamina.",
	"Tip: press SPACE while falling to catch the wall.",
	"Tip: leaping is fast but costs more stamina than climbing.",
	"Tip: wind gusts can blow tired climbers clean off.",
}

function Overlay.new()
	local self = setmetatable({}, Overlay)
	local gui = C.new("ScreenGui", {
		Name = "Overlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local root = C.autoScale(gui)
	self.gui = gui

	-- Red edge flash when hurt.
	self.hurtFrame = C.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Bad,
		BackgroundTransparency = 1,
		Parent = root,
	})

	-- Blackout.
	self.black = C.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Parent = root,
	})
	self.blackTitle = C.new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(700, 70),
		Font = Theme.Title,
		Text = "YOU BLACKED OUT",
		TextSize = 54,
		TextTransparency = 1,
		ZIndex = 6,
		Parent = root,
	})
	self.blackTip = C.new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromOffset(700, 30),
		Font = Theme.Body,
		Text = "",
		TextSize = 20,
		TextColor3 = Theme.Muted,
		TextTransparency = 1,
		ZIndex = 6,
		Parent = root,
	})

	-- Summit banner.
	self.summit = C.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromOffset(520, 150),
		Visible = false,
		ZIndex = 3,
		Parent = root,
	}, { C.stroke(Theme.Gold, 3, 0) })
	self.summitScale = C.new("UIScale", { Parent = self.summit })
	self.summitTitle = C.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 70),
		Position = UDim2.fromOffset(0, 10),
		Font = Theme.Title,
		Text = "SUMMIT!",
		TextSize = 60,
		TextColor3 = Theme.Gold,
		ZIndex = 4,
		Parent = self.summit,
	})
	self.summitSub = C.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 80),
		Font = Theme.Bold,
		Text = "",
		TextSize = 24,
		TextColor3 = Theme.Good,
		ZIndex = 4,
		Parent = self.summit,
	})
	self.summitSub2 = C.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.fromOffset(0, 112),
		Font = Theme.Body,
		Text = "",
		TextSize = 18,
		TextColor3 = Theme.Text,
		ZIndex = 4,
		Parent = self.summit,
	})

	-- Toast stack, top right under the Roblox menu.
	self.toasts = C.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 70),
		Size = UDim2.fromOffset(340, 400),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		C.new("UIListLayout", {
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	-- Game-wide announcement banner.
	self.announce = C.panel({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 132),
		Size = UDim2.fromOffset(640, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		ZIndex = 8,
		Parent = root,
	}, { C.stroke(Theme.Info, 2, 0.2), C.padding(18, 12) })
	self.announceScale = C.new("UIScale", { Parent = self.announce })
	self.announceFrom = C.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		Font = Theme.Title,
		Text = "",
		TextSize = 14,
		TextColor3 = Theme.Info,
		ZIndex = 9,
		Parent = self.announce,
	})
	self.announceText = C.new("TextLabel", {
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Theme.Bold,
		Text = "",
		TextSize = 22,
		TextWrapped = true,
		ZIndex = 9,
		Parent = self.announce,
	})
	self._announceToken = 0
	self._toastOrder = 0
	self._summitToken = 0
	return self
end

function Overlay:blackout(on: boolean)
	local t = if on then 0.35 else 0.8
	C.tween(self.black, t, { BackgroundTransparency = if on then 0.05 else 1 }, Enum.EasingStyle.Sine)
	C.tween(self.blackTitle, t, { TextTransparency = if on then 0 else 1 })
	C.tween(self.blackTip, t, { TextTransparency = if on then 0 else 1 })
	if on then
		self.blackTip.Text = BLACKOUT_TIPS[math.random(1, #BLACKOUT_TIPS)]
	end
end

function Overlay:hurtFlash(damage: number)
	self.hurtFrame.BackgroundTransparency = math.clamp(0.9 - damage / 150, 0.45, 0.9)
	C.tween(self.hurtFrame, 0.8, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
end

function Overlay:showSummit(tower: string, payout: number, climbs: number)
	self._summitToken += 1
	local token = self._summitToken
	self.summitSub.Text = string.format("%s conquered  ·  +$%s", tower, Theme.formatNumber(payout))
	self.summitSub2.Text = "Tower climbs: " .. Theme.formatNumber(climbs)
	self.summit.Visible = true
	self.summitScale.Scale = 0.3
	C.tween(self.summitScale, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(3.5, function()
		if self._summitToken == token then
			C.tween(self.summitScale, 0.25, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In).Completed:Wait()
			if self._summitToken == token then
				self.summit.Visible = false
			end
		end
	end)
end

function Overlay:announcement(text: string, from: string)
	self._announceToken += 1
	local token = self._announceToken
	self.announceFrom.Text = "ANNOUNCEMENT  ·  " .. string.upper(from)
	self.announceText.Text = text
	self.announce.Visible = true
	self.announceScale.Scale = 0.6
	C.tween(self.announceScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(8, function()
		if self._announceToken == token then
			self.announce.Visible = false
		end
	end)
end

function Overlay:toast(text: string, style: string?)
	self._toastOrder += 1
	local color = Theme.styleColor(style)
	local card = C.panel({
		LayoutOrder = self._toastOrder,
		Size = UDim2.fromOffset(340, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = self.toasts,
	}, { C.padding(14, 10), C.stroke(color, 1.5, 0.3) })
	C.new("Frame", {
		Size = UDim2.new(0, 4, 1, 0),
		Position = UDim2.fromOffset(-8, 0),
		BackgroundColor3 = color,
		Parent = card,
	}, { C.round() })
	local textLabel = C.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Theme.Bold,
		Text = text,
		TextSize = 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local scale = C.new("UIScale", { Scale = 0.6, Parent = card })
	C.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	-- Keep at most five on screen.
	local cards = {}
	for _, child in self.toasts:GetChildren() do
		if child:IsA("Frame") then
			table.insert(cards, child)
		end
	end
	table.sort(cards, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #cards - 5 do
		cards[i]:Destroy()
	end
	task.delay(4, function()
		if card.Parent then
			C.tween(card, 0.4, { BackgroundTransparency = 1 })
			C.tween(textLabel, 0.4, { TextTransparency = 1 }).Completed:Wait()
			card:Destroy()
		end
	end)
end

return Overlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[-- Settings window: name tags, camera shake, and the admin password box.
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Settings = {}
Settings.__index = Settings

export type Handlers = {
	setNameTags: (boolean) -> (),
	setCameraShake: (boolean) -> (),
	submitCode: (string) -> (),
	openAdmin: () -> (),
}

local function row(parent: Instance, order: number, title: string, subtitle: string): Frame
	local frame = C.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 64),
		BackgroundColor3 = Theme.Card,
		Parent = parent,
	}, { C.corner(), C.stroke(nil, 1, 0.9), C.padding(16, 10) })
	C.new("TextLabel", {
		Size = UDim2.new(1, -90, 0, 22),
		Font = Theme.Title,
		Text = title,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	C.new("TextLabel", {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, -90, 0, 18),
		Font = Theme.Body,
		Text = subtitle,
		TextSize = 14,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	return frame
end

function Settings.new(handlers: Handlers)
	local self = setmetatable({}, Settings)
	local modal = C.modal("Settings", "SETTINGS", Theme.Info, Vector2.new(480, 450), 6)
	self.modal = modal
	local list = C.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = modal.body,
	}, { C.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }) })

	local tags = row(list, 1, "Name tags", "Show names above other players")
	local _, setTags = C.toggle({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Parent = tags }, true, handlers.setNameTags)
	self.setNameTags = setTags

	local shake = row(list, 2, "Camera shake", "Shake on falls, landings and gusts")
	local _, setShake = C.toggle({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Parent = shake }, true, handlers.setCameraShake)
	self.setCameraShake = setShake

	-- Admin: code box until unlocked, then a button to the panel.
	local admin = C.new("Frame", {
		LayoutOrder = 3,
		Size = UDim2.new(1, 0, 0, 150),
		BackgroundColor3 = Theme.Card,
		Parent = list,
	}, { C.corner(), C.stroke(Theme.Bad, 1, 0.6), C.padding(16, 12) })
	C.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 22),
		Font = Theme.Title,
		Text = "Admin",
		TextSize = 18,
		TextColor3 = Theme.Bad,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = admin,
	})
	-- Password box: what you type is hidden and shown as dots.
	self.codeBox = C.textbox({
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, -130, 0, 44),
		PlaceholderText = "",
		TextTransparency = 1,
		Parent = admin,
	})
	local dots = C.new("TextLabel", {
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		Font = Theme.Bold,
		Text = "Admin password",
		TextSize = 16,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = self.codeBox,
	})
	self.codeBox:GetPropertyChangedSignal("Text"):Connect(function()
		local length = #self.codeBox.Text
		dots.Text = if length == 0 then "Admin password" else string.rep("•", math.min(length, 24))
		dots.TextColor3 = if length == 0 then Theme.Muted else Theme.Text
	end)
	self.unlock = C.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 32),
		Size = UDim2.fromOffset(118, 44),
		BackgroundColor3 = Theme.Bad,
		Text = "UNLOCK",
		Parent = admin,
	}, function()
		local code = self.codeBox.Text
		if #code > 0 then
			handlers.submitCode(code)
		end
	end)
	self.codeBox.FocusLost:Connect(function(enterPressed)
		if enterPressed and #self.codeBox.Text > 0 then
			handlers.submitCode(self.codeBox.Text)
		end
	end)
	self.openAdmin = C.button({
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Theme.Bad,
		Text = "OPEN ADMIN PANEL",
		Visible = false,
		Parent = admin,
	}, function()
		modal.close()
		handlers.openAdmin()
	end)
	self.adminStatus = C.new("TextLabel", {
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 0, 36),
		Font = Theme.Body,
		Text = "Enter the admin password to open the admin panel.",
		TextSize = 14,
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = admin,
	})
	return self
end

function Settings:setAdmin(isAdmin: boolean)
	self.codeBox.Visible = not isAdmin
	self.unlock.Visible = not isAdmin
	self.openAdmin.Visible = isAdmin
	if isAdmin then
		self.codeBox.Text = ""
		self.adminStatus.Text = "Password accepted. You're an admin for this session."
		self.adminStatus.TextColor3 = Theme.Good
	end
end

function Settings:showCodeResult(ok: boolean, text: string)
	self.adminStatus.Text = text
	self.adminStatus.TextColor3 = if ok then Theme.Good else Theme.Bad
	if not ok then
		self.codeBox.Text = ""
	end
end

function Settings:toggle()
	if self.modal.isOpen() then
		self.modal.close()
	else
		self.modal.open()
	end
end

return Settings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Shop window: boost cards with level pips and a chalk card.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Shop = {}
Shop.__index = Shop

export type Handlers = {
	buyBoost: (id: string) -> (),
	buyChalk: () -> (),
	buyEmote: (id: string) -> (),
	buyPass: (id: string) -> (),
	equipEmote: (id: string) -> (),
}

local CARD_HEIGHT = 92

function Shop.new(handlers: Handlers)
	local self = setmetatable({}, Shop)
	self.cards = {}
	local player = Players.LocalPlayer

	local gui = C.new("ScreenGui", {
		Name = "Shop",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local root = C.autoScale(gui)
	self.gui = gui

	-- Dim the world behind the window; clicking it closes the shop.
	local dim = C.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Parent = root,
	})
	dim.Activated:Connect(function()
		self:close()
	end)

	local window = C.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, 600),
		BackgroundTransparency = 0.04,
		Parent = root,
	}, { C.stroke(Theme.Accent, 2, 0.4) })
	self.windowScale = C.new("UIScale", { Parent = window })

	C.new("TextLabel", {
		Position = UDim2.fromOffset(24, 18),
		Size = UDim2.new(1, -100, 0, 36),
		Font = Theme.Title,
		Text = "GEAR & BOOSTS",
		TextSize = 30,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = window,
	})
	self.balance = C.new("TextLabel", {
		Position = UDim2.fromOffset(24, 54),
		Size = UDim2.new(1, -100, 0, 22),
		Font = Theme.Bold,
		Text = "",
		TextSize = 17,
		TextColor3 = Theme.Good,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = window,
	})
	C.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 18),
		Size = UDim2.fromOffset(44, 44),
		BackgroundColor3 = Color3.fromRGB(70, 40, 46),
		Text = "X",
		TextSize = 20,
		Parent = window,
	}, function()
		self:close()
	end)

	local list = C.new("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 90),
		Size = UDim2.new(1, -32, 1, -106),
		BackgroundTransparency = 1,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = window,
	}, {
		C.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		C.new("UIPadding", { PaddingRight = UDim.new(0, 10) }),
	})

	local function card(order: number, title: string, desc: string, maxLevel: number?, onBuy: () -> ())
		local frame = C.new("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, CARD_HEIGHT),
			BackgroundColor3 = Theme.Card,
			Parent = list,
		}, { C.corner(), C.stroke(nil, 1, 0.9), C.padding(14, 12) })
		C.new("TextLabel", {
			Size = UDim2.new(1, -150, 0, 24),
			Font = Theme.Title,
			Text = title,
			TextSize = 20,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		C.new("TextLabel", {
			Position = UDim2.fromOffset(0, 26),
			Size = UDim2.new(1, -150, 0, 20),
			Font = Theme.Body,
			Text = desc,
			TextSize = 14,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
			Parent = frame,
		})
		local pips = {}
		local levelLabel
		if maxLevel then
			local row = C.new("Frame", {
				Position = UDim2.fromOffset(0, 52),
				Size = UDim2.new(1, -150, 0, 14),
				BackgroundTransparency = 1,
				Parent = frame,
			}, { C.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4) }) })
			for i = 1, maxLevel do
				pips[i] = C.new("Frame", {
					Size = UDim2.fromOffset(math.floor(220 / maxLevel) - 4, 10),
					BackgroundColor3 = Theme.PanelLight,
					Parent = row,
				}, { C.round() })
			end
		else
			levelLabel = C.new("TextLabel", {
				Position = UDim2.fromOffset(0, 50),
				Size = UDim2.new(1, -150, 0, 18),
				Font = Theme.Bold,
				Text = "",
				TextSize = 14,
				TextColor3 = Theme.Chalk,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = frame,
			})
		end
		local buy = C.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(130, 48),
			BackgroundColor3 = Theme.Good,
			TextColor3 = Color3.fromRGB(15, 30, 20),
			Text = "",
			TextSize = 18,
			Parent = frame,
		}, onBuy)
		return { frame = frame, pips = pips, buy = buy, levelLabel = levelLabel }
	end

	local function header(order: number, text: string)
		C.new("TextLabel", {
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, 26),
			Font = Theme.Title,
			Text = text,
			TextSize = 18,
			TextColor3 = Theme.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = list,
		})
	end

	header(0, "BOOSTS")
	for i, def in Config.Boosts do
		self.cards[def.Id] = card(i, def.Name, def.Description, def.MaxLevel, function()
			handlers.buyBoost(def.Id)
		end)
	end
	header(100, "GEAR")
	self.chalkCard = card(101, "Climbing Chalk", "Use with C: halves stamina drain for 12s.", nil, handlers.buyChalk)

	-- Gamepasses (Robux).
	header(150, "GAMEPASSES")
	self.passCards = {}
	for i, pass in Config.GamePasses do
		self.passCards[pass.Id] = card(150 + i, pass.Name, pass.Description, nil, function()
			handlers.buyPass(pass.Id)
		end)
	end

	-- Emotes: buy, then pick which one plays automatically at every summit.
	header(200, "EMOTES  (G to use · the starred one plays at every summit)")
	self.emoteCards = {}
	self._owned = {}
	self._summit = ""
	for i, def in Config.Emotes do
		self.emoteCards[def.Id] = card(200 + i, def.Name, "Emote. Play it any time with G.", nil, function()
			if not self._owned[def.Id] then
				handlers.buyEmote(def.Id)
			elseif self._summit ~= def.Id then
				handlers.equipEmote(def.Id)
			end
		end)
	end
	return self
end

function Shop:refresh(cash: number, boosts: { [string]: number }, chalk: number, ownedEmotes: { string }, summitEmote: string, ownedPasses: { [string]: boolean })
	self.balance.Text = "Balance: $" .. Theme.formatNumber(cash)
	for _, def in Config.Boosts do
		local cardRef = self.cards[def.Id]
		local level = boosts[def.Id] or 0
		for i, pip in cardRef.pips do
			pip.BackgroundColor3 = if i <= level then Theme.Accent else Theme.PanelLight
		end
		local cost = Rules.boostCost(Config.Boosts, def.Id, level)
		if cost == nil then
			cardRef.buy.Text = "MAXED"
			cardRef.buy.BackgroundColor3 = Theme.PanelLight
			cardRef.buy.TextColor3 = Theme.Muted
		else
			cardRef.buy.Text = "$" .. Theme.formatNumber(cost)
			local affordable = cash >= cost
			cardRef.buy.BackgroundColor3 = if affordable then Theme.Good else Theme.PanelLight
			cardRef.buy.TextColor3 = if affordable then Color3.fromRGB(15, 30, 20) else Theme.Muted
		end
	end
	local full = chalk >= Config.Chalk.MaxHeld
	self.chalkCard.levelLabel.Text = string.format("In bag: %d / %d", chalk, Config.Chalk.MaxHeld)
	self.chalkCard.buy.Text = if full then "BAG FULL" else "$" .. Config.Chalk.Price
	local ok = not full and cash >= Config.Chalk.Price
	self.chalkCard.buy.BackgroundColor3 = if ok then Theme.Good else Theme.PanelLight
	self.chalkCard.buy.TextColor3 = if ok then Color3.fromRGB(15, 30, 20) else Theme.Muted

	for _, pass in Config.GamePasses do
		local cardRef = self.passCards[pass.Id]
		local owned = ownedPasses[pass.Id] == true
		cardRef.levelLabel.Text = if owned then "Owned" else "Gamepass"
		cardRef.levelLabel.TextColor3 = if owned then Theme.Good else Theme.Muted
		cardRef.buy.Text = if owned then "OWNED" else "R$ " .. pass.Robux
		cardRef.buy.BackgroundColor3 = if owned then Theme.PanelLight else Color3.fromRGB(0, 176, 111)
		cardRef.buy.TextColor3 = if owned then Theme.Good else Color3.new(1, 1, 1)
	end

	self._owned, self._summit = {}, summitEmote
	for _, id in ownedEmotes do
		self._owned[id] = true
	end
	for _, def in Config.Emotes do
		local cardRef = self.emoteCards[def.Id]
		local owned = self._owned[def.Id] == true
		local summit = owned and summitEmote == def.Id
		cardRef.levelLabel.Text = if summit then "★ Summit emote" elseif owned then "Owned" else (if def.Price == 0 then "Free" else "Not owned")
		cardRef.levelLabel.TextColor3 = if summit then Theme.Gold elseif owned then Theme.Good else Theme.Muted
		if summit then
			cardRef.buy.Text = "EQUIPPED"
			cardRef.buy.BackgroundColor3 = Theme.PanelLight
			cardRef.buy.TextColor3 = Theme.Gold
		elseif owned then
			cardRef.buy.Text = "SET SUMMIT"
			cardRef.buy.BackgroundColor3 = Theme.Info
			cardRef.buy.TextColor3 = Color3.fromRGB(10, 20, 40)
		else
			local affordable = cash >= def.Price
			cardRef.buy.Text = "$" .. Theme.formatNumber(def.Price)
			cardRef.buy.BackgroundColor3 = if affordable then Theme.Good else Theme.PanelLight
			cardRef.buy.TextColor3 = if affordable then Color3.fromRGB(15, 30, 20) else Theme.Muted
		end
	end
end

function Shop:isOpen(): boolean
	return self.gui.Enabled
end

function Shop:open()
	self.gui.Enabled = true
	self.windowScale.Scale = 0.85
	C.tween(self.windowScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
end

function Shop:close()
	self.gui.Enabled = false
end

function Shop:toggle()
	if self:isOpen() then
		self:close()
	else
		self:open()
	end
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- One place for the HUD's look: dark glass panels, hazard-yellow accent.
local Theme = {
	Panel = Color3.fromRGB(18, 20, 28),
	PanelLight = Color3.fromRGB(30, 34, 46),
	Card = Color3.fromRGB(38, 42, 56),
	Stroke = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(244, 245, 250),
	Muted = Color3.fromRGB(150, 158, 180),
	Accent = Color3.fromRGB(255, 196, 46),
	AccentDark = Color3.fromRGB(200, 140, 20),
	Good = Color3.fromRGB(88, 224, 132),
	Bad = Color3.fromRGB(255, 86, 86),
	Info = Color3.fromRGB(100, 172, 255),
	Gold = Color3.fromRGB(255, 214, 90),
	StaminaHigh = Color3.fromRGB(88, 224, 132),
	StaminaMid = Color3.fromRGB(255, 200, 60),
	StaminaLow = Color3.fromRGB(255, 80, 80),
	Chalk = Color3.fromRGB(235, 240, 255),

	PanelTransparency = 0.18,
	Radius = 12,

	Title = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Body = Enum.Font.GothamMedium,
}

function Theme.styleColor(style: string?): Color3
	if style == "good" then
		return Theme.Good
	elseif style == "bad" then
		return Theme.Bad
	elseif style == "gold" then
		return Theme.Gold
	end
	return Theme.Info
end

function Theme.formatNumber(n: number): string
	local s = tostring(math.floor(n))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""):gsub("^%-,", "-"))
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">WallClimb</string>
            <string name="Source"><![CDATA[--!strict
-- Wall logic for rock climbing: finding the wall, planning moves, leaps and
-- climbing over the top. It only uses Vector3 maths and a `World` (raycast +
-- tag checks), so tests run this exact code against real tower geometry.

local WallClimb = {}

export type Hit = { Instance: any, Position: Vector3, Normal: Vector3 }
export type World = {
	cast: (origin: Vector3, direction: Vector3) -> Hit?,
	climbable: (instance: any) -> boolean,
	solid: (instance: any) -> boolean,
	noStand: (instance: any) -> boolean, -- thin trim (roof parapets) you climb over
}
export type Move = {
	kind: string, -- "up" | "down" | "side" | "leap"
	t: number,
	duration: number,
	from: Vector3,
	to: Vector3,
	mantleAfter: boolean,
}

WallClimb.ROOT_HEIGHT = 3 -- HumanoidRootPart centre above the floor when standing
WallClimb.HAND_HEIGHT = 2.5 -- hands above the root while climbing

local function horizontal(v: Vector3): Vector3
	local h = Vector3.new(v.X, 0, v.Z)
	return if h.Magnitude > 1e-3 then h.Unit else Vector3.new(0, 0, 1)
end
WallClimb.horizontal = horizontal

-- Climbable wall straight "into" the wall from `origin`, or nil.
function WallClimb.probe(world: World, cfg: any, origin: Vector3, normal: Vector3): Hit?
	local hit = world.cast(origin + normal, -normal * (cfg.WallOffset + 3))
	if hit and world.climbable(hit.Instance) and math.abs(hit.Normal.Y) < 0.7 then
		return hit
	end
	return nil
end

-- Direction "up the wall" (follows the taper of lattice faces).
function WallClimb.wallUp(n: Vector3): Vector3
	local up = Vector3.new(0, 1, 0)
	return (up - n * n:Dot(up)).Unit
end

-- Grab a wall in front of `position` along `dir`. Returns hold point + normal.
function WallClimb.grab(world: World, cfg: any, position: Vector3, dir: Vector3, range: number): (Vector3?, Vector3?)
	for _, height in { 0, 1.5, -1.5 } do
		local hit = world.cast(position + Vector3.new(0, height, 0), dir * range)
		if hit and world.climbable(hit.Instance) and math.abs(hit.Normal.Y) < 0.7 then
			local hold = hit.Position + hit.Normal * cfg.WallOffset
			return Vector3.new(hold.X, position.Y, hold.Z), horizontal(hit.Normal)
		end
	end
	return nil, nil
end

-- Somewhere to stand at or just above the hold (a ledge or the top of the
-- wall), or nil. Uses rays, i.e. exact geometry.
function WallClimb.findMantle(world: World, cfg: any, anchor: Vector3, wallNormal: Vector3): Vector3?
	local inward = -wallNormal
	local R = WallClimb.ROOT_HEIGHT
	for _, offset in { 0, 1.5, 3, 4.5, 6 } do
		local p = anchor + inward * offset
		local top = Vector3.new(p.X, anchor.Y + cfg.MantleReach, p.Z)
		local hit = world.cast(top, Vector3.new(0, -(cfg.MantleReach + 4), 0))
		if
			hit
			and hit.Normal.Y > 0.7
			and world.solid(hit.Instance)
			and not world.noStand(hit.Instance) -- not on trim like the roof parapet
			and hit.Position.Y > anchor.Y - R + 0.5
		then
			local stand = hit.Position + Vector3.new(0, R, 0)
			local headroom = world.cast(hit.Position + Vector3.new(0, 0.1, 0), Vector3.new(0, 5, 0))
			local from = Vector3.new(anchor.X, stand.Y, anchor.Z)
			local path = if (stand - from).Magnitude > 0.05 then world.cast(from, stand - from) else nil
			local blocked = (headroom and world.solid(headroom.Instance)) or (path and world.solid(path.Instance))
			if not blocked then
				return stand
			end
		end
	end
	return nil
end

-- Plan the next move. Returns (move, nil), or (nil, "mantle") to climb over
-- the top, (nil, "stepoff") at the bottom, or (nil, nil) when blocked.
function WallClimb.plan(
	world: World,
	cfg: any,
	anchor: Vector3,
	wallNormal: Vector3,
	vert: number,
	lat: number,
	speed: number
): (Move?, string?)
	local probe = WallClimb.probe(world, cfg, anchor, wallNormal)
	local n = if probe then probe.Normal else wallNormal
	local wallUp = WallClimb.wallUp(n)
	local right = (-wallNormal):Cross(Vector3.new(0, 1, 0))

	local function moveTo(kind: string, hit: Hit, duration: number): Move
		return {
			kind = kind,
			t = 0,
			duration = duration,
			from = anchor,
			to = hit.Position + hit.Normal * cfg.WallOffset,
			mantleAfter = false,
		}
	end

	if vert > 0 then
		local ceiling = world.cast(anchor + Vector3.new(0, 2.4, 0), Vector3.new(0, cfg.ReachLength + 0.6, 0))
		if ceiling and world.solid(ceiling.Instance) then
			return nil, "mantle" -- something overhead: climb onto it if there's room
		end
		local target = anchor + wallUp * cfg.ReachLength
		if not WallClimb.probe(world, cfg, target + Vector3.new(0, 1.5, 0), wallNormal) then
			return nil, "mantle" -- the wall ends: climb over the top
		end
		local hit = WallClimb.probe(world, cfg, target, wallNormal)
		if not hit then
			return nil, nil
		end
		return moveTo("up", hit :: Hit, cfg.ReachLength / speed), nil
	elseif vert < 0 then
		local floor = world.cast(anchor, Vector3.new(0, -(WallClimb.ROOT_HEIGHT + cfg.ReachLength), 0))
		if floor and floor.Normal.Y > 0.7 then
			return nil, "stepoff"
		end
		local hit = WallClimb.probe(world, cfg, anchor - wallUp * cfg.ReachLength, wallNormal)
		if not hit then
			return nil, nil
		end
		return moveTo("down", hit :: Hit, cfg.ReachLength / speed), nil
	elseif lat ~= 0 then
		local hit = WallClimb.probe(world, cfg, anchor + right * (cfg.SideStep * math.sign(lat)), wallNormal)
		if not hit then
			return nil, nil
		end
		return moveTo("side", hit :: Hit, cfg.SideStep / cfg.SideSpeed), nil
	end
	return nil, nil
end

-- A dyno: how far up the wall a leap can go (stopping under anything overhead
-- or at the top, in which case you climb over after landing).
function WallClimb.planLeap(world: World, cfg: any, anchor: Vector3, wallNormal: Vector3): Move?
	local probe = WallClimb.probe(world, cfg, anchor, wallNormal)
	local n = if probe then probe.Normal else wallNormal
	local wallUp = WallClimb.wallUp(n)
	local reached, mantleAfter = 0, false
	for d = 1, cfg.LungeDistance do
		local p = anchor + wallUp * d
		local ceiling = world.cast(anchor + Vector3.new(0, 2.4, 0), Vector3.new(0, d + 0.6, 0))
		if ceiling and world.solid(ceiling.Instance) then
			break
		end
		if not WallClimb.probe(world, cfg, p + Vector3.new(0, 1.5, 0), wallNormal) then
			mantleAfter = true
			reached = d
			break
		end
		if not WallClimb.probe(world, cfg, p, wallNormal) then
			break
		end
		reached = d
	end
	if reached < 1 then
		return nil
	end
	local target = anchor + wallUp * reached
	local hit = WallClimb.probe(world, cfg, target, wallNormal)
	if hit then
		target = hit.Position + hit.Normal * cfg.WallOffset
	end
	return {
		kind = "leap",
		t = 0,
		duration = math.max(0.22, reached / cfg.LungeSpeed) + 0.15, -- + a beat to catch the hold
		from = anchor,
		to = target,
		mantleAfter = mantleAfter,
	}
end

return WallClimb
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Weather</string>
            <string name="Source"><![CDATA[-- Client weather: rain that follows the camera, lightning flashes, and the
-- slippery-wall stamina multiplier. The server picks the weather and tweens the
-- sky; it publishes the current state as Workspace's "Weather" attribute.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)

local Weather = {}

local RAIN_RATE = 900

function Weather.current(): string
	return Workspace:GetAttribute("Weather") or "Clear"
end

-- Stamina drain multiplier from the weather (rain makes every wall slippery).
function Weather.drainMultiplier(): number
	return if Weather.current() == "Rain" then Config.Weather.RainDrainMultiplier else 1
end

function Weather.start(onChanged: (name: string) -> ())
	-- Rain: a wide invisible emitter that rides above the camera.
	local cloud = Instance.new("Part")
	cloud.Name = "RainCloud"
	cloud.Anchored = true
	cloud.CanCollide = false
	cloud.CanQuery = false
	cloud.CanTouch = false
	cloud.Transparency = 1
	cloud.Size = Vector3.new(160, 1, 160)
	local rain = Instance.new("ParticleEmitter")
	rain.Name = "Rain"
	rain.Shape = Enum.ParticleEmitterShape.Box
	rain.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Orientation = Enum.ParticleOrientation.VelocityParallel
	rain.Speed = NumberRange.new(110, 140)
	rain.Lifetime = NumberRange.new(0.7, 1)
	rain.Size = NumberSequence.new(0.18)
	rain.Squash = NumberSequence.new(2.5) -- stretch drops into streaks
	rain.Color = ColorSequence.new(Color3.fromRGB(200, 212, 235))
	rain.Transparency = NumberSequence.new(0.35)
	rain.LightEmission = 0.2
	rain.Rate = 0
	rain.Parent = cloud
	cloud.Parent = Workspace

	local flash = Instance.new("ColorCorrectionEffect")
	flash.Name = "Lightning"
	flash.Parent = Lighting

	RunService.RenderStepped:Connect(function()
		local camera = Workspace.CurrentCamera
		if camera then
			cloud.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, 45, 0))
		end
	end)

	local function apply()
		local name = Weather.current()
		rain.Rate = if name == "Rain" then RAIN_RATE else 0
		onChanged(name)
	end
	Workspace:GetAttributeChangedSignal("Weather"):Connect(apply)
	apply()

	-- Lightning: a double flash every so often while it rains.
	task.spawn(function()
		local rng = Random.new()
		while true do
			task.wait(rng:NextNumber(8, 20))
			if Weather.current() == "Rain" then
				for _ = 1, 2 do
					flash.Brightness = 0.55
					TweenService:Create(flash, TweenInfo.new(0.25), { Brightness = 0 }):Play()
					task.wait(0.18)
				end
			end
		end
	end)
end

return Weather
]]></string>
          </Properties>
        </Item>
