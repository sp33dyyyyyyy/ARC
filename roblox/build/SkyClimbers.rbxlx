      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- RemoteEvents shared by server and client. The server creates them; clients wait.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local NAMES = {
	"BuyBoost", -- client -> server: boostId
	"BuyChalk", -- client -> server
	"BuyEmote", -- client -> server: emoteId
	"EquipEmote", -- client -> server: emoteId (played automatically at summits)
	"UseChalk", -- client -> server
	"Ragdoll", -- client -> server: isRagdolled, fallStartY?
	"RestCheckpoint", -- client -> server: wallNormal (hanging on a rest bar)
	"Rope", -- client -> server: "clip", point | "unclip"
	"ResetToPlaza", -- client -> server
	"SaveSetting", -- client -> server: key, value
	"AdminLogin", -- client -> server: code
	"AdminAction", -- client -> server: action, args (re-checked on the server)
	"Notify", -- server -> client: kind, payload
	"Gust", -- server -> all clients: phase, direction, duration
}

function Remotes.create()
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in NAMES do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
	return folder
end

function Remotes.get(name: string): RemoteEvent
	return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure game rules shared by server and client. No Roblox APIs and no requires:
-- every function takes the config tables it needs, so tests can run them in
-- plain Luau.

local Rules = {}

export type Boosts = { [string]: number }

local function boostDef(boostDefs: { any }, id: string): any?
	for _, def in boostDefs do
		if def.Id == id then
			return def
		end
	end
	return nil
end
Rules.boostDef = boostDef

local function level(boosts: Boosts, id: string): number
	return boosts[id] or 0
end

-- Stamina ---------------------------------------------------------------

-- Gamepass ownership rides along in the boosts table as "Pass_<Id>" = 1.
local function passPerks(passDefs: { any }?, boosts: Boosts, field: string): { number }
	local values = {}
	for _, pass in (passDefs or {}) :: { any } do
		if pass[field] ~= nil and level(boosts, "Pass_" .. pass.Id) > 0 then
			table.insert(values, pass[field])
		end
	end
	return values
end

-- Copy of `boosts` with owned gamepasses added as "Pass_<Id>" = 1.
function Rules.withPasses(boosts: Boosts, owned: { [string]: boolean }): Boosts
	local merged = table.clone(boosts)
	for id, has in owned do
		if has then
			merged["Pass_" .. id] = 1
		end
	end
	return merged
end

function Rules.maxStamina(staminaCfg: any, boostDefs: { any }, boosts: Boosts, passDefs: { any }?): number
	local def = boostDef(boostDefs, "Endurance")
	local bonus = 0
	for _, v in passPerks(passDefs, boosts, "StaminaBonus") do
		bonus += v
	end
	return staminaCfg.Base + (def and def.PerLevel or 0) * level(boosts, "Endurance") + bonus
end

-- Summit payout after gamepass multipliers (VIP doubles it).
function Rules.payout(base: number, passDefs: { any }?, boosts: Boosts): number
	local amount = base
	for _, v in passPerks(passDefs, boosts, "CashMultiplier") do
		amount *= v
	end
	return math.floor(amount)
end

export type DrainContext = {
	climbing: boolean,
	moving: boolean,
	towerMultiplier: number,
	slippery: boolean,
	chalk: boolean,
	gust: boolean,
	weatherMultiplier: number?, -- rain soaks the walls
	resting: boolean?, -- hands on a rest bar
	roped: boolean?, -- clipped into the climbing rope
}

-- Stamina change per second for the given situation. Negative = draining.
function Rules.staminaRate(
	staminaCfg: any,
	chalkCfg: any,
	windCfg: any,
	boostDefs: { any },
	boosts: Boosts,
	ctx: DrainContext,
	grounded: boolean
): number
	local rec = boostDef(boostDefs, "Recovery")
	local recovery = staminaCfg.RecoverPerSecond * (1 + (rec and rec.PerLevel or 0) * level(boosts, "Recovery"))
	if ctx.climbing and ctx.resting and not ctx.moving then
		return recovery * staminaCfg.RestBarRecoveryFraction
	end
	if ctx.climbing and ctx.roped and not ctx.moving then
		return recovery * (staminaCfg.RopeRestFraction or 0)
	end
	if ctx.climbing then
		local rate = staminaCfg.DrainPerSecond * ctx.towerMultiplier
		if not ctx.moving then
			rate *= staminaCfg.HangDrainFraction
		end
		if ctx.slippery then
			local grip = boostDef(boostDefs, "Grip")
			rate *= math.max(0.2, 1 - (grip and grip.PerLevel or 0) * level(boosts, "Grip"))
		end
		if ctx.chalk then
			rate *= chalkCfg.DrainMultiplier
		end
		if ctx.gust then
			rate *= windCfg.DrainMultiplier
		end
		rate *= ctx.weatherMultiplier or 1
		return -rate
	elseif grounded then
		return recovery
	end
	return 0
end

function Rules.stepStamina(current: number, rate: number, dt: number, max: number): number
	return math.clamp(current + rate * dt, 0, max)
end

-- Wall crawl speed (studs/second) with the Quick Hands boost.
function Rules.climbSpeed(climbCfg: any, boostDefs: { any }, boosts: Boosts): number
	local def = boostDef(boostDefs, "ClimbSpeed")
	return climbCfg.ClimbSpeed * (1 + (def and def.PerLevel or 0) * level(boosts, "ClimbSpeed"))
end

-- Stamina a leap costs, given the (negative) stamina rate of climbing right now:
-- the same as crawling LungeDistance at base speed, times LungeCostFactor.
function Rules.lungeCost(climbCfg: any, climbingRate: number): number
	return math.abs(climbingRate) * (climbCfg.LungeDistance / climbCfg.ClimbSpeed) * climbCfg.LungeCostFactor
end

-- Shop ------------------------------------------------------------------

-- Cost to buy the next level, or nil when already maxed / unknown.
function Rules.boostCost(boostDefs: { any }, id: string, currentLevel: number): number?
	local def = boostDef(boostDefs, id)
	if not def or currentLevel >= def.MaxLevel or currentLevel < 0 then
		return nil
	end
	return math.floor(def.BaseCost * def.Growth ^ currentLevel + 0.5)
end

export type PurchaseResult = { ok: boolean, reason: string?, cost: number? }

function Rules.canBuyBoost(boostDefs: { any }, id: string, currentLevel: number, cash: number): PurchaseResult
	local maybeCost = Rules.boostCost(boostDefs, id, currentLevel)
	if not maybeCost then
		if boostDef(boostDefs, id) == nil then
			return { ok = false, reason = "Unknown boost" }
		end
		return { ok = false, reason = "Already maxed" }
	end
	local cost = maybeCost :: number
	if cash < cost then
		return { ok = false, reason = "Not enough cash", cost = cost }
	end
	return { ok = true, cost = cost }
end

function Rules.canBuyChalk(chalkCfg: any, held: number, cash: number): PurchaseResult
	if held >= chalkCfg.MaxHeld then
		return { ok = false, reason = "Chalk bag is full" }
	end
	if cash < chalkCfg.Price then
		return { ok = false, reason = "Not enough cash", cost = chalkCfg.Price }
	end
	return { ok = true, cost = chalkCfg.Price }
end

-- Emotes ----------------------------------------------------------------

function Rules.emoteDef(emoteDefs: { any }, id: string): any?
	for _, def in emoteDefs do
		if def.Id == id then
			return def
		end
	end
	return nil
end

function Rules.canBuyEmote(emoteDefs: { any }, owned: { [string]: boolean }, id: string, cash: number): PurchaseResult
	local def = Rules.emoteDef(emoteDefs, id)
	if not def then
		return { ok = false, reason = "Unknown emote" }
	end
	if owned[id] then
		return { ok = false, reason = "You already own " .. def.Name }
	end
	if cash < def.Price then
		return { ok = false, reason = "Not enough cash", cost = def.Price }
	end
	return { ok = true, cost = def.Price }
end

-- Free emotes are always owned.
function Rules.ownsEmote(emoteDefs: { any }, owned: { [string]: boolean }, id: string): boolean
	local def = Rules.emoteDef(emoteDefs, id)
	return def ~= nil and (def.Price == 0 or owned[id] == true)
end

-- Falls -----------------------------------------------------------------

function Rules.fallDamage(fallCfg: any, boostDefs: { any }, boosts: Boosts, drop: number, passDefs: { any }?): number
	if drop ~= drop or drop <= fallCfg.SafeDrop then -- drop ~= drop catches NaN
		return 0
	end
	local def = boostDef(boostDefs, "SoftLanding")
	local reduction = math.min(0.75, (def and def.PerLevel or 0) * level(boosts, "SoftLanding"))
	local damage = (drop - fallCfg.SafeDrop) * fallCfg.DamagePerStud * (1 - reduction)
	for _, v in passPerks(passDefs, boosts, "FallDamageMultiplier") do
		damage *= v
	end
	return damage
end

-- Admin ---------------------------------------------------------------------

-- Roblox usernames: 3-20 letters, digits or underscores.
function Rules.isValidUsername(name: any): boolean
	return type(name) == "string" and #name >= 3 and #name <= 20 and string.match(name, "^[%w_]+$") ~= nil
end

-- Whether `code` unlocks admin. An empty configured code never matches.
function Rules.adminCodeMatches(configured: any, code: any): boolean
	if type(configured) ~= "string" or type(code) ~= "string" then
		return false
	end
	if #configured < 6 or #code ~= #configured then
		return false
	end
	-- Compare every character so timing doesn't leak how much matched.
	local diff = 0
	for i = 1, #configured do
		diff += if string.byte(configured, i) == string.byte(code, i) then 0 else 1
	end
	return diff == 0
end

-- Rate limit for code attempts: returns allowed, newAttemptTimes.
function Rules.allowAttempt(adminCfg: any, attempts: { number }, now: number): (boolean, { number })
	local recent = {}
	for _, t in attempts do
		if now - t < adminCfg.AttemptWindow then
			table.insert(recent, t)
		end
	end
	if #recent >= adminCfg.MaxCodeAttempts then
		return false, recent
	end
	table.insert(recent, now)
	return true, recent
end

-- Climb validation --------------------------------------------------------

export type ActiveClimb = { tower: string, startTime: number, paid: boolean }

-- Whether reaching the peak of `tower` at `now` earns a payout.
function Rules.validatePeak(climbCfg: any, active: ActiveClimb?, tower: string, height: number, now: number): (boolean, string?)
	if not active then
		return false, "Start the climb from the bottom of the tower"
	end
	local climb = active :: ActiveClimb
	if climb.tower ~= tower then
		return false, "Start the climb from the bottom of this tower"
	end
	if climb.paid then
		return false, "Already paid - head back down to climb again"
	end
	if now - climb.startTime < height / climbCfg.MaxPlausibleSpeed then
		return false, "Too fast to be real"
	end
	return true, nil
end

-- Daily reward ------------------------------------------------------------

-- Returns newStreak, reward, alreadyClaimed.
function Rules.dailyReward(dailyCfg: any, lastDay: number, streak: number, today: number): (number, number, boolean)
	if lastDay == today then
		return streak, 0, true
	end
	local newStreak = if lastDay == today - 1 then streak + 1 else 1
	local reward = dailyCfg.BaseReward * math.min(newStreak, dailyCfg.MaxStreakMultiplier)
	return newStreak, reward, false
end

-- Trails ------------------------------------------------------------------

function Rules.bestTrail(trails: { any }, climbs: number): any?
	local best = nil
	for _, t in trails do
		if climbs >= t.Climbs then
			best = t
		end
	end
	return best
end

-- Profiles ----------------------------------------------------------------

function Rules.defaultProfile(boostDefs: { any }, emoteDefs: { any }?): any
	local boosts = {}
	for _, def in boostDefs do
		boosts[def.Id] = 0
	end
	local emotes = {}
	for _, def in (emoteDefs or {}) :: { any } do
		if def.Price == 0 then
			emotes[def.Id] = true
		end
	end
	local first = emoteDefs and emoteDefs[1]
	return {
		GrantedPasses = {},
		Settings = { NameTags = true, CameraShake = true },
		Emotes = emotes,
		SummitEmote = if first then first.Id else "",
		Version = 1,
		Cash = 0,
		Climbs = 0,
		Chalk = 0,
		Boosts = boosts,
		LastDaily = 0,
		Streak = 0,
		BestHeight = 0,
	}
end

-- Fill in anything missing from saved data (new fields added in updates) and
-- clamp values back into range so corrupt saves can't break the game.
function Rules.reconcileProfile(boostDefs: { any }, chalkCfg: any, saved: any, emoteDefs: { any }?): any
	local profile = Rules.defaultProfile(boostDefs, emoteDefs)
	if type(saved) ~= "table" then
		return profile
	end
	for key, value in profile do
		if key ~= "Boosts" and key ~= "Emotes" and key ~= "GrantedPasses" and key ~= "Settings" and type(saved[key]) == type(value) then
			profile[key] = saved[key]
		end
	end
	if type(saved.Boosts) == "table" then
		for _, def in boostDefs do
			local v = saved.Boosts[def.Id]
			if type(v) == "number" then
				profile.Boosts[def.Id] = math.clamp(math.floor(v), 0, def.MaxLevel)
			end
		end
	end
	if type(saved.Emotes) == "table" then
		for _, def in (emoteDefs or {}) :: { any } do
			if saved.Emotes[def.Id] == true then
				profile.Emotes[def.Id] = true
			end
		end
	end
	if type(saved.GrantedPasses) == "table" then
		for id, has in saved.GrantedPasses do
			if type(id) == "string" and has == true and #id <= 32 then
				profile.GrantedPasses[id] = true
			end
		end
	end
	if type(saved.Settings) == "table" then
		for key, default in profile.Settings do
			if type(saved.Settings[key]) == type(default) then
				profile.Settings[key] = saved.Settings[key]
			end
		end
	end
	if emoteDefs and not Rules.ownsEmote(emoteDefs, profile.Emotes, profile.SummitEmote) then
		profile.SummitEmote = emoteDefs[1].Id
	end
	profile.Cash = math.max(0, math.floor(profile.Cash))
	profile.Climbs = math.max(0, math.floor(profile.Climbs))
	profile.Chalk = math.clamp(math.floor(profile.Chalk), 0, chalkCfg.MaxHeld)
	return profile
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">AdminConfig</string>
          <string name="Source"><![CDATA[-- Server-only admin settings. This ModuleScript lives in ServerScriptService,
-- which players can never see, so the password stays secret in the live game.
--
-- Everyone (including the game's owner) has to enter this password in
-- Settings to open the admin panel. Wrong guesses are rate limited.
--
-- Note: if this repository is public on GitHub, anyone can read the password
-- here. Change it in your published place (and keep the repo private) if so.
return {
	Password = "Evan123",
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">AdminService</string>
          <string name="Source"><![CDATA[-- Admins and the admin panel's powers: ban / unban by username, give or take
-- gamepasses, send players to the plaza, and game-wide announcements.
--
-- Security: the admin password only ever lives on the server (AdminConfig),
-- everyone (owner included) must enter it, guesses are rate limited, and every
-- admin action is re-checked here. Clients only get an "IsAdmin" attribute to
-- show the panel.
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local AdminConfig = require(script.Parent.AdminConfig)
local ClimbService = require(script.Parent.ClimbService)
local DataService = require(script.Parent.DataService)

local AdminService = {}

local admins: { [Player]: boolean } = {}
local attempts: { [Player]: { number } } = {}
local lastAction: { [Player]: number } = {}
local notify: RemoteEvent

local banStore: DataStore? = nil
pcall(function()
	banStore = DataStoreService:GetDataStore(Config.Admin.BanStoreName)
end)

-- The game's owner can't be banned from the panel.
local function isProtected(userId: number): boolean
	return game.CreatorType == Enum.CreatorType.User and userId == game.CreatorId
end

function AdminService.isAdmin(player: Player): boolean
	return admins[player] == true
end

local function grant(player: Player)
	admins[player] = true
	player:SetAttribute("IsAdmin", true)
end

local function reply(player: Player, ok: boolean, text: string)
	notify:FireClient(player, "AdminResult", { ok = ok, text = text })
end

local function passDef(id: any): any?
	for _, pass in Config.GamePasses do
		if pass.Id == id then
			return pass
		end
	end
	return nil
end

-- Filter admin-typed text the way Roblox requires before others see it.
local function filterForEveryone(text: string, fromUserId: number): string?
	local ok, result = pcall(function()
		return TextService:FilterStringAsync(text, fromUserId):GetNonChatStringForBroadcastAsync()
	end)
	return if ok then result else nil
end

local function findOnline(name: string): Player?
	for _, p in Players:GetPlayers() do
		if string.lower(p.Name) == string.lower(name) then
			return p
		end
	end
	return nil
end

local function userIdFor(name: string): number?
	local online = findOnline(name)
	if online then
		return online.UserId
	end
	local ok, id = pcall(Players.GetUserIdFromNameAsync, Players, name)
	return if ok then id else nil
end

-- Actions -------------------------------------------------------------------------

local actions: { [string]: (Player, any) -> () } = {}

function actions.ban(admin: Player, args: any)
	local name = args.username
	if not Rules.isValidUsername(name) then
		reply(admin, false, "That's not a valid username.")
		return
	end
	local userId = userIdFor(name)
	if not userId then
		reply(admin, false, "No Roblox user called " .. name .. ".")
		return
	end
	local online = Players:GetPlayerByUserId(userId)
	if userId == admin.UserId or isProtected(userId) or (online and admins[online]) then
		reply(admin, false, "You can't ban yourself, another admin or the game's owner.")
		return
	end
	local reason = "Banned by an admin."
	if type(args.reason) == "string" and #args.reason > 0 and #args.reason <= 100 then
		reason = filterForEveryone(args.reason, admin.UserId) or reason
	end
	-- Our own ban list (always works) plus Roblox's ban API (published games only).
	if banStore then
		pcall(function()
			(banStore :: DataStore):SetAsync(tostring(userId), { by = admin.UserId, reason = reason, time = os.time() })
		end)
	end
	pcall(function()
		Players:BanAsync({
			UserIds = { userId },
			ApplyToUniverse = true,
			Duration = -1,
			DisplayReason = reason,
			PrivateReason = "Banned by " .. admin.Name .. " from the admin panel",
			ExcludeAltAccounts = false,
		})
	end)
	local target = Players:GetPlayerByUserId(userId)
	if target then
		target:Kick("You have been banned. " .. reason)
	end
	print(string.format("[Admin] %s banned %s (%d)", admin.Name, name, userId))
	reply(admin, true, name .. " has been banned.")
end

function actions.unban(admin: Player, args: any)
	local name = args.username
	if not Rules.isValidUsername(name) then
		reply(admin, false, "That's not a valid username.")
		return
	end
	local userId = userIdFor(name)
	if not userId then
		reply(admin, false, "No Roblox user called " .. name .. ".")
		return
	end
	if banStore then
		pcall(function()
			(banStore :: DataStore):RemoveAsync(tostring(userId))
		end)
	end
	pcall(function()
		Players:UnbanAsync({ UserIds = { userId }, ApplyToUniverse = true })
	end)
	print(string.format("[Admin] %s unbanned %s (%d)", admin.Name, name, userId))
	reply(admin, true, name .. " has been unbanned.")
end

function actions.plaza(admin: Player, args: any)
	if args.all == true then
		for _, p in Players:GetPlayers() do
			ClimbService.sendToPlaza(p)
		end
		print(string.format("[Admin] %s sent everyone to the plaza", admin.Name))
		reply(admin, true, "Sent everyone to the plaza.")
		return
	end
	local target = if Rules.isValidUsername(args.username) then findOnline(args.username) else nil
	if not target then
		reply(admin, false, "That player isn't in this server.")
		return
	end
	ClimbService.sendToPlaza(target)
	ClimbService.toast(target, "An admin sent you to the plaza.", "info")
	reply(admin, true, "Sent " .. target.Name .. " to the plaza.")
end

local function setPass(admin: Player, args: any, give: boolean)
	local pass = passDef(args.passId)
	if not pass then
		reply(admin, false, "Pick a gamepass first.")
		return
	end
	local target = if Rules.isValidUsername(args.username) then findOnline(args.username) else nil
	if not target then
		reply(admin, false, "That player needs to be in this server.")
		return
	end
	local ok = DataService.update(target, function(d)
		d.GrantedPasses[pass.Id] = if give then true else nil
	end)
	if not ok then
		reply(admin, false, target.Name .. "'s data hasn't loaded yet.")
		return
	end
	if give then
		notify:FireClient(target, "Unlock", { text = "An admin gave you the " .. pass.Name .. " gamepass!" })
	end
	print(string.format("[Admin] %s %s %s %s", admin.Name, if give then "gave" else "took", pass.Id, target.Name))
	reply(admin, true, string.format("%s %s %s.", if give then "Gave" else "Took", pass.Name, if give then "to " .. target.Name else "from " .. target.Name))
end

function actions.givePass(admin: Player, args: any)
	setPass(admin, args, true)
end

function actions.takePass(admin: Player, args: any)
	setPass(admin, args, false)
end

function actions.announce(admin: Player, args: any)
	local text = args.text
	if type(text) ~= "string" or #text == 0 or #text > Config.Admin.MaxAnnouncementLength then
		reply(admin, false, "Announcements need 1-" .. Config.Admin.MaxAnnouncementLength .. " characters.")
		return
	end
	local filtered = filterForEveryone(text, admin.UserId)
	if not filtered then
		reply(admin, false, "Roblox's text filter is unavailable right now; try again.")
		return
	end
	local message = { text = filtered, from = admin.DisplayName }
	local published = pcall(function()
		MessagingService:PublishAsync(Config.Admin.AnnounceTopic, message)
	end)
	if not published then
		-- Studio / messaging down: at least tell this server.
		notify:FireAllClients("Announcement", message)
	end
	print(string.format("[Admin] %s announced: %s", admin.Name, filtered))
	reply(admin, true, if published then "Announcement sent to every server." else "Announcement sent to this server.")
end

-- Gamepasses bought with Robux ---------------------------------------------------------

local function checkMarketPasses(player: Player)
	for _, pass in Config.GamePasses do
		if pass.GamePassId and pass.GamePassId > 0 then
			local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.GamePassId)
			if ok and owns then
				DataService.setMarketPass(player, pass.Id, true)
			end
		end
	end
end

-- Start ---------------------------------------------------------------------------------

function AdminService.start()
	notify = Remotes.get("Notify")

	local function onPlayer(player: Player)
		-- Our own ban list (backs up Roblox bans, and works in unpublished places too).
		if banStore then
			local ok, ban = pcall(function()
				return (banStore :: DataStore):GetAsync(tostring(player.UserId))
			end)
			if ok and type(ban) == "table" and not isProtected(player.UserId) then
				player:Kick("You are banned. " .. tostring(ban.reason or ""))
				return
			end
		end
		task.spawn(checkMarketPasses, player)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayer, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		admins[player] = nil
		attempts[player] = nil
		lastAction[player] = nil
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
		if not purchased then
			return
		end
		for _, pass in Config.GamePasses do
			if pass.GamePassId == gamePassId then
				DataService.setMarketPass(player, pass.Id, true)
				notify:FireClient(player, "Unlock", { text = pass.Name .. " unlocked. Thanks for the support!" })
			end
		end
	end)

	Remotes.get("AdminLogin").OnServerEvent:Connect(function(player, code)
		if admins[player] then
			reply(player, true, "You're already an admin.")
			return
		end
		local allowed
		allowed, attempts[player] = Rules.allowAttempt(Config.Admin, attempts[player] or {}, os.clock())
		if not allowed then
			reply(player, false, "Too many tries. Wait a few minutes.")
			return
		end
		if Rules.adminCodeMatches(AdminConfig.Password, code) then
			grant(player)
			print("[Admin] " .. player.Name .. " unlocked the admin panel")
			reply(player, true, "Password accepted. Admin panel unlocked.")
		else
			reply(player, false, "Wrong password.")
		end
	end)

	Remotes.get("AdminAction").OnServerEvent:Connect(function(player, action, args)
		if not admins[player] then
			return -- not an admin: ignore silently
		end
		if typeof(action) ~= "string" or not actions[action] or typeof(args) ~= "table" then
			return
		end
		local now = os.clock()
		if now - (lastAction[player] or 0) < 0.5 then
			reply(player, false, "Slow down a little.")
			return
		end
		lastAction[player] = now
		actions[action](player, args)
	end)

	pcall(function()
		MessagingService:SubscribeAsync(Config.Admin.AnnounceTopic, function(message)
			local data = message.Data
			if type(data) == "table" and type(data.text) == "string" then
				notify:FireAllClients("Announcement", { text = data.text, from = tostring(data.from or "Admin") })
			end
		end)
	end)
end

return AdminService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[-- Small helpers for creating anchored geometry from code.
local Build = {}

local BATCH = 300 -- parts per frame while batching
local batching = false
local created = 0

-- While on, every BATCH parts the builder pauses a frame (see WorldBuilder.build).
function Build.setBatching(on: boolean)
	batching = on
end

function Build.count(): number
	return created
end

-- Create an instance, apply properties, then parent it last (cheaper replication).
function Build.part(parent: Instance, props: { [string]: any }): BasePart
	local part = Instance.new(props.ClassName or "Part") :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		-- Shape first: changing it afterwards can resize the part.
		(part :: Part).Shape = props.Shape
	end
	for key, value in props do
		if key ~= "ClassName" and key ~= "Attributes" and key ~= "Tags" and key ~= "Shape" then
			(part :: any)[key] = value
		end
	end
	if props.Attributes then
		for key, value in props.Attributes do
			part:SetAttribute(key, value)
		end
	end
	if props.Tags then
		for _, tag in props.Tags do
			part:AddTag(tag)
		end
	end
	part.Parent = parent
	created += 1
	if batching and created % BATCH == 0 then
		task.wait()
	end
	return part
end

-- Decorative strut between two world points. Non-colliding so it never snags climbers.
function Build.beam(parent: Instance, a: Vector3, b: Vector3, thickness: number, props: { [string]: any }): BasePart
	local dir = b - a
	local length = dir.Magnitude
	local up = if math.abs(dir.Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local merged = {
		Size = Vector3.new(thickness, thickness, length),
		CFrame = CFrame.lookAt((a + b) / 2, b, up),
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}
	for key, value in props do
		merged[key] = value
	end
	return Build.part(parent, merged)
end

-- Vertical cylinder centred at `center`.
function Build.cylinder(parent: Instance, center: Vector3, height: number, diameter: number, props: { [string]: any }): BasePart
	local merged = {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
	}
	for key, value in props do
		merged[key] = value
	end
	return Build.part(parent, merged)
end

-- Red blinking aviation light (blinking is driven by EnvironmentService).
function Build.aviationLight(parent: Instance, position: Vector3, size: number?): BasePart
	local bulb = Build.part(parent, {
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * (size or 1.6),
		Position = position,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 40, 40),
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Tags = { "AviationLight" },
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 60, 60)
	light.Range = 24
	light.Brightness = 3
	light.Parent = bulb
	return bulb
end

-- Billboard-style sign text on the front face of a part.
function Build.surfaceText(part: BasePart, lines: { { text: string, size: number, color: Color3, font: Enum.Font? } })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 6)
	layout.Parent = gui
	for i, line in lines do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = i
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, -20, 0, line.size)
		label.Font = line.font or Enum.Font.GothamBlack
		label.Text = line.text
		label.TextColor3 = line.color
		label.TextScaled = true
		label.Parent = gui
	end
	gui.Parent = part
	return gui
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ClimbService</string>
          <string name="Source"><![CDATA[-- Climb tracking: base/peak zones, payouts, checkpoints, trails.
--
-- A climb starts when you touch a tower's BaseZone and pays out once when you
-- reach its PeakZone. The peak only pays if the climb started on the same
-- tower and took a physically plausible amount of time.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)
local RopeService = require(script.Parent.RopeService)

local ClimbService = {}

type Checkpoint = { tower: string, position: Vector3, normal: Vector3 }

local active: { [Player]: Rules.ActiveClimb } = {}
local checkpoints: { [Player]: Checkpoint } = {}
local lastRejectNotice: { [Player]: number } = {}
local plazaSpawn: CFrame = CFrame.new(0, 4, 24)

local notify: RemoteEvent
local towersById: { [string]: Model } = {}

local function playerFromHit(hit: BasePart): (Player?, Humanoid?)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil, nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not player or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return player, humanoid
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function ClimbService.toast(player: Player, text: string, style: string?)
	notify:FireClient(player, "Toast", { text = text, style = style or "info" })
end

function ClimbService.sendToPlaza(player: Player)
	checkpoints[player] = nil
	RopeService.unclip(player)
	local character = player.Character
	if character then
		local offset = Vector3.new(math.random(-6, 6), 0, math.random(-4, 4))
		character:PivotTo(plazaSpawn + offset)
	end
end

function ClimbService.equipTrail(player: Player)
	local character = player.Character
	local root = rootOf(player)
	local data = DataService.get(player)
	if not character or not root or not data then
		return
	end
	local best = Rules.bestTrail(Config.Trails, data.Climbs)
	local existing = root:FindFirstChild("ClimbTrail") :: Trail?
	if existing and best and existing:GetAttribute("TrailName") == best.Name then
		return
	end
	if existing then
		existing:Destroy()
	end
	for _, name in { "TrailTop", "TrailBottom" } do
		local old = root:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	if not best then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailTop"
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailBottom"
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "ClimbTrail"
	trail:SetAttribute("TrailName", best.Name)
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.6
	trail.LightEmission = 0.6
	trail.FaceCamera = true
	local c = Color3.fromRGB(best.Color[1], best.Color[2], best.Color[3])
	trail.Color = ColorSequence.new(c)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = root
end

local function onPeak(tower: Model, player: Player)
	local id = tower:GetAttribute("TowerId") :: string
	local height = tower:GetAttribute("Height") :: number
	local ok, reason = Rules.validatePeak(Config.Climb, active[player], id, height, os.clock())
	if not ok then
		local now = os.clock()
		if now - (lastRejectNotice[player] or 0) > 6 then
			lastRejectNotice[player] = now
			ClimbService.toast(player, reason :: string, "bad")
		end
		return
	end
	local climb = active[player] :: Rules.ActiveClimb
	climb.paid = true
	checkpoints[player] = nil

	local payout = Rules.payout(tower:GetAttribute("Payout") :: number, Config.GamePasses, DataService.effectiveBoosts(player))
	local before = (DataService.get(player) or {}).Climbs or 0
	DataService.update(player, function(data)
		data.Cash += payout
		data.Climbs += 1
	end)
	local data = DataService.get(player)
	if not data then
		return
	end
	notify:FireClient(player, "Summit", { tower = id, payout = payout, climbs = data.Climbs })

	local oldTrail = Rules.bestTrail(Config.Trails, before)
	local newTrail = Rules.bestTrail(Config.Trails, data.Climbs)
	if newTrail and newTrail ~= oldTrail then
		notify:FireClient(player, "Unlock", { text = newTrail.Name .. " trail unlocked!" })
		ClimbService.equipTrail(player)
	end
end

local function restLevels(tower: Model): { number }
	local levels = {}
	for value in string.gmatch(tostring(tower:GetAttribute("RestLevels") or ""), "[^,]+") do
		table.insert(levels, tonumber(value) :: number)
	end
	return levels
end

-- The client says it's hanging on a rest bar; check that's plausible and save
-- a checkpoint there (you respawn hanging on the wall at that spot).
local function onRestCheckpoint(player: Player, normal: any)
	if typeof(normal) ~= "Vector3" or normal.Magnitude < 0.5 or normal.Magnitude > 1.5 then
		return
	end
	local climb = active[player]
	local root = rootOf(player)
	if not climb or climb.paid or not root then
		return
	end
	local tower = towersById[climb.tower]
	if not tower then
		return
	end
	local pivot = tower.WorldPivot.Position
	local radius = tower:GetAttribute("Radius") or 0
	local pos = root.Position
	if math.abs(pos.X - pivot.X) > radius or math.abs(pos.Z - pivot.Z) > radius then
		return
	end
	local handY = pos.Y + 2.5
	local nearBar = false
	for _, y in restLevels(tower) do
		if math.abs(handY - y) <= Config.Climb.RestBarReach + 1 then
			nearBar = true
		end
	end
	if not nearBar then
		return
	end
	local cp = checkpoints[player]
	if cp and cp.tower == climb.tower and pos.Y <= cp.position.Y + 4 then
		return
	end
	local flat = Vector3.new(normal.X, 0, normal.Z)
	checkpoints[player] = {
		tower = climb.tower,
		position = pos,
		normal = if flat.Magnitude > 0.1 then flat.Unit else Vector3.zAxis,
	}
	ClimbService.toast(player, "Checkpoint saved", "good")
end

local function hookTower(tower: Model)
	local id = tower:GetAttribute("TowerId") :: string
	towersById[id] = tower
	local base = tower:FindFirstChild("BaseZone") :: BasePart
	local peak = tower:FindFirstChild("PeakZone") :: BasePart

	base.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if not player then
			return
		end
		local climb = active[player]
		-- Re-arm when starting fresh, switching tower, or after being paid.
		-- Still at the bottom of the current climb: the timer runs from the last
		-- base touch, which keeps the "too fast" check strict.
		if climb and climb.tower == id and not climb.paid then
			climb.startTime = os.clock()
			return
		end
		active[player] = { tower = id, startTime = os.clock(), paid = false }
		local cp = checkpoints[player]
		if cp and cp.tower ~= id then
			checkpoints[player] = nil
		end
	end)

	peak.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if player then
			onPeak(tower, player)
		end
	end)

end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.BreakJointsOnDeath = false -- we ragdoll on death instead
	humanoid.RequiresNeck = false
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not root then
		return
	end
	task.defer(ClimbService.equipTrail, player)

	local cp = checkpoints[player]
	if cp then
		task.wait(0.1)
		if character.Parent then
			-- Back on the wall, facing it; the client grabs on straight away.
			character:PivotTo(CFrame.lookAt(cp.position, cp.position - cp.normal))
			notify:FireClient(player, "Regrip", {})
			ClimbService.toast(player, "Respawned at your last checkpoint", "info")
		end
	end
end

function ClimbService.start(towers: Folder, spawnCFrame: CFrame)
	plazaSpawn = spawnCFrame
	notify = Remotes.get("Notify")
	for _, tower in towers:GetChildren() do
		if tower:IsA("Model") and tower:GetAttribute("TowerId") then
			hookTower(tower)
		end
	end

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
		checkpoints[player] = nil
		lastRejectNotice[player] = nil
	end)

	local lastRest: { [Player]: number } = {}
	Remotes.get("RestCheckpoint").OnServerEvent:Connect(function(player, normal)
		local now = os.clock()
		if now - (lastRest[player] or 0) < 0.5 then
			return
		end
		lastRest[player] = now
		onRestCheckpoint(player, normal)
	end)

	Remotes.get("ResetToPlaza").OnServerEvent:Connect(function(player)
		active[player] = nil
		ClimbService.sendToPlaza(player)
	end)

	-- Track best height reached (shown on the HUD).
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local root = rootOf(player)
				local data = DataService.get(player)
				if root and data and root.Position.Y > data.BestHeight + 1 and root.Position.Y < 2000 then
					DataService.update(player, function(d)
						d.BestHeight = math.floor(root.Position.Y)
					end)
				end
			end
		end
	end)
end

return ClimbService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Player save data.
--
-- Safety rules:
--   * Never save a profile that failed to load. Saving defaults over real data
--     would wipe the player.
--   * Session lock: a profile records which server owns it, so two servers can't
--     overwrite each other when a player hops quickly. A stale lock (server
--     crashed) is taken over after LOCK_TIMEOUT.
--   * Retries with backoff, autosave, and a final save on leave / shutdown.
--
-- In an unpublished place, or with Studio API access off, DataStores fail; the
-- game still runs but progress is not saved and the player is told so.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)

local DataService = {}

local LOCK_TIMEOUT = 180
local RETRIES = 3

type Profile = { data: any, persistent: boolean, dirty: boolean }

local profiles: { [Player]: Profile } = {}
local marketPasses: { [Player]: { [string]: boolean } } = {} -- bought with Robux
local changedCallbacks: { (Player, any) -> () } = {}

local store: DataStore? = nil
local orderedStore: OrderedDataStore? = nil
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
		orderedStore = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if not ok then
		warn("[DataService] DataStores unavailable, progress will not save:", err)
	end
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function withRetries<T>(label: string, fn: () -> T): (boolean, T | string)
	local lastErr
	for attempt = 1, RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		warn(string.format("[DataService] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		if attempt < RETRIES then
			task.wait(2 ^ attempt)
		end
	end
	return false, lastErr
end

-- Copies the profile onto the player so the client UI can read it.
local function sync(player: Player, data: any)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		(stats:FindFirstChild("Cash") :: IntValue).Value = data.Cash;
		(stats:FindFirstChild("Climbs") :: IntValue).Value = data.Climbs
	end
	for id, lvl in data.Boosts do
		player:SetAttribute("Boost_" .. id, lvl)
	end
	player:SetAttribute("Chalk", data.Chalk)
	local owned = {}
	for _, def in Config.Emotes do
		if Rules.ownsEmote(Config.Emotes, data.Emotes, def.Id) then
			table.insert(owned, def.Id)
		end
	end
	player:SetAttribute("Emotes", table.concat(owned, ","))
	player:SetAttribute("SummitEmote", data.SummitEmote)
	player:SetAttribute("Streak", data.Streak)
	player:SetAttribute("BestHeight", math.floor(data.BestHeight))
	local market = marketPasses[player] or {}
	for _, pass in Config.GamePasses do
		player:SetAttribute("Pass_" .. pass.Id, data.GrantedPasses[pass.Id] == true or market[pass.Id] == true)
	end
	for key, value in data.Settings do
		player:SetAttribute("Setting_" .. key, value)
	end
	for _, cb in changedCallbacks do
		task.spawn(cb, player, data)
	end
end

local function makeLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local climbs = Instance.new("IntValue")
	climbs.Name = "Climbs"
	climbs.Parent = stats
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = stats
	stats.Parent = player
end

function DataService.load(player: Player): any
	makeLeaderstats(player)
	local persistent = false
	local saved = nil

	if store then
		local key = keyFor(player)
		for attempt = 1, RETRIES do
			local lockedElsewhere = false
			local ok, err = withRetries("load " .. key, function()
				return (store :: DataStore):UpdateAsync(key, function(old)
					old = old or {}
					local lock = old._lock
					lockedElsewhere = lock ~= nil
						and lock.job ~= game.JobId
						and os.time() - (lock.time or 0) < LOCK_TIMEOUT
						and attempt < RETRIES -- last attempt takes over the lock
					if lockedElsewhere then
						return nil -- cancel the write; try again shortly
					end
					saved = old
					old._lock = { job = game.JobId, time = os.time() }
					return old
				end)
			end)
			if not ok then
				warn("[DataService] could not load", player.Name, err)
				break
			end
			if not lockedElsewhere then
				persistent = true
				break
			end
			task.wait(5)
		end
	end

	if not player.Parent then
		-- Left while loading: hand the lock back so their next server isn't kept waiting.
		if persistent and store then
			pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					if old and old._lock and old._lock.job == game.JobId then
						old._lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return nil
	end

	local data = Rules.reconcileProfile(Config.Boosts, Config.Chalk, saved, Config.Emotes)
	profiles[player] = { data = data, persistent = persistent, dirty = false }
	sync(player, data)
	player:SetAttribute("DataLoaded", true)
	player:SetAttribute("DataPersistent", persistent)
	return data
end

function DataService.get(player: Player): any?
	local profile = profiles[player]
	return profile and profile.data
end

function DataService.isLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

-- Mutate a player's data through `fn`; changes are mirrored to the client.
function DataService.update(player: Player, fn: (any) -> ())
	local profile = profiles[player]
	if not profile then
		return false
	end
	fn(profile.data)
	profile.dirty = true
	sync(player, profile.data)
	return true
end

-- Gamepasses the player owns: bought with Robux or granted by an admin.
function DataService.ownedPasses(player: Player): { [string]: boolean }
	local owned = table.clone(marketPasses[player] or {})
	local data = DataService.get(player)
	for id, has in (data and data.GrantedPasses or {}) :: { [string]: boolean } do
		if has then
			owned[id] = true
		end
	end
	return owned
end

-- Boost levels with owned gamepasses folded in (for Rules perk math).
function DataService.effectiveBoosts(player: Player): Rules.Boosts
	local data = DataService.get(player)
	return Rules.withPasses(data and data.Boosts or {}, DataService.ownedPasses(player))
end

function DataService.setMarketPass(player: Player, passId: string, owned: boolean)
	marketPasses[player] = marketPasses[player] or {}
	marketPasses[player][passId] = owned
	local profile = profiles[player]
	if profile then
		sync(player, profile.data)
	end
end

function DataService.onChanged(cb: (Player, any) -> ())
	table.insert(changedCallbacks, cb)
end

function DataService.save(player: Player, release: boolean)
	local profile = profiles[player]
	if not profile or not profile.persistent or not store then
		return
	end
	if not profile.dirty and not release then
		return
	end
	local key = keyFor(player)
	local snapshot = table.clone(profile.data)
	snapshot.Boosts = table.clone(profile.data.Boosts)
	snapshot.Emotes = table.clone(profile.data.Emotes)
	snapshot.GrantedPasses = table.clone(profile.data.GrantedPasses)
	snapshot.Settings = table.clone(profile.data.Settings)
	local ok = withRetries("save " .. key, function()
		return (store :: DataStore):UpdateAsync(key, function(old)
			old = old or {}
			local lock = old._lock
			if lock and lock.job ~= game.JobId and os.time() - (lock.time or 0) < LOCK_TIMEOUT then
				-- Another server took this profile over; don't clobber its data.
				return nil
			end
			snapshot._lock = if release then nil else { job = game.JobId, time = os.time() }
			return snapshot
		end)
	end)
	if ok then
		profile.dirty = false
	end
	if orderedStore then
		pcall(function()
			(orderedStore :: OrderedDataStore):SetAsync(tostring(player.UserId), profile.data.Climbs)
		end)
	end
end

function DataService.release(player: Player)
	DataService.save(player, true)
	profiles[player] = nil
	marketPasses[player] = nil
end

function DataService.start()
	Players.PlayerRemoving:Connect(function(player)
		DataService.release(player)
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in profiles do
				task.spawn(DataService.save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

DataService.orderedStore = function()
	return orderedStore
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">EnvironmentService</string>
          <string name="Source"><![CDATA[-- Day/night cycle, blinking aviation lights, street lights and wind gusts.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local EnvironmentService = {}

local function isNight(clock: number): boolean
	return clock < 6.3 or clock > 17.7
end

local function setStreetLights(on: boolean)
	for _, head in CollectionService:GetTagged("StreetLight") do
		local light = head:FindFirstChildWhichIsA("Light")
		if light then
			light.Enabled = on
		end
		(head :: BasePart).Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
	-- A scattering of skyscraper windows glow at night.
	for _, window in CollectionService:GetTagged("NightWindow") do
		(window :: BasePart).Transparency = if on then 0 else 1
	end
end

-- Weather: tween the sky to the new state and publish it as a Workspace
-- attribute; clients draw the rain and apply the slippery-wall drain.
local function pickWeather(rng: Random, current: string): string
	local options, total = {}, 0
	for name, chance in Config.Weather.Chances do
		if name ~= current then
			table.insert(options, { name, chance })
			total += chance
		end
	end
	table.sort(options, function(a, b)
		return a[1] < b[1]
	end)
	local roll = rng:NextNumber(0, total)
	for _, option in options do
		roll -= option[2]
		if roll <= 0 then
			return option[1]
		end
	end
	return options[#options][1]
end

local function applyWeather(name: string, clouds: Clouds)
	local state = Config.Weather.States[name]
	local info = TweenInfo.new(Config.Weather.TransitionTime, Enum.EasingStyle.Sine)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, { Density = state.Density, Haze = state.Haze }):Play()
	end
	local grade = Lighting:FindFirstChild("ColorGrade")
	if grade and grade:IsA("ColorCorrectionEffect") then
		TweenService:Create(grade, info, { Saturation = state.Saturation }):Play()
	end
	TweenService:Create(Lighting, info, { Brightness = state.Brightness }):Play()
	TweenService:Create(clouds, info, { Cover = state.CloudCover, Density = 0.4 + state.CloudCover * 0.4 }):Play()
	Workspace:SetAttribute("Weather", name)
end

function EnvironmentService.start()
	-- Advance the clock a few times a second rather than every frame: ClockTime
	-- replicates to every client, so per-frame writes are needless traffic.
	local hoursPerSecond = 24 / Config.DayLengthSeconds
	local wasNight: boolean? = nil
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.25)
			local now = os.clock()
			Lighting.ClockTime = (Lighting.ClockTime + (now - last) * hoursPerSecond) % 24
			last = now
			local night = isNight(Lighting.ClockTime)
			if night ~= wasNight then
				wasNight = night
				setStreetLights(night)
			end
		end
	end)

	-- Aviation lights: slow red blink, like the real thing.
	task.spawn(function()
		local on = true
		while true do
			task.wait(if on then 1.2 else 0.8)
			on = not on
			for _, bulb in CollectionService:GetTagged("AviationLight") do
				local light = bulb:FindFirstChildOfClass("PointLight")
				if light then
					light.Enabled = on
				end
				(bulb :: BasePart).Transparency = if on then 0 else 0.6
			end
		end
	end)

	local clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds")
	if not clouds then
		clouds = Instance.new("Clouds")
		clouds.Parent = Workspace.Terrain
	end
	local weatherRng = Random.new()
	applyWeather("Clear", clouds :: Clouds)
	task.spawn(function()
		local current = "Clear"
		while true do
			task.wait(weatherRng:NextNumber(Config.Weather.MinDuration, Config.Weather.MaxDuration))
			current = pickWeather(weatherRng, current)
			applyWeather(current, clouds :: Clouds)
		end
	end)

	-- Wind gusts: warn everyone, then blow. Clients apply the effect to themselves.
	local gust = Remotes.get("Gust")
	local rng = Random.new()
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(Config.Wind.MinInterval, Config.Wind.MaxInterval))
			local angle = rng:NextNumber(0, math.pi * 2)
			local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
			gust:FireAllClients("warn", dir, Config.Wind.WarningTime)
			task.wait(Config.Wind.WarningTime)
			gust:FireAllClients("start", dir, Config.Wind.Duration)
		end
	end)
end

return EnvironmentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[-- Fills the plaza leaderboard with the all-time top climbers. Falls back to the
-- players in this server when the OrderedDataStore isn't available (Studio).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local ROWS = 10
local nameCache: { [number]: string } = {}

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = if ok then name else "Player " .. userId
	nameCache[userId] = result
	return result
end

local function buildBoard(part: BasePart): ({ TextLabel }, TextLabel)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 80)
	title.Font = Enum.Font.GothamBlack
	title.Text = "TOP CLIMBERS"
	title.TextColor3 = Color3.fromRGB(255, 210, 60)
	title.TextScaled = true
	title.Parent = gui
	local subtitle = Instance.new("TextLabel")
	subtitle.BackgroundTransparency = 1
	subtitle.Position = UDim2.fromOffset(0, 80)
	subtitle.Size = UDim2.new(1, 0, 0, 30)
	subtitle.Font = Enum.Font.GothamMedium
	subtitle.Text = ""
	subtitle.TextColor3 = Color3.fromRGB(160, 170, 190)
	subtitle.TextScaled = true
	subtitle.Parent = gui
	local rows = {}
	for i = 1, ROWS do
		local row = Instance.new("TextLabel")
		row.BackgroundTransparency = if i % 2 == 0 then 1 else 0.85
		row.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		row.BorderSizePixel = 0
		row.Position = UDim2.new(0, 20, 0, 120 + (i - 1) * 42)
		row.Size = UDim2.new(1, -40, 0, 40)
		row.Font = Enum.Font.GothamBold
		row.TextColor3 = if i == 1 then Color3.fromRGB(255, 215, 80) else Color3.new(1, 1, 1)
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Text = ""
		row.Parent = gui
		rows[i] = row
	end
	gui.Parent = part
	return rows, subtitle
end

local function render(rows: { TextLabel }, entries: { { name: string, climbs: number } })
	for i, row in rows do
		local entry = entries[i]
		row.Text = if entry then string.format("  #%d  %s  -  %d climbs", i, entry.name, entry.climbs) else ""
	end
end

local function localEntries(): { { name: string, climbs: number } }
	local entries = {}
	for _, player in Players:GetPlayers() do
		local data = DataService.get(player)
		if data then
			table.insert(entries, { name = player.DisplayName, climbs = data.Climbs })
		end
	end
	table.sort(entries, function(a, b)
		return a.climbs > b.climbs
	end)
	return entries
end

function LeaderboardService.start(board: BasePart)
	local rows, subtitle = buildBoard(board)
	task.spawn(function()
		while true do
			local store = DataService.orderedStore()
			local entries = nil
			if store then
				local ok, pages = pcall(function()
					return store:GetSortedAsync(false, ROWS)
				end)
				if ok then
					entries = {}
					for _, item in pages:GetCurrentPage() do
						local userId = tonumber(item.key)
						if userId then
							table.insert(entries, { name = nameFor(userId), climbs = item.value })
						end
					end
				end
			end
			if entries and #entries > 0 then
				subtitle.Text = "All-time tower climbs"
				render(rows, entries)
			else
				subtitle.Text = "Climbs in this server"
				render(rows, localEntries())
			end
			task.wait(Config.LeaderboardRefresh)
		end
	end)
	-- Keep the local fallback lively between store refreshes.
	DataService.onChanged(function()
		if subtitle.Text == "Climbs in this server" then
			render(rows, localEntries())
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: builds the world and starts every service.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Remotes)

Remotes.create()

local WorldBuilder = require(script.Parent.WorldBuilder)
local DataService = require(script.Parent.DataService)
local ClimbService = require(script.Parent.ClimbService)
local RagdollService = require(script.Parent.RagdollService)
local ShopService = require(script.Parent.ShopService)
local EnvironmentService = require(script.Parent.EnvironmentService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local AdminService = require(script.Parent.AdminService)
local RopeService = require(script.Parent.RopeService)

local world, towers = WorldBuilder.build()

-- Keep the spawn pad on the plaza even if someone moved it in Studio.
local spawn = Workspace:FindFirstChildOfClass("SpawnLocation")
local spawnCFrame = if spawn then spawn.CFrame + Vector3.new(0, 4, 0) else WorldBuilder.PlazaSpawn

DataService.start()
ClimbService.start(towers, spawnCFrame)
RagdollService.start()
ShopService.start()
EnvironmentService.start()
LeaderboardService.start(world:FindFirstChild("Leaderboard") :: BasePart)
AdminService.start()
RopeService.start()

local notify = Remotes.get("Notify")

local function onPlayer(player: Player)
	local data = DataService.load(player)
	if not data then
		return
	end
	ClimbService.equipTrail(player)
	if not player:GetAttribute("DataPersistent") then
		notify:FireClient(player, "Toast", {
			text = "Saving is off here (publish the place and enable API access to keep progress).",
			style = "bad",
		})
	end

	local today = math.floor(os.time() / 86400)
	local streak, reward, claimed = Rules.dailyReward(Config.Daily, data.LastDaily, data.Streak, today)
	if not claimed then
		DataService.update(player, function(d)
			d.LastDaily = today
			d.Streak = streak
			d.Cash += reward
		end)
		notify:FireClient(player, "Daily", { streak = streak, reward = reward })
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">RagdollService</string>
          <string name="Source"><![CDATA[-- Server half of the ragdoll: swaps Motor6Ds for BallSocketConstraints so every
-- client sees the floppy body, and applies fall damage when the player gets up.
-- The owning client puts its Humanoid into the Physics state (it owns the
-- character's physics).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local RagdollService = {}

type RagdollState = {
	character: Model,
	startY: number,
	startedAt: number,
	motors: { Motor6D },
	created: { Instance },
	collisions: { [BasePart]: boolean },
}

local states: { [Player]: RagdollState } = {}
local ROOT_JOINTS = { Root = true, RootJoint = true }

local function enableRagdoll(character: Model): ({ Motor6D }, { Instance }, { [BasePart]: boolean })
	local motors, created, collisions = {}, {}, {}
	for _, motor in character:GetDescendants() do
		if motor:IsA("Motor6D") and not ROOT_JOINTS[motor.Name] and motor.Part0 and motor.Part1 then
			local a0 = Instance.new("Attachment")
			a0.Name = "RagdollA0"
			a0.CFrame = motor.C0
			a0.Parent = motor.Part0
			local a1 = Instance.new("Attachment")
			a1.Name = "RagdollA1"
			a1.CFrame = motor.C1
			a1.Parent = motor.Part1
			local socket = Instance.new("BallSocketConstraint")
			socket.Name = "RagdollSocket"
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.LimitsEnabled = true
			socket.UpperAngle = 70
			socket.TwistLimitsEnabled = true
			socket.TwistLowerAngle = -50
			socket.TwistUpperAngle = 50
			socket.Parent = motor.Part0
			motor.Enabled = false
			table.insert(motors, motor)
			table.insert(created, a0)
			table.insert(created, a1)
			table.insert(created, socket)
		end
	end
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			collisions[part] = part.CanCollide
			part.CanCollide = true
		end
	end
	return motors, created, collisions
end

local function disableRagdoll(state: RagdollState)
	for _, motor in state.motors do
		if motor.Parent then
			motor.Enabled = true
		end
	end
	for _, inst in state.created do
		inst:Destroy()
	end
	for part, canCollide in state.collisions do
		if part.Parent then
			part.CanCollide = canCollide
		end
	end
end

local function rootOf(character: Model): BasePart?
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function RagdollService.set(player: Player, ragdolled: boolean, claimedStartY: number?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and rootOf(character)
	if not character or not humanoid or not root then
		return
	end
	local state = states[player]

	if ragdolled and not state then
		if humanoid.Health <= 0 then
			return
		end
		-- Trust the client's fall start only within sane bounds (it can only lie
		-- in its own disfavour by more than this).
		local y = root.Position.Y
		local startY = if typeof(claimedStartY) == "number" and claimedStartY == claimedStartY
			then math.clamp(claimedStartY, y, y + 1500)
			else y
		local motors, created, collisions = enableRagdoll(character)
		states[player] = {
			character = character,
			startY = startY,
			startedAt = os.clock(),
			motors = motors,
			created = created,
			collisions = collisions,
		}
	elseif not ragdolled and state then
		states[player] = nil
		if state.character ~= character then
			return
		end
		disableRagdoll(state)
		local data = DataService.get(player)
		local damage = if data
			then Rules.fallDamage(Config.Fall, Config.Boosts, DataService.effectiveBoosts(player), state.startY - root.Position.Y, Config.GamePasses)
			else 0
		if damage > 0 and humanoid.Health > 0 then
			humanoid:TakeDamage(damage)
			Remotes.get("Notify"):FireClient(player, "Hurt", { damage = math.floor(damage) })
		end
	end
end

function RagdollService.start()
	local lastCall: { [Player]: number } = {}
	Remotes.get("Ragdoll").OnServerEvent:Connect(function(player, ragdolled, startY)
		if typeof(ragdolled) ~= "boolean" then
			return
		end
		local now = os.clock()
		if ragdolled and now - (lastCall[player] or 0) < 0.25 then
			return
		end
		lastCall[player] = now
		RagdollService.set(player, ragdolled, if typeof(startY) == "number" then startY else nil)
	end)

	local function onCharacter(player: Player, character: Model)
		states[player] = nil -- old body is gone; nothing to restore
		local humanoid = character:WaitForChild("Humanoid") :: Humanoid
		humanoid.Died:Connect(function()
			-- Ragdoll Engine-style limp death instead of falling apart.
			if not states[player] and character.Parent then
				enableRagdoll(character)
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
		lastCall[player] = nil
	end)

	-- Failsafe: a client that never sends "get up" still gets its joints back.
	task.spawn(function()
		while true do
			task.wait(1)
			for player, state in states do
				if os.clock() - state.startedAt > Config.Fall.MaxRagdollTime + 5 then
					RagdollService.set(player, false)
				end
			end
		end
	end)
end

return RagdollService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">RopeService</string>
          <string name="Source"><![CDATA[-- Climbing rope: clip a carabiner onto a telecom tower's horizontal beam, or
-- stick a suction cup onto skyscraper glass, and a real RopeConstraint ties
-- your harness to it. Created here so every player sees the rope; the climber's
-- client simulates their own body, so the rope physically catches their falls.
-- The client asks for a clip point; it's validated here (on a clip bar / glass,
-- within reach) before anything is created.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local RopeService = {}

local anchors: { [Player]: BasePart } = {}
local lastRequest: { [Player]: number } = {}

local function ropesFolder(): Folder
	local folder = Workspace:FindFirstChild("Ropes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Ropes"
		folder.Parent = Workspace
	end
	return folder :: Folder
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

-- Closest point on a beam (its length runs along the part's Z axis).
local function closestOnBar(bar: BasePart, point: Vector3): Vector3
	local cf = bar.CFrame
	local along = cf.LookVector
	local half = bar.Size.Z / 2
	local d = math.clamp((point - cf.Position):Dot(along), -half, half)
	return cf.Position + along * d
end

-- What the point is clipped to: "carabiner" (telecom beam), "suction" (glass), or nil.
local function clipKind(point: Vector3): string?
	for _, bar in CollectionService:GetTagged("ClipBar") do
		if bar:IsA("BasePart") and (closestOnBar(bar, point) - point).Magnitude <= 1 then
			return "carabiner"
		end
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Workspace:FindFirstChild("Towers") :: Instance }
	for _, part in Workspace:GetPartBoundsInRadius(point, 1.5, params) do
		local tower = part:FindFirstAncestorOfClass("Model")
		if part:HasTag("Climbable") and tower and tower:GetAttribute("Kind") == "Skyscraper" then
			local localPoint = part.CFrame:PointToObjectSpace(point)
			local half = part.Size / 2 + Vector3.one
			if math.abs(localPoint.X) <= half.X and math.abs(localPoint.Y) <= half.Y and math.abs(localPoint.Z) <= half.Z then
				return "suction"
			end
		end
	end
	return nil
end

function RopeService.unclip(player: Player)
	local anchor = anchors[player]
	if anchor then
		anchor:Destroy()
		anchors[player] = nil
	end
	player:SetAttribute("RopeAnchor", nil)
	player:SetAttribute("RopeKind", nil)
end

local function clip(player: Player, point: Vector3)
	local root = rootOf(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if (point - root.Position).Magnitude > Config.Rope.Reach + 3 then
		return -- too far from the climber (allowing a little for lag)
	end
	local kind = clipKind(point)
	if not kind then
		return
	end
	RopeService.unclip(player)

	local anchor = Instance.new("Part")
	anchor.Name = player.Name .. "_" .. kind
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	if kind == "carabiner" then
		anchor.Size = Vector3.new(0.35, 0.9, 0.35)
		anchor.Color = Color3.fromRGB(255, 140, 30)
		anchor.Material = Enum.Material.Metal
	else
		anchor.Shape = Enum.PartType.Ball
		anchor.Size = Vector3.one * 1.3
		anchor.Color = Color3.fromRGB(255, 120, 40)
		anchor.Material = Enum.Material.Glass
		anchor.Transparency = 0.3
	end
	anchor.CFrame = CFrame.new(point)
	local att0 = Instance.new("Attachment")
	att0.Parent = anchor
	local harness = root:FindFirstChild("RopeAttachment") :: Attachment?
	if not harness then
		local att = Instance.new("Attachment")
		att.Name = "RopeAttachment"
		att.Parent = root
		harness = att
	end
	local rope = Instance.new("RopeConstraint")
	rope.Attachment0 = att0
	rope.Attachment1 = harness
	rope.Length = Config.Rope.Length
	rope.Visible = true
	rope.Thickness = 0.12
	rope.Color = BrickColor.new("Deep orange")
	rope.Restitution = 0.1
	rope.Parent = anchor
	anchor.Parent = ropesFolder()

	anchors[player] = anchor
	player:SetAttribute("RopeKind", kind)
	player:SetAttribute("RopeAnchor", point)
end

function RopeService.start()
	Remotes.get("Rope").OnServerEvent:Connect(function(player, action, point)
		local now = os.clock()
		if now - (lastRequest[player] or 0) < 0.25 then
			return
		end
		lastRequest[player] = now
		if action == "clip" and typeof(point) == "Vector3" then
			clip(player, point)
		elseif action == "unclip" then
			RopeService.unclip(player)
		end
	end)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			RopeService.unclip(player)
			local humanoid = character:WaitForChild("Humanoid") :: Humanoid
			humanoid.Died:Connect(function()
				RopeService.unclip(player)
			end)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		RopeService.unclip(player)
		lastRequest[player] = nil
	end)
end

return RopeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Server-authoritative purchases. Clients only ask; every check happens here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local ShopService = {}

local RATE_LIMIT = 0.2
local lastCall: { [Player]: number } = {}

local function allowed(player: Player): boolean
	local now = os.clock()
	if now - (lastCall[player] or 0) < RATE_LIMIT then
		return false
	end
	lastCall[player] = now
	return DataService.isLoaded(player)
end

local function toast(player: Player, text: string, style: string)
	Remotes.get("Notify"):FireClient(player, "Toast", { text = text, style = style })
end

function ShopService.start()
	Remotes.get("BuyBoost").OnServerEvent:Connect(function(player, boostId)
		if typeof(boostId) ~= "string" or #boostId > 32 or not allowed(player) then
			return
		end
		local data = DataService.get(player)
		local def = Rules.boostDef(Config.Boosts, boostId)
		if not data or not def then
			return
		end
		local result = Rules.canBuyBoost(Config.Boosts, boostId, data.Boosts[boostId] or 0, data.Cash)
		if not result.ok then
			toast(player, result.reason :: string, "bad")
			return
		end
		DataService.update(player, function(d)
			d.Cash -= result.cost :: number
			d.Boosts[boostId] = (d.Boosts[boostId] or 0) + 1
		end)
		toast(player, string.format("%s upgraded to level %d!", def.Name, data.Boosts[boostId]), "good")
	end)

	Remotes.get("BuyChalk").OnServerEvent:Connect(function(player)
		if not allowed(player) then
			return
		end
		local data = DataService.get(player)
		if not data then
			return
		end
		local result = Rules.canBuyChalk(Config.Chalk, data.Chalk, data.Cash)
		if not result.ok then
			toast(player, result.reason :: string, "bad")
			return
		end
		DataService.update(player, function(d)
			d.Cash -= result.cost :: number
			d.Chalk += 1
		end)
		toast(player, "Bought chalk (" .. data.Chalk .. " in bag)", "good")
	end)

	Remotes.get("BuyEmote").OnServerEvent:Connect(function(player, emoteId)
		if typeof(emoteId) ~= "string" or #emoteId > 32 or not allowed(player) then
			return
		end
		local data = DataService.get(player)
		if not data then
			return
		end
		local result = Rules.canBuyEmote(Config.Emotes, data.Emotes, emoteId, data.Cash)
		if not result.ok then
			toast(player, result.reason :: string, "bad")
			return
		end
		local def = Rules.emoteDef(Config.Emotes, emoteId)
		DataService.update(player, function(d)
			d.Cash -= result.cost :: number
			d.Emotes[emoteId] = true
			d.SummitEmote = emoteId -- a fresh purchase becomes your summit emote
		end)
		toast(player, def.Name .. " emote unlocked! Press G to use it.", "good")
	end)

	Remotes.get("EquipEmote").OnServerEvent:Connect(function(player, emoteId)
		if typeof(emoteId) ~= "string" or #emoteId > 32 or not allowed(player) then
			return
		end
		local data = DataService.get(player)
		if not data or not Rules.ownsEmote(Config.Emotes, data.Emotes, emoteId) then
			return
		end
		DataService.update(player, function(d)
			d.SummitEmote = emoteId
		end)
	end)

	-- Player settings (name tags, camera shake) are saved with the profile.
	Remotes.get("SaveSetting").OnServerEvent:Connect(function(player, key, value)
		if typeof(key) ~= "string" or typeof(value) ~= "boolean" or not allowed(player) then
			return
		end
		local data = DataService.get(player)
		if not data or data.Settings[key] == nil then
			return -- only settings that exist in the profile
		end
		DataService.update(player, function(d)
			d.Settings[key] = value
		end)
	end)

	Remotes.get("UseChalk").OnServerEvent:Connect(function(player)
		if not allowed(player) then
			return
		end
		local data = DataService.get(player)
		if not data then
			return
		end
		local now = Workspace:GetServerTimeNow()
		if (player:GetAttribute("ChalkUntil") or 0) > now then
			return -- already chalked up; don't waste one
		end
		if data.Chalk <= 0 then
			toast(player, "No chalk left - buy some at the shop", "bad")
			return
		end
		DataService.update(player, function(d)
			d.Chalk -= 1
		end)
		player:SetAttribute("ChalkUntil", now + Config.Chalk.Duration)
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">TowerBuilder</string>
          <string name="Source"><![CDATA[-- Procedural towers for Hand-over-Hand climbing.
--
-- Climbable surfaces carry the "Climbable" tag; the client climbing controller
-- raycasts against them. Nothing solid sticks out of a climbable face, so a
-- climber can go from the ground to the summit without being blocked, then
-- climbs straight over the top onto the summit deck / roof.
--
-- Rest spots are yellow rest bars across every face (decorative, non-colliding).
-- Their heights are published as the tower's "RestLevels" attribute; the
-- client lets you hang still there to recover stamina.
--
-- Telecom towers follow real self-supporting lattice towers: four tapering
-- legs, X-bracing, dishes, panel antennas and aviation lights. Each face of
-- each section has an invisible climb panel lying in the lattice face, so you
-- climb the lattice. Skyscrapers are glass towers with a frame grid, rooftop AC
-- units, an optional helipad, and windows that light up at night.

local Build = require(script.Parent.Build)

local TowerBuilder = {}

local WHITE = Color3.fromRGB(235, 235, 235)
local MAX_PART = 2000 -- Roblox parts are capped at 2048 studs per side

local FACES = {
	Vector3.new(0, 0, -1), -- face 0 points at the path
	Vector3.new(1, 0, 0),
	Vector3.new(0, 0, 1),
	Vector3.new(-1, 0, 0),
}

local function faceDir(f: number): Vector3
	return FACES[f % 4 + 1]
end

-- CFrame in tower space where local X points out of face `o`, Y is up and Z runs
-- along the face. (u, v, y) = (outward, along-face, height).
local function faceCF(towerCF: CFrame, o: Vector3, u: number, v: number, y: number): CFrame
	local along = o:Cross(Vector3.yAxis)
	return towerCF * CFrame.fromMatrix(o * u + along * v + Vector3.new(0, y, 0), o, Vector3.yAxis)
end

local REST_BAR_COLOR = Color3.fromRGB(255, 200, 40)

-- A rest bar across face `o` at height y, `halfWidth` either side of centre.
-- It sits just proud of the wall (less than the climber's wall offset), so it
-- never blocks anyone, and isn't queryable so climbing raycasts ignore it.
local function restBar(model: Model, towerCF: CFrame, o: Vector3, faceU: number, y: number, halfWidth: number)
	Build.part(model, {
		Name = "RestBar",
		Size = Vector3.new(0.5, 0.5, halfWidth * 2 * 0.9),
		CFrame = faceCF(towerCF, o, faceU + 0.3, 0, y),
		Color = REST_BAR_COLOR,
		Material = Enum.Material.Metal,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Tags = { "RestBar" },
	})
end

local function zones(model: Model, towerCF: CFrame, baseHalf: number, peakY: number, peakHalf: number)
	Build.part(model, {
		Name = "BaseZone",
		Size = Vector3.new(baseHalf * 2, 12, baseHalf * 2),
		CFrame = towerCF * CFrame.new(0, 6, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	Build.part(model, {
		Name = "PeakZone",
		Size = Vector3.new(peakHalf * 2, 10, peakHalf * 2),
		CFrame = towerCF * CFrame.new(0, peakY + 5, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
end

-- Telecom lattice tower --------------------------------------------------------

local function buildTelecom(model: Model, towerCF: CFrame, def: any): (number, number, { number })
	local S, n = def.SectionHeight, def.Sections
	local H = S * n
	local paint = Color3.fromRGB(def.Color[1], def.Color[2], def.Color[3])
	local restLevels = {}

	local function hw(y: number): number
		return def.BaseHalfWidth + (def.TopHalfWidth - def.BaseHalfWidth) * (y / H)
	end
	local function corner(o: Vector3, side: number, y: number): Vector3
		local along = o:Cross(Vector3.yAxis)
		local h = hw(y)
		return towerCF:PointToWorldSpace(o * h + along * (side * h) + Vector3.new(0, y, 0))
	end

	for k = 0, n - 1 do
		local bottom, top = k * S, (k + 1) * S
		local band = if k % 2 == 0 then paint else WHITE
		local metal = { Color = band, Material = Enum.Material.Metal }

		for f = 0, 3 do
			local o = faceDir(f)
			-- Leg on this face's left corner (four faces -> four legs).
			local leg = Build.beam(model, corner(o, -1, bottom), corner(o, -1, top), 1.4, metal)
			leg.CanCollide = true

			-- X-bracing about every 10 studs, plus a horizontal girt.
			local panels = math.max(1, math.floor(S / 10))
			local panelH = S / panels
			for j = 0, panels - 1 do
				local y0, y1 = bottom + j * panelH, bottom + (j + 1) * panelH
				Build.beam(model, corner(o, -1, y0), corner(o, 1, y1), 0.5, metal)
				Build.beam(model, corner(o, 1, y0), corner(o, -1, y1), 0.5, metal)
				-- Horizontal girt: a clip bar for the climbing rope.
				local girt = Build.beam(model, corner(o, -1, y0), corner(o, 1, y0), 0.5, metal)
				girt.Name = "ClipBar"
				girt:AddTag("ClipBar")
			end

			-- Invisible climb panel lying in the (tapered) lattice face.
			local along = o:Cross(Vector3.yAxis)
			local b = o * hw(bottom) + Vector3.new(0, bottom, 0)
			local t = o * hw(top) + Vector3.new(0, top, 0)
			local slope = t - b
			local normal = slope:Cross(along).Unit
			local width = hw(bottom) + hw(top) -- average full width
			Build.part(model, {
				Name = "ClimbFace",
				Size = Vector3.new(1, slope.Magnitude, width),
				CFrame = towerCF * CFrame.fromMatrix((b + t) / 2 - normal * 0.5, normal, slope.Unit),
				Transparency = 1,
				Tags = { "Climbable" },
			})
		end

		if k < n - 1 then
			-- Rest bars across every face at the top of the section.
			for f = 0, 3 do
				restBar(model, towerCF, faceDir(f), hw(top), top, hw(top))
			end
			table.insert(restLevels, top)
		else
			-- Summit deck, flush with the lattice so you climb straight over onto it.
			local p = hw(top) + 0.5
			Build.part(model, {
				Name = "SummitDeck",
				Size = Vector3.new(p * 2, 1, p * 2),
				CFrame = towerCF * CFrame.new(0, top - 0.5, 0),
				Color = Color3.fromRGB(120, 124, 130),
				Material = Enum.Material.DiamondPlate,
			})
		end

		-- Microwave dishes on a couple of faces per section.
		if k > 0 and k < n - 1 and k % 2 == 1 then
			for _, f in { k % 4, (k + 2) % 4 } do
				local o = faceDir(f)
				local y = bottom + S * 0.45
				Build.part(model, {
					Name = "Dish",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(1, 7, 7),
					CFrame = faceCF(towerCF, o, hw(y) + 2.2, hw(y) * 0.45, y),
					Color = WHITE,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					CanQuery = false,
				})
			end
		end
		-- Aviation lights on the legs every few sections, like the real thing.
		if k % 3 == 2 then
			for _, c in { { 1, 1 }, { -1, -1 } } do
				Build.aviationLight(model, towerCF:PointToWorldSpace(Vector3.new(c[1] * (hw(top) + 0.6), top, c[2] * (hw(top) + 0.6))), 1.2)
			end
		end
	end

	-- Top girt on every face at the summit, so there's a beam to clip into
	-- right to the top (the others sit at the bottom of each bracing panel).
	for f = 0, 3 do
		local o = faceDir(f)
		local girt = Build.beam(model, corner(o, -1, H), corner(o, 1, H), 0.5, { Color = WHITE, Material = Enum.Material.Metal })
		girt.Name = "ClipBar"
		girt:AddTag("ClipBar")
	end

	-- Panel antennas just under the summit.
	for f = 0, 3 do
		local o = faceDir(f)
		local y = H - S * 0.4
		for _, side in { -1, 1 } do
			Build.part(model, {
				Name = "PanelAntenna",
				Size = Vector3.new(0.6, 6, 1.6),
				CFrame = faceCF(towerCF, o, hw(y) + 1, side * hw(y) * 0.6, y),
				Color = WHITE,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				CanQuery = false,
			})
		end
	end

	-- Summit: antenna mast standing on the deck.
	local mastHeight = math.clamp(H * 0.06, 14, 60)
	Build.cylinder(model, towerCF:PointToWorldSpace(Vector3.new(0, H + mastHeight / 2, 0)), mastHeight, 1, {
		Name = "Antenna",
		Color = paint,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	Build.aviationLight(model, towerCF:PointToWorldSpace(Vector3.new(0, H + mastHeight + 0.8, 0)), 2)

	return H, hw(H) + 0.5, restLevels
end

-- Glass skyscraper -----------------------------------------------------------------

local function buildSkyscraper(model: Model, towerCF: CFrame, def: any): (number, number, { number })
	local H, h, every = def.Height, def.HalfWidth, def.BalconyEvery
	local glass = Color3.fromRGB(def.Color[1], def.Color[2], def.Color[3])
	local frame = Color3.fromRGB(def.Frame[1], def.Frame[2], def.Frame[3])
	local rng = Random.new(H + h) -- deterministic window pattern per tower
	local restLevels = {}

	-- Facade, in segments (part size limit) between balconies.
	for y0 = 0, H - every, every do
		local seg = math.min(every, MAX_PART)
		Build.part(model, {
			Name = "Facade",
			Size = Vector3.new(h * 2, seg, h * 2),
			CFrame = towerCF * CFrame.new(0, y0 + seg / 2, 0),
			Color = glass,
			Material = Enum.Material.Glass,
			Reflectance = 0.2,
			Tags = { "Climbable" },
		})

		-- Corner columns and vertical mullions.
		for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
			Build.part(model, {
				Name = "Column",
				Size = Vector3.new(2.4, seg, 2.4),
				CFrame = towerCF * CFrame.new(c[1] * (h - 0.8), y0 + seg / 2, c[2] * (h - 0.8)),
				Color = frame,
				Material = Enum.Material.Concrete,
				CanQuery = false,
			})
		end
		local count = math.floor(h * 2 / 16)
		local spacing = h * 2 / count
		for f = 0, 3 do
			local o = faceDir(f)
			for i = 1, count - 1 do
				Build.part(model, {
					Name = "Mullion",
					Size = Vector3.new(0.5, seg, 0.6),
					CFrame = faceCF(towerCF, o, h + 0.2, -h + i * spacing, y0 + seg / 2),
					Color = frame,
					Material = Enum.Material.Metal,
					CanCollide = false,
					CanQuery = false,
					CanTouch = false,
				})
			end
		end
		-- Floor bands every 25 studs.
		for y = y0 + 25, y0 + seg - 5, 25 do
			Build.part(model, {
				Name = "FloorBand",
				Size = Vector3.new(h * 2 + 0.6, 1, h * 2 + 0.6),
				CFrame = towerCF * CFrame.new(0, y, 0),
				Color = frame,
				Material = Enum.Material.Concrete,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			})
		end
		-- A few windows that light up at night.
		for _ = 1, 6 do
			local f = rng:NextInteger(0, 3)
			local y = y0 + rng:NextInteger(1, math.floor(seg / 25) - 1) * 25 - 12.5
			local v = -h + (rng:NextInteger(1, count) - 0.5) * spacing
			Build.part(model, {
				Name = "NightWindow",
				Size = Vector3.new(0.2, 11, spacing - 1.2),
				CFrame = faceCF(towerCF, faceDir(f), h + 0.05, v, y),
				Color = Color3.fromRGB(255, 214, 120),
				Material = Enum.Material.Neon,
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Tags = { "NightWindow" },
			})
		end

		-- Window-washer rest bars across every face on top of this segment.
		local top = y0 + seg
		if top < H then
			for f = 0, 3 do
				restBar(model, towerCF, faceDir(f), h, top, h - 2)
			end
			table.insert(restLevels, top)
		end
	end

	-- Lobby doors facing the path.
	local front = faceDir(0)
	Build.part(model, {
		Name = "Doors",
		Size = Vector3.new(0.4, 10, 12),
		CFrame = faceCF(towerCF, front, h + 0.25, 0, 5),
		Color = Color3.fromRGB(20, 25, 30),
		Material = Enum.Material.Glass,
		Reflectance = 0.4,
		CanQuery = false,
	})
	Build.part(model, {
		Name = "Canopy",
		Size = Vector3.new(5, 0.6, 18),
		CFrame = faceCF(towerCF, front, h + 2.5, 0, 12),
		Color = frame,
		Material = Enum.Material.Metal,
		CanCollide = false, -- decorative: it would otherwise stop climbers above the doors
		CanQuery = false,
	})

	-- Roof slab and a climbable parapet you climb over onto the roof.
	Build.part(model, {
		Name = "Roof",
		-- Sits just inside the glass so its edge never sticks out past the
		-- climbable wall (a lip there made the wall seem to end early).
		Size = Vector3.new(h * 2 - 0.2, 1, h * 2 - 0.2),
		CFrame = towerCF * CFrame.new(0, H - 0.5, 0),
		Color = Color3.fromRGB(110, 112, 118),
		Material = Enum.Material.Concrete,
	})
	for f = 0, 3 do
		Build.part(model, {
			Name = "Parapet",
			Size = Vector3.new(1, 2, h * 2 + 1),
			CFrame = faceCF(towerCF, faceDir(f), h, 0, H + 1),
			Color = frame,
			Material = Enum.Material.Concrete,
			Tags = { "Climbable", "NoStand" }, -- climb over it, don't stand on it
		})
	end

	-- Rooftop AC units, kept well away from the edges so mantling is never blocked.
	local spots = { { -0.45, -0.45 }, { 0.45, -0.45 }, { -0.45, 0.45 }, { 0.45, 0.45 }, { 0, -0.5 } }
	for i, s in spots do
		if not def.Helipad or i <= 4 then
			local pos = Vector3.new(s[1] * h, H, s[2] * h)
			Build.part(model, {
				Name = "ACUnit",
				Size = Vector3.new(7, 4, 6),
				CFrame = towerCF * CFrame.new(pos + Vector3.new(0, 2, 0)),
				Color = Color3.fromRGB(200, 202, 205),
				Material = Enum.Material.Metal,
			})
			Build.cylinder(model, towerCF:PointToWorldSpace(pos + Vector3.new(0, 4.1, 0)), 0.2, 4.5, {
				Name = "ACFan",
				Color = Color3.fromRGB(60, 62, 66),
				Material = Enum.Material.Metal,
				CanCollide = false,
			})
		end
	end

	if def.Helipad then
		local d = math.min(h * 2 - 30, 30)
		Build.cylinder(model, towerCF:PointToWorldSpace(Vector3.new(0, H + 0.1, 0)), 0.2, d, {
			Name = "Helipad",
			Color = Color3.fromRGB(45, 47, 52),
			Material = Enum.Material.Asphalt,
			CanCollide = false,
		})
		Build.cylinder(model, towerCF:PointToWorldSpace(Vector3.new(0, H + 0.15, 0)), 0.2, d - 3, {
			Name = "HelipadRing",
			Color = Color3.fromRGB(240, 240, 240),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
		Build.cylinder(model, towerCF:PointToWorldSpace(Vector3.new(0, H + 0.2, 0)), 0.2, d - 5, {
			Name = "HelipadInner",
			Color = Color3.fromRGB(45, 47, 52),
			Material = Enum.Material.Asphalt,
			CanCollide = false,
		})
		for _, spec in { { -3, 0, 1.5, 11 }, { 3, 0, 1.5, 11 }, { 0, 0, 4.5, 1.5 } } do
			Build.part(model, {
				Name = "HelipadH",
				Size = Vector3.new(spec[3], 0.1, spec[4]),
				CFrame = towerCF * CFrame.new(spec[1], H + 0.3, spec[2]),
				Color = Color3.fromRGB(240, 240, 240),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			})
		end
	end
	for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
		Build.aviationLight(model, towerCF:PointToWorldSpace(Vector3.new(c[1] * (h - 0.8), H + 2.8, c[2] * (h - 0.8))), 1.4)
	end
	return H, h + 0.5, restLevels
end

-- Public -------------------------------------------------------------------------

-- Builds one tower. `lotHalf` is the half-size of its fenced lot (used for the
-- base zone and for the client to know which tower you're on).
function TowerBuilder.build(parent: Instance, entry: any, def: any, towerCF: CFrame, lotHalf: number): Model
	local model = Instance.new("Model")
	model.Name = entry.Name

	local height, peakHalf, restLevels
	if def.Kind == "Telecom" then
		height, peakHalf, restLevels = buildTelecom(model, towerCF, def)
	else
		height, peakHalf, restLevels = buildSkyscraper(model, towerCF, def)
	end
	zones(model, towerCF, lotHalf - 2, height, peakHalf)

	model:SetAttribute("TowerId", entry.Name)
	model:SetAttribute("DisplayName", entry.Name)
	model:SetAttribute("Difficulty", entry.Difficulty)
	model:SetAttribute("Kind", def.Kind)
	model:SetAttribute("Height", height)
	model:SetAttribute("Payout", def.Payout)
	model:SetAttribute("DrainMultiplier", def.DrainMultiplier)
	model:SetAttribute("Slippery", def.Slippery)
	model:SetAttribute("Radius", lotHalf)
	model:SetAttribute("RestLevels", table.concat(restLevels, ","))
	model.WorldPivot = towerCF
	model.Parent = parent
	return model
end

return TowerBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- Builds the island map from the top-down design (north = -Z):
--
--   SPAWN / PLAZA (gate, planter, signposts, boards)
--   west column: Skyscraper 1 / 2 / 3      east column: Tutorial / Telecom 1 / 2
--   a dirt path down the middle with branches into each fenced tower lot
--   POWER UP SHOP at the south end
--   all on a fenced, tree-covered cliff island in the sea.
--
-- The island's grass top is at y = 0. Idempotent: if Workspace already has the
-- World/Towers folders (baked into the place), they are reused.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)
local TowerBuilder = require(script.Parent.TowerBuilder)

local WorldBuilder = {}

local M = Config.Map
local PLAZA = Vector3.new(M.PlazaCenter[1], 0, M.PlazaCenter[2])
local SHOP = Vector3.new(M.ShopCenter[1], 0, M.ShopCenter[2])
local PATH_TOP = PLAZA.Z + 80
local PATH_BOTTOM = SHOP.Z - 80

local DIRT = Color3.fromRGB(196, 140, 86)
local GRASS = Color3.fromRGB(96, 160, 64)
local WOOD = Color3.fromRGB(120, 78, 45)
local DARK_WOOD = Color3.fromRGB(85, 55, 32)
local IRON = Color3.fromRGB(38, 40, 46)
local DIFFICULTY_COLORS = {
	EASY = Color3.fromRGB(90, 230, 110),
	NORMAL = Color3.fromRGB(255, 205, 60),
	HARD = Color3.fromRGB(255, 70, 60),
}

-- Rectangles (x0, z0, x1, z1) that trees and rocks must stay out of.
local keepClear: { { number } } = {}
local function reserve(x0: number, z0: number, x1: number, z1: number)
	table.insert(keepClear, { math.min(x0, x1), math.min(z0, z1), math.max(x0, x1), math.max(z0, z1) })
end
local function isClear(x: number, z: number, margin: number): boolean
	for _, r in keepClear do
		if x > r[1] - margin and x < r[3] + margin and z > r[2] - margin and z < r[4] + margin then
			return false
		end
	end
	return true
end

local function flat(world: Instance, name: string, x0: number, z0: number, x1: number, z1: number, y: number, color: Color3, material: Enum.Material)
	return Build.part(world, {
		Name = name,
		Size = Vector3.new(math.abs(x1 - x0), 0.4, math.abs(z1 - z0)),
		CFrame = CFrame.new((x0 + x1) / 2, y - 0.2, (z0 + z1) / 2),
		Color = color,
		Material = material,
	})
end

-- Props ----------------------------------------------------------------------------

local function lamp(world: Instance, pos: Vector3)
	Build.part(world, {
		Name = "LampPost",
		Size = Vector3.new(0.6, 11, 0.6),
		CFrame = CFrame.new(pos + Vector3.new(0, 5.5, 0)),
		Color = IRON,
		Material = Enum.Material.Metal,
	})
	local head = Build.part(world, {
		Name = "LampHead",
		Size = Vector3.new(1.6, 2, 1.6),
		CFrame = CFrame.new(pos + Vector3.new(0, 12, 0)),
		Color = Color3.fromRGB(255, 200, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "StreetLight" },
	})
	local light = Instance.new("PointLight")
	light.Range = 26
	light.Brightness = 1.6
	light.Color = Color3.fromRGB(255, 190, 120)
	light.Enabled = false
	light.Parent = head
end

local function tree(world: Instance, rng: Random, pos: Vector3, scale: number)
	local trunkH = 7 * scale
	Build.cylinder(world, pos + Vector3.new(0, trunkH / 2, 0), trunkH, 1.6 * scale, {
		Name = "Trunk",
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
	})
	-- Low-poly canopy: a few rotated green blocks.
	local greens = { Color3.fromRGB(70, 150, 50), Color3.fromRGB(90, 170, 60), Color3.fromRGB(60, 130, 45) }
	for i = 1, 3 do
		local s = (9 - i * 1.5) * scale
		Build.part(world, {
			Name = "Leaves",
			Size = Vector3.new(s, s * 0.9, s),
			CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-1, 1), trunkH + (i - 0.5) * 3 * scale, rng:NextNumber(-1, 1)))
				* CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)),
			Color = greens[rng:NextInteger(1, #greens)],
			Material = Enum.Material.Grass,
			CanQuery = false,
		})
	end
end

local function rock(world: Instance, rng: Random, pos: Vector3, size: number)
	Build.part(world, {
		Name = "Rock",
		Size = Vector3.new(size, size * rng:NextNumber(0.6, 1), size * rng:NextNumber(0.8, 1.2)),
		CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi), rng:NextNumber(-0.4, 0.4)),
		Color = Color3.fromRGB(120, 124, 132):Lerp(Color3.fromRGB(90, 92, 100), rng:NextNumber()),
		Material = Enum.Material.Slate,
	})
end

local function bench(world: Instance, cf: CFrame)
	Build.part(world, { Name = "BenchSeat", Size = Vector3.new(6, 0.5, 2), CFrame = cf * CFrame.new(0, 1.8, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
	Build.part(world, { Name = "BenchBack", Size = Vector3.new(6, 2, 0.4), CFrame = cf * CFrame.new(0, 3, 0.9), Color = WOOD, Material = Enum.Material.WoodPlanks })
	for _, x in { -2.5, 2.5 } do
		Build.part(world, { Name = "BenchLeg", Size = Vector3.new(0.4, 1.8, 1.8), CFrame = cf * CFrame.new(x, 0.9, 0), Color = IRON, Material = Enum.Material.Metal })
	end
end

-- Straight fence between two points. Gaps are left where `gaps` (positions
-- along the fence, in studs from `a`, with half-widths) say so.
local function fence(world: Instance, a: Vector3, b: Vector3, style: string, gaps: { { number } }?)
	local dir = (b - a).Unit
	local length = (b - a).Magnitude
	local wood = style == "wood"
	local color = if wood then WOOD else IRON
	local material = if wood then Enum.Material.Wood else Enum.Material.Metal
	local step = if wood then 10 else 8
	local function inGap(d: number): boolean
		for _, g in (gaps or {}) :: { { number } } do
			if math.abs(d - g[1]) < g[2] then
				return true
			end
		end
		return false
	end
	local segStart: number? = nil
	local function rail(d0: number, d1: number)
		if d1 - d0 < 0.5 then
			return
		end
		local heights: { number } = if wood then { 1.6, 3.2 } else { 1, 3.6 }
		for _, h in heights do
			Build.part(world, {
				Name = "FenceRail",
				Size = Vector3.new(if wood then 0.5 else 0.25, if wood then 0.6 else 0.25, d1 - d0),
				CFrame = CFrame.lookAt(a + dir * ((d0 + d1) / 2), b) * CFrame.new(0, h, 0),
				Color = color,
				Material = material,
			})
		end
		if not wood then
			-- One see-through mesh panel instead of hundreds of thin pickets.
			Build.part(world, {
				Name = "FenceMesh",
				Size = Vector3.new(0.1, 2.6, d1 - d0),
				CFrame = CFrame.lookAt(a + dir * ((d0 + d1) / 2), b) * CFrame.new(0, 2.3, 0),
				Color = color,
				Material = Enum.Material.DiamondPlate,
				Transparency = 0.55,
				CanCollide = false,
				CanQuery = false,
			})
		end
	end
	local d = 0
	while d <= length do
		local gap = inGap(d)
		if not gap then
			Build.part(world, {
				Name = "FencePost",
				Size = Vector3.new(if wood then 1 else 0.5, if wood then 4.2 else 4.6, if wood then 1 else 0.5),
				CFrame = CFrame.new(a + dir * d + Vector3.new(0, if wood then 2.1 else 2.3, 0)),
				Color = color,
				Material = material,
			})
			segStart = segStart or d
		elseif segStart then
			rail(segStart, d - step)
			segStart = nil
		end
		local nextD = d + step
		if not gap and segStart and (nextD > length or inGap(nextD)) then
			rail(segStart, d)
			segStart = nil
		end
		d = nextD
	end
end

local function sign(world: Instance, cf: CFrame, width: number, height: number, lines: { any }, color: Color3?)
	local board = Build.part(world, {
		Name = "Sign",
		Size = Vector3.new(width, height, 0.5),
		CFrame = cf,
		Color = color or Color3.fromRGB(25, 28, 36),
		Material = if color then Enum.Material.WoodPlanks else Enum.Material.SmoothPlastic,
	})
	Build.surfaceText(board, lines)
	return board
end

-- Wooden signpost board at `pos`, readable from the north (spawn side), with a
-- diamond tip pointing the real direction: "west", "east" or "south".
local function arrowBoard(world: Instance, pos: Vector3, text: string, direction: string)
	local cf = CFrame.new(pos) -- Front face (-Z) looks north
	sign(world, cf, 16, 2.6, { { text = text, size = 80, color = Color3.fromRGB(255, 240, 210), font = Enum.Font.GothamBlack } }, WOOD)
	local tip = if direction == "west" then CFrame.new(-8.6, 0, 0) elseif direction == "east" then CFrame.new(8.6, 0, 0) else CFrame.new(0, -1.9, 0)
	Build.part(world, {
		Name = "ArrowTip",
		Size = Vector3.new(1.84, 1.84, 0.5),
		CFrame = cf * tip * CFrame.Angles(0, 0, math.rad(45)),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
	})
end

-- Island --------------------------------------------------------------------------

local function buildIsland(world: Instance, rng: Random)
	local hx, hz = M.IslandHalfX, M.IslandHalfZ
	Build.part(world, {
		Name = "Water",
		Size = Vector3.new(2000, 1, 2000),
		CFrame = CFrame.new(0, M.WaterLevel, 0),
		Color = Color3.fromRGB(40, 140, 210),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Reflectance = 0.2,
		Locked = true,
	})
	Build.part(world, {
		Name = "IslandTop",
		Size = Vector3.new(hx * 2, 10, hz * 2),
		CFrame = CFrame.new(0, -5, 0),
		Color = GRASS,
		Material = Enum.Material.Grass,
		Locked = true,
	})
	local depth = -M.WaterLevel + 10
	Build.part(world, {
		Name = "IslandCliff",
		Size = Vector3.new(hx * 2 - 6, depth, hz * 2 - 6),
		CFrame = CFrame.new(0, -10 - depth / 2, 0),
		Color = Color3.fromRGB(110, 100, 92),
		Material = Enum.Material.Slate,
		Locked = true,
	})
	-- Rocky cliff chunks around the shore.
	for _, side in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		local alongZ = side[1] ~= 0
		local span = if alongZ then hz else hx
		for t = -span, span, 26 do
			local pos = if alongZ
				then Vector3.new(side[1] * (hx + rng:NextNumber(-2, 8)), rng:NextNumber(-60, -6), t + rng:NextNumber(-8, 8))
				else Vector3.new(t + rng:NextNumber(-8, 8), rng:NextNumber(-60, -6), side[2] * (hz + rng:NextNumber(-2, 8)))
			rock(world, rng, pos, rng:NextNumber(22, 40))
		end
	end
	-- Wooden perimeter fence, open at the north gate.
	local inset = 6
	fence(world, Vector3.new(-hx + inset, 0, -hz + inset), Vector3.new(hx - inset, 0, -hz + inset), "wood", { { hx - inset, 12 } })
	fence(world, Vector3.new(hx - inset, 0, -hz + inset), Vector3.new(hx - inset, 0, hz - inset), "wood")
	fence(world, Vector3.new(hx - inset, 0, hz - inset), Vector3.new(-hx + inset, 0, hz - inset), "wood", { { hx - inset, 12 } })
	fence(world, Vector3.new(-hx + inset, 0, hz - inset), Vector3.new(-hx + inset, 0, -hz + inset), "wood")
end

-- Plaza ------------------------------------------------------------------------------

local function buildPlaza(world: Instance)
	local x0, x1, z0, z1 = PLAZA.X - 160, PLAZA.X + 160, PLAZA.Z - 120, PLAZA.Z + 80
	reserve(x0, z0, x1, z1)
	flat(world, "Plaza", x0, z0, x1, z1, 0.4, Color3.fromRGB(214, 196, 160), Enum.Material.Pavement)
	-- Path out of the north gate to the island edge.
	flat(world, "GatePath", -12, -M.IslandHalfZ, 12, z0, 0.35, Color3.fromRGB(190, 175, 150), Enum.Material.Cobblestone)
	reserve(-14, -M.IslandHalfZ, 14, z0)

	-- "SPAWN / PLAZA" wooden arch over the north entrance.
	local gateZ = z0 + 4
	for _, x in { -14, 14 } do
		Build.part(world, { Name = "GatePost", Size = Vector3.new(2.5, 20, 2.5), CFrame = CFrame.new(x, 10, gateZ), Color = DARK_WOOD, Material = Enum.Material.Wood })
	end
	Build.part(world, { Name = "GateBeam", Size = Vector3.new(34, 2, 2.5), CFrame = CFrame.new(0, 20, gateZ), Color = DARK_WOOD, Material = Enum.Material.Wood })
	sign(world, CFrame.new(0, 17, gateZ + 1.5) * CFrame.Angles(0, math.pi, 0), 24, 4.5, {
		{ text = "SPAWN / PLAZA", size = 120, color = Color3.fromRGB(255, 240, 210) },
	}, WOOD)

	-- Central planter with a tree, benches around it.
	local planter = PLAZA + Vector3.new(0, 0, 10)
	Build.cylinder(world, planter + Vector3.new(0, 1, 0), 2, 26, { Name = "Planter", Color = Color3.fromRGB(150, 146, 140), Material = Enum.Material.Cobblestone })
	Build.cylinder(world, planter + Vector3.new(0, 2.05, 0), 0.2, 23, { Name = "PlanterSoil", Color = Color3.fromRGB(90, 140, 60), Material = Enum.Material.Grass })
	tree(world, Random.new(7), planter + Vector3.new(0, 2, 0), 1.2)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local p = planter + Vector3.new(math.cos(a), 0, math.sin(a)) * 19
		bench(world, CFrame.lookAt(p, planter) * CFrame.Angles(0, math.pi, 0))
	end

	-- Signposts: west and east.
	local westPost = PLAZA + Vector3.new(-70, 0, 40)
	Build.part(world, { Name = "SignPole", Size = Vector3.new(1.2, 14, 1.2), CFrame = CFrame.new(westPost + Vector3.new(0, 7, 0)), Color = DARK_WOOD, Material = Enum.Material.Wood })
	arrowBoard(world, westPost + Vector3.new(0, 12.5, -0.9), "SKYSCRAPERS", "west")
	arrowBoard(world, westPost + Vector3.new(0, 8.5, -0.9), "POWER UPS", "south")
	local eastPost = PLAZA + Vector3.new(70, 0, 40)
	Build.part(world, { Name = "SignPole", Size = Vector3.new(1.2, 14, 1.2), CFrame = CFrame.new(eastPost + Vector3.new(0, 7, 0)), Color = DARK_WOOD, Material = Enum.Material.Wood })
	arrowBoard(world, eastPost + Vector3.new(0, 12.5, -0.9), "TELECOM TOWERS", "east")
	arrowBoard(world, eastPost + Vector3.new(0, 8.5, -0.9), "TUTORIAL TOWER", "east")

	-- How-to-play and leaderboard boards along the north side, facing south.
	local face = CFrame.Angles(0, math.pi, 0)
	sign(world, CFrame.new(PLAZA + Vector3.new(-105, 7, -70)) * face, 18, 11, {
		{ text = "HOW TO CLIMB", size = 64, color = Color3.fromRGB(255, 210, 60) },
		{ text = "Walk into a tower to grab on", size = 34, color = Color3.new(1, 1, 1), font = Enum.Font.GothamMedium },
		{ text = "WASD: climb  ·  SPACE: leap up  ·  Q: let go", size = 34, color = Color3.new(1, 1, 1), font = Enum.Font.GothamMedium },
		{ text = "Hang still on a yellow rest bar to breathe.", size = 34, color = Color3.new(1, 1, 1), font = Enum.Font.GothamMedium },
		{ text = "Run out and you BLACK OUT and fall.", size = 34, color = Color3.fromRGB(255, 120, 120), font = Enum.Font.GothamMedium },
		{ text = "SPACE while falling: catch the wall!", size = 34, color = Color3.fromRGB(110, 230, 140), font = Enum.Font.GothamBold },
		{ text = "Rain makes walls slippery · G: emotes", size = 34, color = Color3.fromRGB(150, 190, 255), font = Enum.Font.GothamMedium },
	})
	Build.part(world, {
		Name = "Leaderboard",
		Size = Vector3.new(16, 14, 0.5),
		CFrame = CFrame.new(PLAZA + Vector3.new(105, 8, -70)) * face,
		Color = Color3.fromRGB(20, 22, 30),
		Material = Enum.Material.SmoothPlastic,
	})
	for _, x in { -6, 6 } do
		for _, board in { { -105, 1.2 }, { 105, 1 } } do
			Build.part(world, {
				Name = "BoardLeg",
				Size = Vector3.new(0.6, 2, 0.6),
				CFrame = CFrame.new(PLAZA + Vector3.new(board[1] + x, 1, -69.6)),
				Color = IRON,
				Material = Enum.Material.Metal,
			})
		end
	end

	for _, p in { { -140, -100 }, { 140, -100 }, { -140, 60 }, { 140, 60 }, { -40, -40 }, { 40, -40 } } do
		lamp(world, PLAZA + Vector3.new(p[1], 0.4, p[2]))
	end
end

-- Paths and tower lots ---------------------------------------------------------------

local function towerCFrame(entry: any): CFrame
	local pos = Vector3.new(entry.X, 0, entry.Z)
	-- Face 0 (local -Z) looks at the main path.
	return CFrame.lookAt(pos, Vector3.new(0, 0, entry.Z))
end

local function buildPaths(world: Instance)
	local w = M.PathHalfWidth
	flat(world, "MainPath", -w, PATH_TOP - 4, w, PATH_BOTTOM + 4, 0.3, DIRT, Enum.Material.Ground)
	reserve(-w, PATH_TOP, w, PATH_BOTTOM)
	for z = PATH_TOP + 30, PATH_BOTTOM - 20, 70 do
		lamp(world, Vector3.new(-w - 4, 0, z))
		lamp(world, Vector3.new(w + 4, 0, z + 35))
	end
	for z = PATH_TOP + 120, PATH_BOTTOM - 60, 160 do
		bench(world, CFrame.new(-w - 6, 0, z) * CFrame.Angles(0, -math.pi / 2, 0))
		bench(world, CFrame.new(w + 6, 0, z + 80) * CFrame.Angles(0, math.pi / 2, 0))
	end
	for _, entry in Config.Layout do
		local side = if entry.X < 0 then -1 else 1
		local lotEdge = math.abs(entry.X) - M.LotHalf
		flat(world, "BranchPath", side * w, entry.Z - 9, side * lotEdge, entry.Z + 9, 0.3, DIRT, Enum.Material.Ground)
		reserve(side * w, entry.Z - 10, side * lotEdge, entry.Z + 10)
	end
end

local function buildLot(world: Instance, rng: Random, entry: any, def: any)
	local L = M.LotHalf
	local c = Vector3.new(entry.X, 0, entry.Z)
	reserve(c.X - L, c.Z - L, c.X + L, c.Z + L)
	flat(world, "LotPad", c.X - L, c.Z - L, c.X + L, c.Z + L, 0.2, Color3.fromRGB(150, 140, 128), Enum.Material.Concrete)

	-- Iron fence with a gate facing the path.
	local gateSide = if entry.X < 0 then 1 else -1 -- +1: east edge has the gate
	local corners = {
		Vector3.new(c.X - L, 0, c.Z - L),
		Vector3.new(c.X + L, 0, c.Z - L),
		Vector3.new(c.X + L, 0, c.Z + L),
		Vector3.new(c.X - L, 0, c.Z + L),
	}
	for i = 1, 4 do
		local a, b = corners[i], corners[i % 4 + 1]
		local isGateEdge = (gateSide == 1 and i == 2) or (gateSide == -1 and i == 4)
		fence(world, a, b, "iron", if isGateEdge then { { L, 12 } } else nil)
	end

	-- Utility boxes / equipment shelter.
	local back = -gateSide
	Build.part(world, {
		Name = "Shelter",
		Size = Vector3.new(14, 9, 12),
		CFrame = CFrame.new(c + Vector3.new(back * (L - 12), 4.5, L - 14)),
		Color = Color3.fromRGB(215, 215, 210),
		Material = Enum.Material.Concrete,
	})
	Build.part(world, {
		Name = "UtilityBox",
		Size = Vector3.new(5, 6, 3),
		CFrame = CFrame.new(c + Vector3.new(back * (L - 8), 3, -(L - 10))),
		Color = if entry.Difficulty == "HARD" then Color3.fromRGB(200, 50, 40) else Color3.fromRGB(110, 115, 125),
		Material = Enum.Material.Metal,
	})
	for _, z in { -L + 6, L - 6 } do
		lamp(world, c + Vector3.new(gateSide * (L - 6), 0.2, z))
	end
	rock(world, rng, c + Vector3.new(back * (L - 6), 1, rng:NextNumber(-20, 20)), 5)

	-- Name + difficulty sign by the gate, facing the path.
	local signPos = c + Vector3.new(gateSide * (L + 8), 0, -22)
	local facing = CFrame.lookAt(signPos, Vector3.new(0, 0, signPos.Z))
	for _, x in { -4, 4 } do
		Build.part(world, { Name = "SignLeg", Size = Vector3.new(0.6, 5, 0.6), CFrame = facing * CFrame.new(x, 2.5, 0.3), Color = IRON, Material = Enum.Material.Metal })
	end
	sign(world, facing * CFrame.new(0, 8, 0), 14, 7, {
		{ text = string.upper(entry.Name), size = 70, color = Color3.new(1, 1, 1) },
		{ text = entry.Size .. "  (" .. entry.Difficulty .. ")", size = 56, color = DIFFICULTY_COLORS[entry.Difficulty] or Color3.new(1, 1, 1) },
		{ text = "$" .. def.Payout .. "  ·  drain x" .. def.DrainMultiplier, size = 40, color = Color3.fromRGB(170, 180, 200), font = Enum.Font.GothamBold },
	})
end

-- Shop --------------------------------------------------------------------------------

local function buildShop(world: Instance)
	local s = SHOP
	local x0, x1, z0, z1 = s.X - 110, s.X + 110, s.Z - 70, s.Z + 90
	reserve(x0, z0, x1, z1)
	flat(world, "ShopYard", x0, z0, x1, z1, 0.4, Color3.fromRGB(205, 170, 120), Enum.Material.WoodPlanks)

	-- Fence with string lights, open to the north (path) side.
	fence(world, Vector3.new(x0, 0, z0), Vector3.new(x1, 0, z0), "wood", { { 110, 16 } })
	fence(world, Vector3.new(x1, 0, z0), Vector3.new(x1, 0, z1), "wood")
	fence(world, Vector3.new(x1, 0, z1), Vector3.new(x0, 0, z1), "wood", { { 110, 12 } })
	fence(world, Vector3.new(x0, 0, z1), Vector3.new(x0, 0, z0), "wood")
	for x = x0 + 5, x1 - 5, 7 do
		for _, z in { z0, z1 } do
			Build.part(world, {
				Name = "StringLight",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.7,
				CFrame = CFrame.new(x, 4.6, z),
				Color = Color3.fromRGB(255, 220, 140),
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
				Tags = { "StreetLight" },
			})
		end
	end

	-- The stall, facing north toward the path.
	local stallCF = CFrame.new(s + Vector3.new(0, 0, 25))
	local counter = Build.part(world, {
		Name = "ShopStall",
		Size = Vector3.new(30, 5, 6),
		CFrame = stallCF * CFrame.new(0, 2.5, -6),
		Color = Color3.fromRGB(150, 100, 60),
		Material = Enum.Material.WoodPlanks,
	})
	Build.part(world, { Name = "StallBack", Size = Vector3.new(32, 16, 2), CFrame = stallCF * CFrame.new(0, 8, 6), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.WoodPlanks })
	for _, x in { -15, 15 } do
		Build.part(world, { Name = "StallPost", Size = Vector3.new(1.4, 16, 1.4), CFrame = stallCF * CFrame.new(x, 8, -8), Color = DARK_WOOD, Material = Enum.Material.Wood })
	end
	-- Yellow and white striped awning.
	for i = 0, 7 do
		Build.part(world, {
			Name = "Awning",
			Size = Vector3.new(4.2, 0.5, 15),
			CFrame = stallCF * CFrame.new(-14.7 + i * 4.2, 14, -1) * CFrame.Angles(math.rad(14), 0, 0),
			Color = if i % 2 == 0 then Color3.fromRGB(255, 205, 40) else Color3.fromRGB(250, 250, 245),
			Material = Enum.Material.Fabric,
		})
	end
	sign(world, stallCF * CFrame.new(0, 19, 5.5) * CFrame.Angles(0, math.pi, 0), 26, 6, {
		{ text = "POWER UP SHOP", size = 130, color = Color3.fromRGB(255, 215, 50) },
		{ text = "BUY POWER UPS", size = 70, color = Color3.fromRGB(255, 255, 255), font = Enum.Font.GothamBold },
	}, Color3.fromRGB(90, 55, 30))
	-- Giant lemon on the roof.
	Build.part(world, {
		Name = "Lemon",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 7,
		CFrame = stallCF * CFrame.new(0, 26, 5),
		Color = Color3.fromRGB(255, 220, 40),
		Material = Enum.Material.SmoothPlastic,
	})
	Build.part(world, {
		Name = "LemonLeaf",
		Size = Vector3.new(3.5, 0.4, 1.6),
		CFrame = stallCF * CFrame.new(2.5, 29.5, 5) * CFrame.Angles(0, 0, math.rad(25)),
		Color = Color3.fromRGB(80, 170, 60),
		Material = Enum.Material.SmoothPlastic,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ShopPrompt"
	prompt.ActionText = "Open shop"
	prompt.ObjectText = "Power Up Shop"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter

	-- Picnic tables with yellow umbrellas.
	for _, x in { -60, 60 } do
		local t = s + Vector3.new(x, 0, -20)
		Build.part(world, { Name = "Table", Size = Vector3.new(8, 0.6, 5), CFrame = CFrame.new(t + Vector3.new(0, 3, 0)), Color = WOOD, Material = Enum.Material.WoodPlanks })
		Build.part(world, { Name = "TableLeg", Size = Vector3.new(1, 3, 1), CFrame = CFrame.new(t + Vector3.new(0, 1.5, 0)), Color = DARK_WOOD, Material = Enum.Material.Wood })
		for _, dz in { -4.5, 4.5 } do
			Build.part(world, { Name = "TableBench", Size = Vector3.new(8, 0.5, 1.6), CFrame = CFrame.new(t + Vector3.new(0, 1.8, dz)), Color = WOOD, Material = Enum.Material.WoodPlanks })
		end
		Build.part(world, { Name = "UmbrellaPole", Size = Vector3.new(0.4, 11, 0.4), CFrame = CFrame.new(t + Vector3.new(0, 5.5, 0)), Color = Color3.new(1, 1, 1), Material = Enum.Material.Metal, CanCollide = false })
		Build.cylinder(world, t + Vector3.new(0, 11, 0), 0.8, 14, { Name = "Umbrella", Color = Color3.fromRGB(255, 210, 40), Material = Enum.Material.Fabric, CanCollide = false })
	end
	for _, x in { -100, 100 } do
		for _, z in { z0 + 10, z1 - 10 } do
			lamp(world, Vector3.new(x, 0.4, z))
		end
	end
end

-- Scenery ---------------------------------------------------------------------------

local function scatterTrees(world: Instance, rng: Random)
	local hx, hz = M.IslandHalfX - 14, M.IslandHalfZ - 14
	for x = -hx, hx, 34 do
		for z = -hz, hz, 34 do
			local px, pz = x + rng:NextNumber(-9, 9), z + rng:NextNumber(-9, 9)
			if math.abs(px) < hx and math.abs(pz) < hz and isClear(px, pz, 8) then
				if rng:NextNumber() < 0.75 then
					tree(world, rng, Vector3.new(px, 0, pz), rng:NextNumber(0.9, 1.4))
				elseif rng:NextNumber() < 0.5 then
					rock(world, rng, Vector3.new(px, 1, pz), rng:NextNumber(4, 9))
				end
			end
		end
	end
end

-- Public -------------------------------------------------------------------------------

-- Builds in batches, pausing every few hundred parts, so Studio stays
-- responsive and the server never hits the script time limit (building ~9,000
-- parts in one go froze or "crashed" Studio on slower PCs). The ground and
-- plaza go in first, so players never spawn over nothing.
--
-- Progress is published on Workspace for the loading screen:
--   LoadStage (text), LoadProgress (0-1), WorldReady (true when finished).
function WorldBuilder.build()
	local started = os.clock()
	local world = Workspace:FindFirstChild("World")
	local towers = Workspace:FindFirstChild("Towers")

	-- Each step weighted by roughly how much it builds.
	local steps = {}
	local function step(label: string, weight: number, fn: () -> ())
		table.insert(steps, { label = label, weight = weight, fn = fn })
	end
	if not world then
		world = Instance.new("Folder")
		world.Name = "World"
		world.Parent = Workspace
		local rng = Random.new(2024)
		local w = world :: Folder
		step("Shaping the island", 2, function()
			buildIsland(w, rng)
		end)
		step("Laying out the plaza", 1, function()
			buildPlaza(w)
			Build.setBatching(true) -- ground is in: pause between batches from here
		end)
		step("Paths and tower lots", 3, function()
			buildPaths(w)
			for _, entry in Config.Layout do
				buildLot(w, rng, entry, Config.TowerTypes[entry.Type])
			end
		end)
		step("Opening the Power Up Shop", 1, function()
			buildShop(w)
		end)
		step("Planting trees", 3, function()
			scatterTrees(w, rng)
		end)
	end
	if not towers then
		towers = Instance.new("Folder")
		towers.Name = "Towers"
		towers.Parent = Workspace
		local t = towers :: Folder
		for _, entry in Config.Layout do
			local def = Config.TowerTypes[entry.Type]
			local height = if def.Kind == "Telecom" then def.SectionHeight * def.Sections else def.Height
			step("Building " .. entry.Name, math.max(1, height / 250), function()
				Build.setBatching(true)
				TowerBuilder.build(t, entry, def, towerCFrame(entry), M.LotHalf)
			end)
		end
	end

	local total = 0
	for _, s in steps do
		total += s.weight
	end
	local done = 0
	for _, s in steps do
		Workspace:SetAttribute("LoadStage", s.label)
		Workspace:SetAttribute("LoadProgress", if total > 0 then done / total else 1)
		s.fn()
		done += s.weight
	end
	Build.setBatching(false)
	Workspace:SetAttribute("LoadStage", "World ready")
	Workspace:SetAttribute("LoadProgress", 1)
	Workspace:SetAttribute("WorldReady", true)
	print(string.format("[World] built %d parts in %.1fs", Build.count(), os.clock() - started))
	return world, towers
end

WorldBuilder.PlazaSpawn = CFrame.new(PLAZA + Vector3.new(0, 4, -60))

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="28">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">200</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="29">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">ClimbAnimator</string>
            <string name="Source"><![CDATA[-- Climbing animation: Roblox's standard climb animation, taken from the
-- avatar's own Animate script (every avatar has one, R15 and R6), so it never
-- T-poses and needs no uploads. It's played on your own Animator, so every
-- other player sees it automatically.
--
-- The controller tells us what you're doing each frame:
--   "climb"  moving on the wall   -> plays at a speed matching your climbing
--   "hold"   hanging still        -> frozen mid-reach
--   "leap"   dyno                 -> plays fast
--   "rappel" sliding down a rope  -> plays slowly in reverse
--   ""       not climbing         -> stopped (your normal animations take over)
local Players = game:GetService("Players")

local ClimbAnimator = {}

local player = Players.LocalPlayer
local track: AnimationTrack? = nil
local trackCharacter: Model? = nil

local function loadTrack(): AnimationTrack?
	local character = player.Character
	if not character then
		return nil
	end
	if track and trackCharacter == character then
		return track
	end
	track, trackCharacter = nil, character
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	local animate = character:FindFirstChild("Animate")
	local folder = animate and animate:FindFirstChild("climb")
	local animation = folder and folder:FindFirstChildOfClass("Animation")
	if not animator or not animation then
		return nil
	end
	local ok, loaded = pcall(animator.LoadAnimation, animator, animation)
	if not ok then
		return nil
	end
	loaded.Priority = Enum.AnimationPriority.Action
	loaded.Looped = true
	track = loaded
	return loaded
end

-- `rate` scales the "climb" speed (1 = normal climbing pace).
function ClimbAnimator.set(mode: string, rate: number?)
	if mode == "" then
		if track and track.IsPlaying then
			track:Stop(0.2)
		end
		return
	end
	local t = loadTrack()
	if not t then
		return
	end
	if not t.IsPlaying then
		t:Play(0.15)
	end
	local speed = if mode == "climb"
		then (rate or 1)
		elseif mode == "leap" then 2.5
		elseif mode == "rappel" then -0.8
		else 0 -- hold: freeze mid-reach
	if math.abs(t.Speed - speed) > 0.01 then
		t:AdjustSpeed(speed)
	end
end

return ClimbAnimator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ClimbController</string>
            <string name="Source"><![CDATA[-- Client climbing: rock climbing, stamina, blackouts, ragdoll falls, chalk, wind.
--
-- Rock climbing:
--   * Walk or jump into a tower (anything tagged "Climbable") to grab on. SPACE
--     facing a tower grabs too, and SPACE while falling catches the wall (if
--     you're not falling too fast).
--   * You climb in discrete moves. Each move, one hand reaches for the next hold
--     while your body stays put, then you pull up as the opposite leg pushes.
--     Hands alternate; holding W/S chains moves, A/D traverse sideways.
--     (Touch / gamepad: push toward the wall to climb.)
--   * SPACE while climbing is a dyno: both hands fling up and you catch a hold
--     much higher. Fast, but costs extra stamina.
--   * Q lets go.
--   * Hang still with your hands on a yellow rest bar to recover stamina; that
--     also saves a checkpoint. At the top you climb straight over onto the summit.
--   * F clips your rope in: a carabiner on a telecom tower's beam, or a suction
--     cup on skyscraper glass. The rope is Config.Rope.Length long, so clip in
--     again higher as you go. Clipped, wind can't knock you off, you can rest
--     hanging on the rope, and the rope catches you if you fall. X unclips.
--   * V rappels you down to the ground (needs the Rappel Kit power-up).
--
-- The body is held on the wall with AlignPosition/AlignOrientation on the
-- HumanoidRootPart (the client owns its character's physics, so this
-- replicates). Limbs stop colliding while you climb so they can't snag the wall.
-- ClimbAnimator plays Roblox's standard climb animation to match.
--
-- Stamina runs on the client because only the owning client knows its exact
-- climbing state every frame. That is safe: stamina only limits the player
-- themselves. Everything that has value (cash, climbs, purchases, fall damage)
-- is decided on the server.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local ClimbAnimator = require(script.Parent.ClimbAnimator)
local Effects = require(script.Parent.Effects)
local Weather = require(script.Parent.Weather)
local WallClimb = require(script.Parent.WallClimb)

local ClimbController = {}

type Mode = "normal" | "fall" | "blackout" | "ragdoll"

local CC = Config.Climb
local HAND_HEIGHT = WallClimb.HAND_HEIGHT

local player = Players.LocalPlayer
local ragdollRemote = Remotes.get("Ragdoll")
local restRemote = Remotes.get("RestCheckpoint")
local ropeRemote = Remotes.get("Rope")
local rng = Random.new()

local humanoid: Humanoid? = nil
local root: BasePart? = nil
local stamina = Config.Stamina.Base
local mode: Mode = "normal"
local ragdollTime, settleTime = 0, 0
local airPeakY: number? = nil
local freefallTime = 0
local cooldownUntil = 0
local gustUntil = 0
local gustDir = Vector3.zero
local lastGrounded = true
local lastJumpRequest = 0

-- Climb state
local climbing = false
local anchor = Vector3.zero -- where the root is held
local wallNormal = Vector3.zAxis -- horizontal, pointing out of the wall
type Move = WallClimb.Move
local move: Move? = nil
local moveCount = 0 -- drives which hand leads (and the animation cycle)
local lungeReadyAt = 0
local climbMoving = false
local savedCollisions: { [BasePart]: boolean } = {}
local ropeTaut = false -- last move was blocked by the rope's length
local nextClipScan, clipInReach = 0, false
local groundedSince = 0
-- Rappel (Rappel Kit power-up)
local rappelling = false
local rappelVisual: Instance? = nil
local resting = false
local restLevel: number? = nil
local checkpointLevel: number? = nil
local regrabAt = 0
local autoGripUntil = 0
local alignPos: AlignPosition? = nil
local alignOri: AlignOrientation? = nil
local climbAttachment: Attachment? = nil

local ui: any = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local world: WallClimb.World = {
	cast = function(origin, direction)
		return Workspace:Raycast(origin, direction, rayParams)
	end,
	climbable = function(instance)
		return instance:HasTag("Climbable")
	end,
	solid = function(instance)
		return instance.CanCollide
	end,
	noStand = function(instance)
		return instance:HasTag("NoStand")
	end,
}

local function boosts(): Rules.Boosts
	local b = {}
	for _, def in Config.Boosts do
		b[def.Id] = player:GetAttribute("Boost_" .. def.Id) or 0
	end
	for _, pass in Config.GamePasses do
		if player:GetAttribute("Pass_" .. pass.Id) == true then
			b["Pass_" .. pass.Id] = 1
		end
	end
	return b
end

local function currentTower(pos: Vector3): Model?
	local towers = Workspace:FindFirstChild("Towers")
	if not towers then
		return nil
	end
	for _, tower in towers:GetChildren() do
		local radius = tower:GetAttribute("Radius")
		if radius and tower:IsA("Model") then
			local p = tower.WorldPivot.Position
			if math.abs(pos.X - p.X) <= radius and math.abs(pos.Z - p.Z) <= radius then
				return tower
			end
		end
	end
	return nil
end

-- The rest bar your hands are on (its height), if any.
local function restBarAt(tower: Model?, handY: number): number?
	if not tower then
		return nil
	end
	local levels = tostring((tower :: Model):GetAttribute("RestLevels") or "")
	for value in string.gmatch(levels, "[^,]+") do
		local y = tonumber(value)
		if y and math.abs(handY - y) <= CC.RestBarReach then
			return y
		end
	end
	return nil
end

local function chalkRemaining(): number
	return math.max(0, (player:GetAttribute("ChalkUntil") or 0) - Workspace:GetServerTimeNow())
end

local horizontal = WallClimb.horizontal

local function drainContext(tower: Model?, moving: boolean, now: number, y: number): Rules.DrainContext
	return {
		climbing = climbing,
		moving = moving,
		towerMultiplier = if tower then tower:GetAttribute("DrainMultiplier") or 1 else 1,
		slippery = if tower then tower:GetAttribute("Slippery") == true else false,
		chalk = chalkRemaining() > 0,
		gust = now < gustUntil and y > Config.Wind.MinHeight,
		weatherMultiplier = Weather.drainMultiplier(),
		resting = resting,
		roped = rappelling or player:GetAttribute("RopeAnchor") ~= nil,
	}
end

local function probeWall(origin: Vector3, normal: Vector3): WallClimb.Hit?
	return WallClimb.probe(world, CC, origin, normal)
end

local function findMantle(): Vector3?
	return WallClimb.findMantle(world, CC, anchor, wallNormal)
end

local function release(push: boolean)
	if not climbing then
		return
	end
	climbing = false
	climbMoving = false
	resting = false
	restLevel = nil
	move = nil
	regrabAt = os.clock() + CC.RegrabDelay
	for part, canCollide in savedCollisions do
		if part.Parent then
			part.CanCollide = canCollide
		end
	end
	savedCollisions = {}
	if alignPos then
		alignPos:Destroy()
		alignPos = nil
	end
	if alignOri then
		alignOri:Destroy()
		alignOri = nil
	end
	if climbAttachment then
		climbAttachment:Destroy()
		climbAttachment = nil
	end
	ClimbAnimator.set("")
	rappelling = false
	if rappelVisual then
		rappelVisual:Destroy()
		rappelVisual = nil
	end
	local hum, rootPart = humanoid, root
	if hum then
		hum.PlatformStand = false
	end
	if rootPart then
		airPeakY = rootPart.Position.Y
		if push then
			rootPart.AssemblyLinearVelocity = wallNormal * 10
		end
	end
	cooldownUntil = os.clock() + 0.3
end

local attachToWall: (Vector3, Vector3) -> boolean

-- Grab the climbable wall along `dir` within `range`, if any.
local function grab(dir: Vector3, range: number, quiet: boolean?): boolean
	local hum, rootPart = humanoid, root
	if climbing or mode ~= "normal" or not hum or not rootPart or hum.Health <= 0 then
		return false
	end
	if rootPart.AssemblyLinearVelocity.Y < -CC.CatchMaxFallSpeed then
		if not quiet then
			ui.overlay:toast("Falling too fast to grab!", "bad")
		end
		return false
	end
	local hold, normal = WallClimb.grab(world, CC, rootPart.Position, dir, range)
	if not hold or not normal then
		return false
	end
	return attachToWall(hold, normal)
end

-- Hold the body on the wall at `hold`, facing it.
function attachToWall(hold: Vector3, normal: Vector3): boolean
	local hum, rootPart = humanoid, root
	if climbing or not hum or not rootPart then
		return false
	end
	wallNormal = normal
	anchor = hold

	local att = Instance.new("Attachment")
	att.Name = "ClimbAttachment"
	att.Parent = rootPart
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.MaxForce = 200000
	ap.Responsiveness = 60
	ap.Position = anchor
	ap.Parent = rootPart
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 200000
	ao.Responsiveness = 50
	ao.CFrame = CFrame.lookAt(anchor, anchor - wallNormal)
	ao.Parent = rootPart
	climbAttachment, alignPos, alignOri = att, ap, ao

	hum.PlatformStand = true
	rootPart.AssemblyLinearVelocity = Vector3.zero
	-- Limbs reach toward the wall; stop them colliding so they can't snag it.
	local character = rootPart.Parent
	if character then
		for _, part in character:GetDescendants() do
			if part:IsA("BasePart") and part ~= rootPart then
				savedCollisions[part] = part.CanCollide
				part.CanCollide = false
			end
		end
	end
	climbing = true
	move = nil
	autoGripUntil = 0
	airPeakY, freefallTime = nil, 0
	Effects.sound(Config.Sounds.Grab, 0.5, 1.3)
	return true
end

local function mantle(stand: Vector3)
	local rootPart = root
	release(false)
	if player:GetAttribute("RopeAnchor") ~= nil then
		ropeRemote:FireServer("unclip")
	end
	if rootPart then
		rootPart.CFrame = CFrame.lookAt(stand, stand - wallNormal)
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end
	local hum = humanoid
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Landed)
	end
	Effects.sound(Config.Sounds.Click, 0.35, 1.2)
end

local function enterRagdoll(kind: Mode, startY: number?)
	release(false)
	local hum, rootPart = humanoid, root
	if mode ~= "normal" or not hum or not rootPart or hum.Health <= 0 then
		return
	end
	mode = kind
	ragdollTime, settleTime = 0, 0
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	ragdollRemote:FireServer(true, startY or rootPart.Position.Y)
	-- A little tumble so it reads as a limp body, not a statue.
	rootPart:ApplyAngularImpulse(
		Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-1, 1)) * rootPart.AssemblyMass * 6
	)
	if kind == "blackout" then
		ui.overlay:blackout(true)
		Effects.sound(Config.Sounds.Bonk, 0.8)
	elseif kind == "fall" then
		Effects.sound(Config.Sounds.Fall, 0.7)
	end
end

local function exitRagdoll()
	if mode == "normal" then
		return
	end
	local wasBlackout = mode == "blackout"
	mode = "normal"
	cooldownUntil = os.clock() + 0.8
	airPeakY, freefallTime = nil, 0
	ragdollRemote:FireServer(false)
	local hum = humanoid
	if hum and hum.Health > 0 then
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		Effects.sound(Config.Sounds.GetUp, 0.6)
	end
	if player:GetAttribute("RopeAnchor") ~= nil then
		-- The rope caught you: grab the wall again straight away.
		ClimbController.regrip()
	end
	if wasBlackout then
		local max = Rules.maxStamina(Config.Stamina, Config.Boosts, boosts(), Config.GamePasses)
		stamina = math.max(stamina, max * Config.Stamina.WakeFraction)
		ui.overlay:blackout(false)
	end
end

function ClimbController.toggleRagdoll()
	if mode == "ragdoll" and ragdollTime > 0.4 then
		exitRagdoll()
	elseif mode == "normal" and root then
		enterRagdoll("ragdoll", (root :: BasePart).Position.Y)
	end
end

function ClimbController.letGo()
	release(true)
end

function ClimbController.isClimbing(): boolean
	return climbing
end

-- The best rope clip point within reach of your hands, and what it is.
local function findClipPoint(): (Vector3?, string?)
	local rootPart = root
	if not rootPart then
		return nil, nil
	end
	local tower = currentTower(rootPart.Position)
	if not tower then
		return nil, nil
	end
	local hands = if climbing then anchor + Vector3.new(0, HAND_HEIGHT, 0) else rootPart.Position + Vector3.new(0, 1.5, 0)
	if tower:GetAttribute("Kind") == "Telecom" then
		-- Carabiner onto the nearest horizontal beam.
		local best, bestDist = nil, Config.Rope.Reach
		for _, bar in CollectionService:GetTagged("ClipBar") do
			if bar:IsA("BasePart") and bar:IsDescendantOf(tower) then
				local cf = bar.CFrame
				local half = bar.Size.Z / 2
				local d = math.clamp((hands - cf.Position):Dot(cf.LookVector), -half, half)
				local point = cf.Position + cf.LookVector * d
				local dist = (point - hands).Magnitude
				if dist < bestDist then
					best, bestDist = point, dist
				end
			end
		end
		return best, if best then "carabiner" else nil
	end
	-- Suction cup straight onto the glass in front of your hands.
	if not climbing then
		return nil, nil
	end
	local hit = probeWall(hands, wallNormal)
	if hit then
		return hit.Position + hit.Normal * 0.3, "suction"
	end
	return nil, nil
end

function ClimbController.clip()
	if not climbing then
		ui.overlay:toast("Grab onto a tower first, then clip in (F).", "bad")
		return
	end
	local point, kind = findClipPoint()
	if not point then
		ui.overlay:toast("Nothing to clip into here - climb closer to a beam.", "bad")
		return
	end
	ropeRemote:FireServer("clip", point)
	ropeTaut = false
	Effects.sound(Config.Sounds.Grab, 0.6, if kind == "suction" then 0.7 else 1.6)
end

function ClimbController.unclip()
	if player:GetAttribute("RopeAnchor") ~= nil then
		ropeRemote:FireServer("unclip")
	end
end

-- Rappel Kit: slide down the wall to the ground. Works while on a wall, or
-- standing on a summit (you go over the nearest edge).
function ClimbController.rappel()
	local rootPart = root
	if not rootPart or mode ~= "normal" then
		return
	end
	if (player:GetAttribute("Boost_Rappel") or 0) < 1 then
		ui.overlay:toast("You need the Rappel Kit (Power Up Shop) to rappel.", "bad")
		return
	end
	if rappelling then
		rappelling = false -- stop and hang where you are
		if rappelVisual then
			rappelVisual:Destroy()
			rappelVisual = nil
		end
		return
	end
	if not climbing then
		-- On a summit: go over the edge nearest to you.
		local tower = currentTower(rootPart.Position)
		local height = tower and tower:GetAttribute("Height")
		if not tower or not height or rootPart.Position.Y < height then
			ui.overlay:toast("Rappel from a tower wall or a summit.", "bad")
			return
		end
		local pivot = tower.WorldPivot
		local rel = pivot:PointToObjectSpace(rootPart.Position)
		local axis = if math.abs(rel.X) > math.abs(rel.Z)
			then Vector3.new(math.sign(rel.X), 0, 0)
			else Vector3.new(0, 0, if rel.Z == 0 then 1 else math.sign(rel.Z))
		local out = pivot:VectorToWorldSpace(axis)
		local radius = tower:GetAttribute("Radius") or 60
		local origin = Vector3.new(pivot.X, height - 4, pivot.Z) + out * radius
		local hold, normal = WallClimb.grab(world, CC, origin, -out, radius + 5)
		if not hold or not normal then
			return
		end
		rootPart.CFrame = CFrame.lookAt(hold, hold - normal)
		if not attachToWall(hold, normal) then
			return
		end
	end
	ClimbController.unclip()
	rappelling = true
	move = nil
	-- A rope from where you started down to your harness (just for show).
	local top = Instance.new("Part")
	top.Anchored = true
	top.CanCollide = false
	top.CanQuery = false
	top.CanTouch = false
	top.Transparency = 1
	top.Size = Vector3.one * 0.2
	top.CFrame = CFrame.new(anchor + Vector3.new(0, 4, 0) - wallNormal * 1)
	local a0 = Instance.new("Attachment")
	a0.Parent = top
	local a1 = Instance.new("Attachment")
	a1.Parent = rootPart
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0, beam.Width1 = 0.15, 0.15
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 120, 40))
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Parent = top
	top.Parent = Workspace
	a1.AncestryChanged:Connect(function()
		if not a1.Parent and top.Parent then
			top:Destroy()
		end
	end)
	top.Destroying:Connect(function()
		a1:Destroy()
	end)
	rappelVisual = top
	Effects.sound(Config.Sounds.Grab, 0.6, 0.6)
end

-- After respawning at a checkpoint: grab the wall in front without any input.
function ClimbController.regrip()
	autoGripUntil = os.clock() + 2
	regrabAt = 0
end

-- SPACE / jump button: grab when free, leap when climbing.
local function startLeap(now: number): boolean
	local rootPart = root
	if not rootPart or move ~= nil or now < lungeReadyAt then
		return false
	end
	local tower = currentTower(rootPart.Position)
	local rate = Rules.staminaRate(
		Config.Stamina,
		Config.Chalk,
		Config.Wind,
		Config.Boosts,
		boosts(),
		drainContext(tower, true, now, rootPart.Position.Y),
		false
	)
	local cost = Rules.lungeCost(CC, rate)
	if stamina <= cost then
		ui.overlay:toast("Too tired to leap!", "bad")
		return false
	end
	local leap = WallClimb.planLeap(world, CC, anchor, wallNormal)
	if not leap then
		return false
	end
	local ropeAnchor = player:GetAttribute("RopeAnchor")
	if typeof(ropeAnchor) == "Vector3" and (leap.to - ropeAnchor).Magnitude > Config.Rope.Length - 0.5 then
		ui.overlay:toast("Your rope won't reach - clip in higher first (F)", "bad")
		return false
	end
	stamina -= cost
	lungeReadyAt = now + CC.LungeCooldown
	move = leap
	Effects.sound(Config.Sounds.Click, 0.4, 0.7)
	return true
end

-- SPACE / jump button: grab when free, dyno when climbing.
local function onJump()
	local now = os.clock()
	if now - lastJumpRequest < 0.2 then
		return
	end
	lastJumpRequest = now
	local rootPart = root
	if climbing and rootPart then
		startLeap(now)
	elseif mode == "normal" and rootPart then
		grab(horizontal(rootPart.CFrame.LookVector), CC.GripRange + 1)
	end
end

local function onGust(phase_: string, dir: Vector3, duration: number)
	if typeof(dir) ~= "Vector3" or typeof(duration) ~= "number" then
		return
	end
	if phase_ == "warn" then
		ui.hud:setWind("WIND GUST INCOMING - HOLD ON!")
		task.delay(duration, function()
			if os.clock() >= gustUntil then
				ui.hud:setWind(nil)
			end
		end)
	elseif phase_ == "start" then
		gustUntil = os.clock() + duration
		gustDir = dir
		ui.hud:setWind("GUST! Stamina drains faster")
		task.delay(duration, function()
			if os.clock() >= gustUntil then
				ui.hud:setWind(nil)
			end
		end)
		local hum, rootPart = humanoid, root
		if not rootPart or not hum or mode ~= "normal" or rootPart.Position.Y < Config.Wind.MinHeight then
			return
		end
		Effects.shake(duration * 0.5, 0.2)
		local max = Rules.maxStamina(Config.Stamina, Config.Boosts, boosts(), Config.GamePasses)
		local roped = player:GetAttribute("RopeAnchor") ~= nil
		if roped and climbing then
			ui.overlay:toast("Your rope held you against the wind.", "good")
		elseif climbing and not resting and stamina < max * Config.Wind.KnockOffFraction then
			-- Too tired to hold on: the wind rips you off the wall.
			local y = rootPart.Position.Y
			enterRagdoll("fall", y)
			rootPart:ApplyImpulse((gustDir + Vector3.new(0, 0.3, 0)) * rootPart.AssemblyMass * Config.Wind.AirPush)
			ui.overlay:toast("The wind blew you off!", "bad")
		elseif not climbing and hum.FloorMaterial == Enum.Material.Air then
			rootPart:ApplyImpulse(gustDir * rootPart.AssemblyMass * Config.Wind.AirPush)
		end
	end
end

-- Input -> (vertical, lateral) along the wall, each in [-1, 1].
local function climbInput(hum: Humanoid): (number, number)
	local W = UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up)
	local S = UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)
	local A = UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left)
	local D = UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right)
	if W or S or A or D then
		return (if W then 1 else 0) - (if S then 1 else 0), (if D then 1 else 0) - (if A then 1 else 0)
	end
	-- Touch / gamepad: push toward the wall to climb.
	local move = hum.MoveDirection
	local right = (-wallNormal):Cross(Vector3.yAxis)
	return math.clamp(move:Dot(-wallNormal), -1, 1), math.clamp(move:Dot(right), -1, 1)
end

local function setHold(position: Vector3)
	anchor = position
	local ap, ao = alignPos, alignOri
	if ap and ao then
		ap.Position = anchor
		ao.CFrame = CFrame.lookAt(anchor, anchor - wallNormal)
	end
end

-- Advance the current move (or start the next one). Returns true if the
-- climber left the wall this frame (mantled onto a ledge or stepped off).
local function stepClimb(hum: Humanoid, dt: number, b: Rules.Boosts, tower: Model?): boolean
	if rappelling then
		-- Slide down the wall on the rope until the ground.
		local floor = Workspace:Raycast(anchor, Vector3.new(0, -(WallClimb.ROOT_HEIGHT + 1), 0), rayParams)
		if floor and floor.Normal.Y > 0.7 then
			release(false)
			ui.overlay:toast("Touched down. Nice rappel!", "good")
			return true
		end
		local probe = probeWall(anchor, wallNormal)
		local n = if probe then probe.Normal else wallNormal
		local target = anchor - WallClimb.wallUp(n) * (Config.Rope.RappelSpeed * dt)
		local hit = probeWall(target, wallNormal)
		if not hit then
			release(true) -- ran out of wall: drop the last bit
			return true
		end
		setHold(hit.Position + hit.Normal * CC.WallOffset)
		climbMoving = false
		resting = false
		ClimbAnimator.set("rappel")
		return false
	end

	local vert, lat = climbInput(hum)
	local speed = Rules.climbSpeed(CC, Config.Boosts, b)

	if not move and (vert ~= 0 or lat ~= 0) then
		local planned, action = WallClimb.plan(world, CC, anchor, wallNormal, vert, lat, speed)
		if action == "mantle" then
			local stand = findMantle()
			if stand then
				mantle(stand)
				return true
			end
		elseif action == "stepoff" then
			release(false)
			return true
		end
		-- The rope only reaches so far above your clip: clip in again higher.
		local ropeAnchor = player:GetAttribute("RopeAnchor")
		ropeTaut = planned ~= nil
			and typeof(ropeAnchor) == "Vector3"
			and (planned.to - ropeAnchor).Magnitude > Config.Rope.Length - 0.5
		if planned and not ropeTaut then
			move = planned
			if planned.kind ~= "side" then
				moveCount += 1 -- the other hand leads this time
			end
		end
	end

	local current = move
	if current then
		current.t += dt
		local f = math.clamp(current.t / current.duration, 0, 1)
		if current.kind == "side" then
			setHold(current.from:Lerp(current.to, f * f * (3 - 2 * f)))
		elseif current.kind == "leap" then
			-- Explosive launch, then hang on the catch.
			local launch = math.clamp(current.t / (current.duration - 0.15), 0, 1)
			setHold(current.from:Lerp(current.to, 1 - (1 - launch) ^ 3))
		else
			-- Reach first (body still), then pull up.
			local pull = math.clamp((f - CC.ReachFraction) / (1 - CC.ReachFraction), 0, 1)
			setHold(current.from:Lerp(current.to, pull * pull * (3 - 2 * pull)))
		end
		local probe = probeWall(anchor, wallNormal)
		if probe then
			wallNormal = horizontal(probe.Normal)
		end
		if f >= 1 then
			move = nil
			if current.mantleAfter then
				local stand = findMantle()
				if stand then
					mantle(stand)
					return true
				end
			end
		end
	end
	climbMoving = move ~= nil

	-- Rest bars: stop with your hands on one to hang there and breathe.
	restLevel = restBarAt(tower, anchor.Y + HAND_HEIGHT)
	resting = restLevel ~= nil and not climbMoving
	if resting and restLevel then
		local targetY = restLevel - HAND_HEIGHT
		setHold(Vector3.new(anchor.X, anchor.Y + (targetY - anchor.Y) * math.min(1, dt * 6), anchor.Z))
		if checkpointLevel ~= restLevel then
			checkpointLevel = restLevel
			restRemote:FireServer(wallNormal)
		end
	end

	local m = move
	if m and m.kind == "leap" then
		ClimbAnimator.set("leap")
	elseif m then
		ClimbAnimator.set("climb", speed / CC.ClimbSpeed)
	else
		ClimbAnimator.set("hold")
	end
	return false
end

local function statusFor(grounded: boolean, frac: number, nearWall: boolean): (string, Color3?)
	if mode == "blackout" then
		return "Blacked out...", Color3.fromRGB(255, 86, 86)
	elseif mode == "fall" then
		return "Falling! (SPACE to catch the wall)", Color3.fromRGB(255, 86, 86)
	elseif mode == "ragdoll" then
		return "Ragdolling (press R to get up)", Color3.fromRGB(255, 196, 46)
	elseif rappelling then
		return "Rappelling down...  (V: stop, Q: let go)", Color3.fromRGB(110, 200, 255)
	elseif climbing and ropeTaut then
		return "Rope's at full length - clip in higher (F)", Color3.fromRGB(255, 200, 60)
	elseif climbing and resting then
		return "Resting on a rest bar...", Color3.fromRGB(88, 224, 132)
	elseif climbing and frac < Config.Stamina.DangerFraction then
		return "Out of breath! Get to a rest bar!", Color3.fromRGB(255, 86, 86)
	elseif climbing and climbMoving then
		return "Climbing...  (SPACE: dyno, Q: let go)", nil
	elseif climbing and player:GetAttribute("RopeAnchor") ~= nil then
		return "Hanging on your rope (resting)", Color3.fromRGB(88, 224, 132)
	elseif climbing and restLevel == nil then
		return "Holding on (still draining)  (F: clip rope)", Color3.fromRGB(255, 200, 60)
	elseif nearWall then
		return "Walk into the tower to climb", Color3.fromRGB(255, 196, 46)
	elseif grounded and frac < 0.999 then
		return "Catching your breath...", Color3.fromRGB(88, 224, 132)
	end
	return "Ready to climb", nil
end

local function step(dt: number)
	local hum, rootPart = humanoid, root
	if not hum or not rootPart or not hum.Parent then
		return
	end
	local b = boosts()
	local max = Rules.maxStamina(Config.Stamina, Config.Boosts, b, Config.GamePasses)
	stamina = math.min(stamina, max)
	local now = os.clock()

	if hum.Health <= 0 then
		release(false)
		if mode ~= "normal" then
			mode = "normal"
			ui.overlay:blackout(false)
		end
		return
	end

	local grounded = false
	local nearWall = false
	if mode ~= "normal" then
		ragdollTime += dt
		-- The Humanoid will try to stand up on its own; keep it limp.
		if hum:GetState() ~= Enum.HumanoidStateType.Physics then
			hum:ChangeState(Enum.HumanoidStateType.Physics)
		end
		local speed = rootPart.AssemblyLinearVelocity.Magnitude
		settleTime = if speed < Config.Fall.SettleSpeed then settleTime + dt else 0
		local minTime = if mode == "blackout" then Config.Fall.MinBlackoutTime else Config.Fall.MinRagdollTime
		local settled = settleTime >= Config.Fall.SettleTime
		if ragdollTime >= Config.Fall.MaxRagdollTime or (mode ~= "ragdoll" and ragdollTime >= minTime and settled) then
			exitRagdoll()
		end
	else
		local tower = currentTower(rootPart.Position)
		if climbing then
			if stepClimb(hum, dt, b, tower) then
				return -- climbed over the top this frame
			end
		elseif tower and now >= regrabAt then
			-- Auto-grip: walking or jumping into a tower grabs it.
			local move = hum.MoveDirection
			if now < autoGripUntil then
				-- Respawned / caught by the rope: the wall we were on first.
				if not grab(-wallNormal, CC.GripRange + 2, true) then
					grab(horizontal(rootPart.CFrame.LookVector), CC.GripRange, true)
				end
			elseif move.Magnitude > 0.5 then
				grab(horizontal(move), CC.AutoGripRange, true)
			end
		end
		local pos = rootPart.Position
		local state = hum:GetState()
		grounded = not climbing and hum.FloorMaterial ~= Enum.Material.Air

		-- Track how far we've fallen so a big drop turns into a ragdoll.
		if climbing or grounded then
			airPeakY, freefallTime = nil, 0
		else
			airPeakY = math.max(airPeakY or pos.Y, pos.Y)
			if state == Enum.HumanoidStateType.Freefall then
				freefallTime += dt
			end
		end
		if
			not climbing
			and freefallTime >= Config.Fall.AutoRagdollAfter
			and rootPart.AssemblyLinearVelocity.Y < -25
			and now > cooldownUntil
		then
			enterRagdoll("fall", airPeakY)
		end

		local ctx = drainContext(tower, climbMoving, now, pos.Y)
		local rate = Rules.staminaRate(Config.Stamina, Config.Chalk, Config.Wind, Config.Boosts, b, ctx, grounded)
		stamina = Rules.stepStamina(stamina, rate, dt, max)

		if climbing and stamina <= 0 then
			enterRagdoll("blackout", pos.Y)
		end
		-- Back on the ground: take the rope off.
		if grounded and pos.Y < 8 then
			if groundedSince == 0 then
				groundedSince = now
			elseif now - groundedSince > 0.5 and player:GetAttribute("RopeAnchor") ~= nil then
				ropeRemote:FireServer("unclip")
				groundedSince = now + 5
			end
		else
			groundedSince = 0
		end
		if grounded and not lastGrounded and stamina < max then
			Effects.sound(Config.Sounds.Click, 0.25, 0.8)
		end
		lastGrounded = grounded

		if not climbing and tower then
			local look = horizontal(rootPart.CFrame.LookVector)
			local hit = Workspace:Raycast(pos, look * (CC.GripRange + 1), rayParams)
			nearWall = hit ~= nil and hit.Instance:HasTag("Climbable")
		end
	end

	-- HUD -----------------------------------------------------------------------
	local pos = rootPart.Position
	local frac = stamina / max
	ui.hud:setStamina(stamina, max, Config.Stamina.DangerFraction, now)
	local text, color = statusFor(grounded, frac, nearWall)
	ui.hud:setStatus(text, color)
	ui.hud:setChalk(player:GetAttribute("Chalk") or 0, math.clamp(chalkRemaining() / Config.Chalk.Duration, 0, 1))
	ui.hud:setClimbing(climbing)
	if now >= nextClipScan then
		nextClipScan = now + 0.25
		clipInReach = climbing and player:GetAttribute("RopeAnchor") == nil and findClipPoint() ~= nil
	end
	ui.hud:setRope(player:GetAttribute("RopeKind"), clipInReach)

	local tower = currentTower(pos)
	if tower then
		local height = tower:GetAttribute("Height") or 1
		ui.hud:setAltitude(
			pos.Y,
			tower:GetAttribute("DisplayName"),
			string.format("%s  ·  $%s  ·  drain x%s", tostring(tower:GetAttribute("Difficulty")), tostring(tower:GetAttribute("Payout")), tostring(tower:GetAttribute("DrainMultiplier"))),
			pos.Y / height
		)
	else
		ui.hud:setAltitude(pos.Y, nil, nil, nil)
	end

	local breathless = if mode == "blackout" then 1 else math.clamp(1 - frac / 0.35, 0, 1)
	Effects.setBreathless(if climbing or mode == "blackout" then breathless else breathless * 0.4)
end

local function onCharacter(char: Model)
	release(false)
	humanoid, root = nil, nil -- stop stepping the old body while the new one loads
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	local rootPart = char:WaitForChild("HumanoidRootPart") :: BasePart
	humanoid, root = hum, rootPart
	rayParams.FilterDescendantsInstances = { char }
	mode = "normal"
	ragdollTime, settleTime, freefallTime = 0, 0, 0
	airPeakY = nil
	checkpointLevel = nil
	cooldownUntil = os.clock() + 1.5 -- respawning at a checkpoint can start mid-air
	stamina = Rules.maxStamina(Config.Stamina, Config.Boosts, boosts(), Config.GamePasses)
	ui.overlay:blackout(false)
	Effects.setBreathless(0)
	hum.Died:Connect(function()
		if humanoid == hum then
			release(false)
			mode = "normal"
			ui.overlay:blackout(false)
			ui.overlay:toast("You died. Respawning...", "bad")
		end
	end)
end

function ClimbController.start(uiRefs: any)
	ui = uiRefs
	Remotes.get("Gust").OnClientEvent:Connect(onGust)
	UserInputService.JumpRequest:Connect(onJump)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.Heartbeat:Connect(step)
end

return ClimbController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Sounds, confetti, camera shake and the "out of breath" screen effect.
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Effects = {}

function Effects.sound(id: string, volume: number?, pitch: number?)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.6
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 6)
end

function Effects.confetti(position: Vector3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = position
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 210, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 230, 130)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 160, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 110, 255)),
	})
	emitter.Size = NumberSequence.new(0.5)
	emitter.Lifetime = NumberRange.new(2, 3)
	emitter.Speed = NumberRange.new(25, 45)
	emitter.SpreadAngle = Vector2.new(70, 70)
	emitter.Acceleration = Vector3.new(0, -35, 0)
	emitter.Drag = 1.5
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-300, 300)
	emitter.LightEmission = 0.4
	emitter.Enabled = false
	emitter.Parent = anchor
	anchor.Parent = Workspace
	emitter:Emit(120)
	Debris:AddItem(anchor, 5)
end

-- Shakes the camera through Humanoid.CameraOffset (no camera scripting needed).
local shakeUntil, shakeMagnitude = 0, 0
local shakeEnabled = true

function Effects.setShakeEnabled(on: boolean)
	shakeEnabled = on
end

function Effects.shake(duration: number, magnitude: number)
	if not shakeEnabled then
		return
	end
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
	shakeMagnitude = math.max(if os.clock() < shakeUntil then shakeMagnitude else 0, magnitude)
end

-- Low stamina drains the colour from the world and blurs the edges a bit.
local breath = Instance.new("ColorCorrectionEffect")
breath.Name = "OutOfBreath"
local blur = Instance.new("BlurEffect")
blur.Name = "OutOfBreathBlur"
blur.Size = 0

function Effects.setBreathless(amount: number)
	-- amount: 0 = fine, 1 = about to black out
	breath.Saturation = -0.7 * amount
	breath.Contrast = 0.15 * amount
	breath.TintColor = Color3.new(1, 1 - 0.15 * amount, 1 - 0.15 * amount)
	blur.Size = 10 * amount * amount
end

function Effects.start()
	breath.Parent = Lighting
	blur.Parent = Lighting
	local rng = Random.new()
	RunService.RenderStepped:Connect(function()
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local now = os.clock()
		if now < shakeUntil then
			local m = shakeMagnitude * math.clamp((shakeUntil - now) * 2, 0, 1)
			humanoid.CameraOffset = Vector3.new(rng:NextNumber(-m, m), rng:NextNumber(-m, m), rng:NextNumber(-m, m))
		elseif humanoid.CameraOffset ~= Vector3.zero then
			humanoid.CameraOffset = Vector3.zero
			shakeMagnitude = 0
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Emotes</string>
            <string name="Source"><![CDATA[-- Plays emotes from the avatar's own Animate script (no uploaded animations),
-- stops them when you move, jump or climb, and plays your summit emote when you
-- reach a peak. Animations played on your own character replicate to everyone.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)

local Emotes = {}

local player = Players.LocalPlayer
local track: AnimationTrack? = nil
local isClimbing: () -> boolean = function()
	return false
end
local toast: (string, string?) -> () = function() end

-- Emote ids the player owns (free ones included), in shop order.
function Emotes.owned(): { string }
	local owned = {}
	for id in string.gmatch(player:GetAttribute("Emotes") or "", "[^,]+") do
		owned[id] = true
	end
	local list = {}
	for _, def in Config.Emotes do
		if Rules.ownsEmote(Config.Emotes, owned, def.Id) then
			table.insert(list, def.Id)
		end
	end
	return list
end

function Emotes.stop()
	if track then
		track:Stop(0.2)
		track = nil
	end
end

function Emotes.play(id: string)
	local def = Rules.emoteDef(Config.Emotes, id)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not def or not character or not humanoid or not animator or humanoid.Health <= 0 then
		return
	end
	if not table.find(Emotes.owned(), id) then
		toast("Buy " .. def.Name .. " at the Power Up Shop first", "bad")
		return
	end
	if isClimbing() then
		toast("You can't emote while climbing!", "bad")
		return
	end
	local animate = character:FindFirstChild("Animate")
	local folder = animate and (animate:FindFirstChild(def.Anim) or animate:FindFirstChild("dance"))
	local anim = folder and folder:FindFirstChildOfClass("Animation")
	if not anim then
		toast("This avatar has no " .. def.Name .. " animation", "bad")
		return
	end
	Emotes.stop()
	local ok, loaded = pcall(animator.LoadAnimation, animator, anim)
	if not ok then
		return
	end
	loaded.Priority = Enum.AnimationPriority.Action
	loaded.Looped = string.find(def.Anim, "dance") ~= nil
	loaded:Play(0.2)
	track = loaded
end

-- After reaching a peak: wait until you're standing, then show off.
function Emotes.playSummit()
	task.spawn(function()
		local deadline = os.clock() + 4
		while os.clock() < deadline do
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid and not isClimbing() and humanoid.FloorMaterial ~= Enum.Material.Air then
				task.wait(0.3)
				Emotes.play(player:GetAttribute("SummitEmote") or "Wave")
				return
			end
			task.wait(0.1)
		end
	end)
end

function Emotes.start(climbingFn: () -> boolean, toastFn: (string, string?) -> ())
	isClimbing, toast = climbingFn, toastFn
	RunService.Heartbeat:Connect(function()
		local current = track
		if not current then
			return
		end
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local state = humanoid and humanoid:GetState()
		if
			not current.IsPlaying
			or not humanoid
			or humanoid.MoveDirection.Magnitude > 0.1
			or isClimbing()
			or state == Enum.HumanoidStateType.Jumping
			or state == Enum.HumanoidStateType.Freefall
			or state == Enum.HumanoidStateType.Physics
		then
			Emotes.stop()
		end
	end)
	player.CharacterAdded:Connect(function()
		track = nil
	end)
end

return Emotes
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="35">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI, wires input and server notifications.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Effects = require(script.Parent.Effects)
local ClimbController = require(script.Parent.ClimbController)
local Emotes = require(script.Parent.Emotes)
local Weather = require(script.Parent.Weather)
local Hud = require(script.Parent.UI.Hud)
local Overlay = require(script.Parent.UI.Overlay)
local Shop = require(script.Parent.UI.Shop)
local Settings = require(script.Parent.UI.Settings)
local AdminPanel = require(script.Parent.UI.AdminPanel)

local player = Players.LocalPlayer

local function useChalk()
	Remotes.get("UseChalk"):FireServer()
end

local shop, hud, settings, overlay -- forward-declared: the button callbacks below refer to them
hud = Hud.new({
	shop = function()
		shop:toggle()
	end,
	chalk = useChalk,
	ragdoll = ClimbController.toggleRagdoll,
	letGo = ClimbController.letGo,
	clip = ClimbController.clip,
	rappel = ClimbController.rappel,
	emotes = function()
		hud:toggleEmoteBar()
	end,
	settings = function()
		settings:toggle()
	end,
	plaza = function()
		Remotes.get("ResetToPlaza"):FireServer()
	end,
})
shop = Shop.new({
	buyBoost = function(id)
		Remotes.get("BuyBoost"):FireServer(id)
	end,
	buyChalk = function()
		Remotes.get("BuyChalk"):FireServer()
	end,
	buyEmote = function(id)
		Remotes.get("BuyEmote"):FireServer(id)
	end,
	equipEmote = function(id)
		Remotes.get("EquipEmote"):FireServer(id)
	end,
	buyPass = function(id)
		for _, pass in Config.GamePasses do
			if pass.Id == id then
				if pass.GamePassId and pass.GamePassId > 0 then
					MarketplaceService:PromptGamePassPurchase(player, pass.GamePassId)
				else
					overlay:toast(pass.Name .. " isn't on sale yet.", "bad")
				end
			end
		end
	end,
})
overlay = Overlay.new()

-- Name tags: hiding them is local to you (other players still see theirs).
local showNameTags = true
local function applyNameTag(character: Model?)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = if showNameTags
			then Enum.HumanoidDisplayDistanceType.Viewer
			else Enum.HumanoidDisplayDistanceType.None
	end
end
local function applyNameTags()
	for _, other in Players:GetPlayers() do
		if other ~= player then
			applyNameTag(other.Character)
		end
	end
end
local function watchPlayer(other: Player)
	if other == player then
		return
	end
	other.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid", 10)
		applyNameTag(character)
	end)
	applyNameTag(other.Character)
end
Players.PlayerAdded:Connect(watchPlayer)
for _, other in Players:GetPlayers() do
	watchPlayer(other)
end

local adminPanel = AdminPanel.new(function(action, args)
	Remotes.get("AdminAction"):FireServer(action, args)
end)

settings = Settings.new({
	setNameTags = function(on)
		showNameTags = on
		applyNameTags()
		Remotes.get("SaveSetting"):FireServer("NameTags", on)
	end,
	setCameraShake = function(on)
		Effects.setShakeEnabled(on)
		Remotes.get("SaveSetting"):FireServer("CameraShake", on)
	end,
	submitCode = function(code)
		Remotes.get("AdminLogin"):FireServer(code)
	end,
	openAdmin = function()
		adminPanel:open()
	end,
})

-- Saved settings and admin status arrive as attributes from the server.
local function applySavedSettings()
	local tags = player:GetAttribute("Setting_NameTags")
	if typeof(tags) == "boolean" and tags ~= showNameTags then
		showNameTags = tags
		settings.setNameTags(tags)
		applyNameTags()
	end
	local shake = player:GetAttribute("Setting_CameraShake")
	if typeof(shake) == "boolean" then
		settings.setCameraShake(shake)
		Effects.setShakeEnabled(shake)
	end
	settings:setAdmin(player:GetAttribute("IsAdmin") == true)
end
applySavedSettings()

Effects.start()
ClimbController.start({ hud = hud, overlay = overlay })
Emotes.start(ClimbController.isClimbing, function(text, style)
	overlay:toast(text, style)
end)

local firstWeather = true
Weather.start(function(name)
	hud:setWeather(name)
	if not firstWeather then
		local messages = {
			Rain = "It's raining! Every wall is slippery (+25% stamina drain).",
			Clear = "The skies have cleared.",
		}
		overlay:toast(messages[name] or name, if name == "Rain" then "bad" else "info")
	end
	firstWeather = false
end)

-- Profile values ----------------------------------------------------------------

local stats = player:WaitForChild("leaderstats")
local cashValue = stats:WaitForChild("Cash") :: IntValue
local climbsValue = stats:WaitForChild("Climbs") :: IntValue

local function boostLevels(): { [string]: number }
	local levels = {}
	for _, def in Config.Boosts do
		levels[def.Id] = player:GetAttribute("Boost_" .. def.Id) or 0
	end
	return levels
end

local function ownedPasses(): { [string]: boolean }
	local owned = {}
	for _, pass in Config.GamePasses do
		owned[pass.Id] = player:GetAttribute("Pass_" .. pass.Id) == true
	end
	return owned
end

local lastEmotes = nil
local function refresh()
	hud:setCash(cashValue.Value)
	hud:setSubline(player:GetAttribute("BestHeight") or 0, player:GetAttribute("Streak") or 0)
	local owned = Emotes.owned()
	shop:refresh(cashValue.Value, boostLevels(), player:GetAttribute("Chalk") or 0, owned, player:GetAttribute("SummitEmote") or "", ownedPasses())
	local key = table.concat(owned, ",")
	if key ~= lastEmotes then
		lastEmotes = key
		local list = {}
		for _, id in owned do
			for _, def in Config.Emotes do
				if def.Id == id then
					table.insert(list, { id = id, name = def.Name })
				end
			end
		end
		hud:setEmotes(list, Emotes.play)
	end
end

hud:setClimbs(climbsValue.Value)
climbsValue.Changed:Connect(function(value)
	hud:setClimbs(value, true)
end)
cashValue.Changed:Connect(refresh)
player.AttributeChanged:Connect(function(name)
	if string.sub(name, 1, 8) == "Setting_" or name == "IsAdmin" then
		applySavedSettings()
	elseif name ~= "ChalkUntil" then
		refresh()
	end
end)
refresh()

-- Input -----------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.B then
		shop:toggle()
	elseif input.KeyCode == Enum.KeyCode.C then
		useChalk()
	elseif input.KeyCode == Enum.KeyCode.Q then
		ClimbController.letGo()
	elseif input.KeyCode == Enum.KeyCode.F then
		ClimbController.clip()
	elseif input.KeyCode == Enum.KeyCode.X then
		ClimbController.unclip()
	elseif input.KeyCode == Enum.KeyCode.V then
		ClimbController.rappel()
	elseif input.KeyCode == Enum.KeyCode.R then
		ClimbController.toggleRagdoll()
	elseif input.KeyCode == Enum.KeyCode.G then
		hud:toggleEmoteBar()
	elseif input.KeyCode == Enum.KeyCode.O then
		settings:toggle()
	elseif input.KeyCode == Enum.KeyCode.P then
		Remotes.get("ResetToPlaza"):FireServer()
	elseif input.KeyCode == Enum.KeyCode.Escape and shop:isOpen() then
		shop:close()
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt)
	if prompt.Name == "ShopPrompt" then
		shop:open()
	end
end)

-- Server notifications ----------------------------------------------------------------

Remotes.get("Notify").OnClientEvent:Connect(function(kind, payload)
	if typeof(payload) ~= "table" then
		return
	end
	if kind == "Toast" then
		overlay:toast(tostring(payload.text), payload.style)
	elseif kind == "Summit" then
		overlay:showSummit(tostring(payload.tower), payload.payout or 0, payload.climbs or 0)
		Effects.sound(Config.Sounds.Summit, 0.9)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			Effects.confetti((root :: BasePart).Position + Vector3.new(0, 4, 0))
		end
		Emotes.playSummit()
	elseif kind == "Daily" then
		overlay:toast(string.format("Daily reward: +$%d  (streak %d)", payload.reward or 0, payload.streak or 0), "gold")
	elseif kind == "Unlock" then
		overlay:toast(tostring(payload.text), "gold")
	elseif kind == "AdminResult" then
		local ok, text = payload.ok == true, tostring(payload.text)
		settings:showCodeResult(ok, text)
		adminPanel:showResult(ok, text)
		overlay:toast(text, if ok then "good" else "bad")
	elseif kind == "Announcement" then
		overlay:announcement(tostring(payload.text), tostring(payload.from or "Admin"))
		Effects.sound(Config.Sounds.Summit, 0.7, 0.8)
	elseif kind == "Regrip" then
		ClimbController.regrip()
	elseif kind == "Hurt" then
		overlay:hurtFlash(payload.damage or 0)
		Effects.shake(0.4, math.clamp((payload.damage or 0) / 60, 0.1, 0.6))
	end
end)

-- First-time hint.
task.delay(2, function()
	if climbsValue.Value == 0 then
		overlay:toast("Start with the Tutorial Tower: walk into it to grab on, hold W to climb. Press F to clip your rope to a beam, and rest on the yellow bars!", "info")
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="36">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">AdminPanel</string>
              <string name="Source"><![CDATA[-- Admin panel: pick a player, then ban / unban / send to plaza / give or take
-- a gamepass; send everyone to the plaza; send a game-wide announcement.
-- Every button only *asks* the server, which re-checks that you're an admin.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local AdminPanel = {}
AdminPanel.__index = AdminPanel

local RED = Color3.fromRGB(255, 80, 90)

local function section(parent: Instance, order: number, title: string, height: number): Frame
	local frame = C.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Card,
		Parent = parent,
	}, { C.corner(), C.stroke(nil, 1, 0.9), C.padding(14, 10) })
	C.new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		Font = Theme.Title,
		Text = title,
		TextSize = 14,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	return frame
end

local function hlist(parent: Instance, y: number, height: number): Frame
	return C.new("Frame", {
		Position = UDim2.fromOffset(0, y),
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		C.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
end

function AdminPanel.new(send: (action: string, args: { [string]: any }) -> ())
	local self = setmetatable({}, AdminPanel)
	local modal = C.modal("AdminPanel", "ADMIN PANEL", RED, Vector2.new(600, 640), 7)
	self.modal = modal
	self.selectedPass = nil :: string?

	local list = C.new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -36),
		BackgroundTransparency = 1,
		ScrollBarThickness = 5,
		ScrollBarImageColor3 = RED,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = modal.body,
	}, {
		C.new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		C.new("UIPadding", { PaddingRight = UDim.new(0, 8) }),
	})

	-- Target player ----------------------------------------------------------------
	local target = section(list, 1, "PLAYER", 132)
	self.username = C.textbox({
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 40),
		PlaceholderText = "Username (or tap a player below)",
		Parent = target,
	})
	self.playerChips = C.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 74),
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		Parent = target,
	}, {
		C.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local function username(): string
		return (string.gsub(self.username.Text, "%s", ""))
	end

	-- Player actions -----------------------------------------------------------------
	local moderation = section(list, 2, "MODERATION", 136)
	self.reason = C.textbox({
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 36),
		PlaceholderText = "Ban reason (optional)",
		TextSize = 14,
		Parent = moderation,
	})
	local modRow = hlist(moderation, 70, 44)
	C.button({ LayoutOrder = 1, Size = UDim2.fromOffset(160, 42), BackgroundColor3 = Color3.fromRGB(50, 110, 90), Text = "SEND TO PLAZA", TextSize = 14, Parent = modRow }, function()
		send("plaza", { username = username() })
	end)
	-- Ban needs a second click to confirm.
	local banArmedUntil = 0
	local banButton
	banButton = C.button({ LayoutOrder = 2, Size = UDim2.fromOffset(160, 42), BackgroundColor3 = RED, Text = "BAN", TextSize = 14, Parent = modRow }, function()
		local now = os.clock()
		if now < banArmedUntil then
			banArmedUntil = 0
			banButton.Text = "BAN"
			send("ban", { username = username(), reason = self.reason.Text })
		else
			banArmedUntil = now + 3
			banButton.Text = "CONFIRM BAN?"
			task.delay(3, function()
				if os.clock() >= banArmedUntil then
					banButton.Text = "BAN"
				end
			end)
		end
	end)
	C.button({ LayoutOrder = 3, Size = UDim2.fromOffset(160, 42), BackgroundColor3 = Theme.PanelLight, Text = "UNBAN", TextSize = 14, Parent = modRow }, function()
		send("unban", { username = username() })
	end)

	-- Gamepasses ---------------------------------------------------------------------
	local passes = section(list, 3, "GAMEPASSES  (player must be in this server)", 134)
	local passRow = hlist(passes, 24, 40)
	self.passChips = {}
	for i, pass in Config.GamePasses do
		local chip
		chip = C.button({ LayoutOrder = i, Size = UDim2.fromOffset(160, 38), BackgroundColor3 = Theme.PanelLight, Text = pass.Name, TextSize = 14, Parent = passRow }, function()
			self.selectedPass = pass.Id
			for id, other in self.passChips do
				other.BackgroundColor3 = if id == pass.Id then Theme.Accent else Theme.PanelLight
				other.TextColor3 = if id == pass.Id then Color3.fromRGB(30, 20, 0) else Theme.Text
			end
		end)
		self.passChips[pass.Id] = chip
	end
	local giveRow = hlist(passes, 72, 40)
	C.button({ LayoutOrder = 1, Size = UDim2.fromOffset(160, 38), BackgroundColor3 = Theme.Good, TextColor3 = Color3.fromRGB(15, 30, 20), Text = "GIVE FREE", TextSize = 14, Parent = giveRow }, function()
		send("givePass", { username = username(), passId = self.selectedPass })
	end)
	C.button({ LayoutOrder = 2, Size = UDim2.fromOffset(160, 38), BackgroundColor3 = Theme.PanelLight, Text = "TAKE AWAY", TextSize = 14, Parent = giveRow }, function()
		send("takePass", { username = username(), passId = self.selectedPass })
	end)

	-- Everyone -------------------------------------------------------------------------
	local everyone = section(list, 4, "EVERYONE", 184)
	self.announcement = C.textbox({
		Position = UDim2.fromOffset(0, 26),
		Size = UDim2.new(1, 0, 0, 70),
		PlaceholderText = "Game-wide announcement (sent to every server)",
		TextSize = 15,
		TextWrapped = true,
		MultiLine = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = everyone,
	})
	local allRow = hlist(everyone, 106, 44)
	C.button({ LayoutOrder = 1, Size = UDim2.fromOffset(200, 42), BackgroundColor3 = Theme.Info, TextColor3 = Color3.fromRGB(10, 20, 40), Text = "SEND ANNOUNCEMENT", TextSize = 14, Parent = allRow }, function()
		local text = self.announcement.Text
		if #text > 0 then
			send("announce", { text = text })
		end
	end)
	C.button({ LayoutOrder = 2, Size = UDim2.fromOffset(200, 42), BackgroundColor3 = Color3.fromRGB(50, 110, 90), Text = "ALL TO PLAZA", TextSize = 14, Parent = allRow }, function()
		send("plaza", { all = true })
	end)

	-- Result line along the bottom.
	self.status = C.new("TextLabel", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 26),
		Font = Theme.Bold,
		Text = "Every action is checked by the server.",
		TextSize = 15,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = modal.body,
	})

	local function refreshPlayers()
		for _, child in self.playerChips:GetChildren() do
			if child:IsA("GuiButton") then
				child:Destroy()
			end
		end
		for i, p in Players:GetPlayers() do
			C.button({
				LayoutOrder = i,
				Size = UDim2.fromOffset(math.max(80, #p.Name * 9 + 24), 32),
				BackgroundColor3 = Theme.PanelLight,
				Text = p.Name,
				TextSize = 13,
				Parent = self.playerChips,
			}, function()
				self.username.Text = p.Name
			end)
		end
	end
	Players.PlayerAdded:Connect(refreshPlayers)
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshPlayers)
	end)
	refreshPlayers()
	return self
end

function AdminPanel:showResult(ok: boolean, text: string)
	self.status.Text = text
	self.status.TextColor3 = if ok then Theme.Good else Theme.Bad
	if ok then
		self.announcement.Text = ""
	end
end

function AdminPanel:open()
	self.modal.open()
end

function AdminPanel:close()
	self.modal.close()
end

return AdminPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[-- Tiny declarative helpers so the UI code reads as layout, not boilerplate.
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local C = {}

-- C.new("Frame", { Size = ... }, { child1, child2 })
function C.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		(inst :: GuiObject).BorderSizePixel = 0
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		(inst :: any).Font = Theme.Body;
		(inst :: any).TextColor3 = Theme.Text;
		(inst :: any).BackgroundTransparency = 1
	end
	local parent = nil
	for key, value in (props or {}) :: { [string]: any } do
		if key == "Parent" then
			parent = value
		else
			(inst :: any)[key] = value
		end
	end
	for _, child in (children or {}) :: { Instance } do
		child.Parent = inst
	end
	-- Text can never spill out of its box: labels and buttons shrink their text
	-- to fit (never above their normal size); text boxes clip what you type.
	-- Auto-sized text (toasts, banners) grows its box instead, so it's left alone.
	local p = props or {}
	if (inst:IsA("TextLabel") or inst:IsA("TextButton")) and p.TextScaled == nil and p.AutomaticSize == nil then
		local text = inst :: TextLabel
		local fit = Instance.new("UITextSizeConstraint")
		fit.MaxTextSize = text.TextSize
		fit.MinTextSize = math.min(9, text.TextSize)
		fit.Parent = text
		text.TextScaled = true
	elseif inst:IsA("TextBox") then
		(inst :: TextBox).ClipsDescendants = true
	end
	inst.Parent = parent
	return inst
end

function C.corner(radius: number?): UICorner
	return C.new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Radius) })
end

function C.round(): UICorner
	return C.new("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function C.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return C.new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function C.padding(x: number, y: number?): UIPadding
	return C.new("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x),
		PaddingBottom = UDim.new(0, y or x),
	})
end

function C.gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return C.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	})
end

-- Dark glass panel used for every HUD element.
function C.panel(props: { [string]: any }, children: { Instance }?): Frame
	local merged = {
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
	}
	for k, v in props do
		merged[k] = v
	end
	local kids = { C.corner(), C.gradient(Color3.new(1, 1, 1), Color3.fromRGB(200, 205, 220)) }
	local hasStroke = false
	for _, child in (children or {}) :: { Instance } do
		hasStroke = hasStroke or child:IsA("UIStroke")
		table.insert(kids, child)
	end
	if not hasStroke then
		-- Only one UIStroke per object renders, so a custom one replaces the default.
		table.insert(kids, C.stroke())
	end
	return C.new("Frame", merged, kids)
end

function C.tween(inst: Instance, time: number, goals: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), goals)
	tween:Play()
	return tween
end

-- Button with hover lift and press squash. `onClick` fires on activation.
function C.button(props: { [string]: any }, onClick: () -> ()): TextButton
	local base = props.BackgroundColor3 or Theme.Card
	local merged = {
		BackgroundColor3 = base,
		BackgroundTransparency = 0,
		AutoButtonColor = false,
		Font = Theme.Bold,
		TextSize = 16,
	}
	for k, v in props do
		merged[k] = v
	end
	local scale = C.new("UIScale")
	local button = C.new("TextButton", merged, { C.corner(10), C.stroke(nil, 1, 0.8), scale })
	button.BackgroundTransparency = merged.BackgroundTransparency
	-- Hover lights up the outline. It doesn't grow the button (that pushed it
	-- and its text past panel edges) or recolour it (callers recolour buttons
	-- for affordable / maxed states).
	local outline = button:FindFirstChildOfClass("UIStroke") :: UIStroke
	button.MouseEnter:Connect(function()
		C.tween(outline, 0.15, { Transparency = 0.15, Thickness = 2 })
	end)
	button.MouseLeave:Connect(function()
		C.tween(outline, 0.15, { Transparency = 0.8, Thickness = 1 })
		C.tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		C.tween(scale, 0.08, { Scale = 0.96 })
	end)
	button.MouseButton1Up:Connect(function()
		C.tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(onClick)
	return button
end

-- Pill toggle switch. Calls onChange(newValue) when clicked; returns a setter.
function C.toggle(props: { [string]: any }, initial: boolean, onChange: (boolean) -> ()): (TextButton, (boolean) -> ())
	local value = initial
	local merged = {
		Size = UDim2.fromOffset(64, 32),
		BackgroundColor3 = Theme.PanelLight,
		AutoButtonColor = false,
		Text = "",
	}
	for k, v in props do
		merged[k] = v
	end
	local track = C.new("TextButton", merged, { C.round(), C.stroke(nil, 1, 0.8) })
	track.BackgroundTransparency = 0
	local knob = C.new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = track,
	}, { C.round() })
	local function render(animate: boolean)
		local goals = {
			Position = if value then UDim2.new(1, -28, 0.5, 0) else UDim2.new(0, 4, 0.5, 0),
		}
		local color = if value then Theme.Good else Theme.PanelLight
		if animate then
			C.tween(knob, 0.2, goals, Enum.EasingStyle.Back)
			C.tween(track, 0.2, { BackgroundColor3 = color })
		else
			knob.Position = goals.Position
			track.BackgroundColor3 = color
		end
	end
	render(false)
	track.Activated:Connect(function()
		value = not value
		render(true)
		onChange(value)
	end)
	return track, function(v: boolean)
		if v ~= value then
			value = v
			render(true)
		end
	end
end

-- Dark rounded text box.
function C.textbox(props: { [string]: any }): TextBox
	local merged = {
		BackgroundColor3 = Theme.PanelLight,
		BackgroundTransparency = 0,
		ClearTextOnFocus = false,
		Font = Theme.Bold,
		PlaceholderColor3 = Theme.Muted,
		Text = "",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		merged[k] = v
	end
	local box = C.new("TextBox", merged, { C.corner(10), C.stroke(nil, 1, 0.8), C.padding(12, 0) })
	box.BackgroundTransparency = merged.BackgroundTransparency
	return box
end

export type Modal = { gui: ScreenGui, window: Frame, body: Frame, open: () -> (), close: () -> (), isOpen: () -> boolean }

-- A centred window over a dimmed screen, with a title bar and close button.
-- Put content in `body`.
function C.modal(name: string, title: string, accent: Color3, size: Vector2, displayOrder: number): Modal
	local gui = C.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = displayOrder,
		Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui"),
	})
	local root = C.autoScale(gui)
	local dim = C.new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Text = "",
		AutoButtonColor = false,
		Parent = root,
	})
	local window = C.panel({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundTransparency = 0.04,
		Parent = root,
	}, { C.stroke(accent, 2, 0.35) })
	local scale = C.new("UIScale", { Parent = window })
	-- Accent strip along the top edge.
	C.new("Frame", {
		Size = UDim2.new(1, -24, 0, 3),
		Position = UDim2.fromOffset(12, 0),
		BackgroundColor3 = accent,
		Parent = window,
	}, { C.round() })
	C.new("TextLabel", {
		Position = UDim2.fromOffset(24, 18),
		Size = UDim2.new(1, -100, 0, 36),
		Font = Theme.Title,
		Text = title,
		TextSize = 28,
		TextColor3 = accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = window,
	})
	local body = C.new("Frame", {
		Position = UDim2.fromOffset(24, 70),
		Size = UDim2.new(1, -48, 1, -88),
		BackgroundTransparency = 1,
		Parent = window,
	})
	local modal: Modal
	local function close()
		gui.Enabled = false
	end
	local function open()
		gui.Enabled = true
		scale.Scale = 0.88
		C.tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	C.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 16),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Color3.fromRGB(70, 40, 46),
		Text = "X",
		TextSize = 18,
		Parent = window,
	}, close)
	dim.Activated:Connect(close)
	modal = {
		gui = gui,
		window = window,
		body = body,
		open = open,
		close = close,
		isOpen = function()
			return gui.Enabled
		end,
	}
	return modal
end

-- Returns a full-screen root frame whose contents scale with screen height, so
-- phones and 4K screens get the same layout. The frame is sized 1/scale and
-- then scaled by `scale`, so it always covers exactly the screen and children
-- anchored to its edges stay on the edges. Parent all UI to the returned frame.
function C.autoScale(gui: ScreenGui): Frame
	local root = C.new("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	local scale = C.new("UIScale", { Parent = root })
	local camera = workspace.CurrentCamera
	local function update()
		local s = math.clamp(camera.ViewportSize.Y / 900, 0.6, 1.25)
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	update()
	return root
end

return C
]]></string>
            </Properties>
