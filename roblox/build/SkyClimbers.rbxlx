      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- RemoteEvents shared by server and client. The server creates them; clients wait.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local NAMES = {
	"BuyBoost", -- client -> server: boostId
	"BuyChalk", -- client -> server
	"UseChalk", -- client -> server
	"Ragdoll", -- client -> server: isRagdolled, fallStartY?
	"ResetToPlaza", -- client -> server
	"Notify", -- server -> client: kind, payload
	"Gust", -- server -> all clients: phase, direction, duration
}

function Remotes.create()
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in NAMES do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
	return folder
end

function Remotes.get(name: string): RemoteEvent
	return ReplicatedStorage:WaitForChild("Remotes"):WaitForChild(name) :: RemoteEvent
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Rules</string>
          <string name="Source"><![CDATA[--!strict
-- Pure game rules shared by server and client. No Roblox APIs and no requires:
-- every function takes the config tables it needs, so tests can run them in
-- plain Luau.

local Rules = {}

export type Boosts = { [string]: number }

local function boostDef(boostDefs: { any }, id: string): any?
	for _, def in boostDefs do
		if def.Id == id then
			return def
		end
	end
	return nil
end
Rules.boostDef = boostDef

local function level(boosts: Boosts, id: string): number
	return boosts[id] or 0
end

-- Stamina ---------------------------------------------------------------

function Rules.maxStamina(staminaCfg: any, boostDefs: { any }, boosts: Boosts): number
	local def = boostDef(boostDefs, "Endurance")
	return staminaCfg.Base + (def and def.PerLevel or 0) * level(boosts, "Endurance")
end

export type DrainContext = {
	climbing: boolean,
	moving: boolean,
	towerMultiplier: number,
	slippery: boolean,
	chalk: boolean,
	gust: boolean,
}

-- Stamina change per second for the given situation. Negative = draining.
function Rules.staminaRate(
	staminaCfg: any,
	chalkCfg: any,
	windCfg: any,
	boostDefs: { any },
	boosts: Boosts,
	ctx: DrainContext,
	grounded: boolean
): number
	if ctx.climbing then
		local rate = staminaCfg.DrainPerSecond * ctx.towerMultiplier
		if not ctx.moving then
			rate *= staminaCfg.HangDrainFraction
		end
		if ctx.slippery then
			local grip = boostDef(boostDefs, "Grip")
			rate *= math.max(0.2, 1 - (grip and grip.PerLevel or 0) * level(boosts, "Grip"))
		end
		if ctx.chalk then
			rate *= chalkCfg.DrainMultiplier
		end
		if ctx.gust then
			rate *= windCfg.DrainMultiplier
		end
		return -rate
	elseif grounded then
		local rec = boostDef(boostDefs, "Recovery")
		return staminaCfg.RecoverPerSecond * (1 + (rec and rec.PerLevel or 0) * level(boosts, "Recovery"))
	end
	return 0
end

function Rules.stepStamina(current: number, rate: number, dt: number, max: number): number
	return math.clamp(current + rate * dt, 0, max)
end

-- Wall crawl speed (studs/second) with the Quick Hands boost.
function Rules.climbSpeed(climbCfg: any, boostDefs: { any }, boosts: Boosts): number
	local def = boostDef(boostDefs, "ClimbSpeed")
	return climbCfg.ClimbSpeed * (1 + (def and def.PerLevel or 0) * level(boosts, "ClimbSpeed"))
end

-- Stamina a lunge costs, given the (negative) stamina rate of crawling right now:
-- the same as crawling LungeDistance at base speed, times LungeCostFactor.
function Rules.lungeCost(climbCfg: any, climbingRate: number): number
	return math.abs(climbingRate) * (climbCfg.LungeDistance / climbCfg.ClimbSpeed) * climbCfg.LungeCostFactor
end

-- Shop ------------------------------------------------------------------

-- Cost to buy the next level, or nil when already maxed / unknown.
function Rules.boostCost(boostDefs: { any }, id: string, currentLevel: number): number?
	local def = boostDef(boostDefs, id)
	if not def or currentLevel >= def.MaxLevel or currentLevel < 0 then
		return nil
	end
	return math.floor(def.BaseCost * def.Growth ^ currentLevel + 0.5)
end

export type PurchaseResult = { ok: boolean, reason: string?, cost: number? }

function Rules.canBuyBoost(boostDefs: { any }, id: string, currentLevel: number, cash: number): PurchaseResult
	local maybeCost = Rules.boostCost(boostDefs, id, currentLevel)
	if not maybeCost then
		if boostDef(boostDefs, id) == nil then
			return { ok = false, reason = "Unknown boost" }
		end
		return { ok = false, reason = "Already maxed" }
	end
	local cost = maybeCost :: number
	if cash < cost then
		return { ok = false, reason = "Not enough cash", cost = cost }
	end
	return { ok = true, cost = cost }
end

function Rules.canBuyChalk(chalkCfg: any, held: number, cash: number): PurchaseResult
	if held >= chalkCfg.MaxHeld then
		return { ok = false, reason = "Chalk bag is full" }
	end
	if cash < chalkCfg.Price then
		return { ok = false, reason = "Not enough cash", cost = chalkCfg.Price }
	end
	return { ok = true, cost = chalkCfg.Price }
end

-- Falls -----------------------------------------------------------------

function Rules.fallDamage(fallCfg: any, boostDefs: { any }, boosts: Boosts, drop: number): number
	if drop ~= drop or drop <= fallCfg.SafeDrop then -- drop ~= drop catches NaN
		return 0
	end
	local def = boostDef(boostDefs, "SoftLanding")
	local reduction = math.min(0.75, (def and def.PerLevel or 0) * level(boosts, "SoftLanding"))
	return (drop - fallCfg.SafeDrop) * fallCfg.DamagePerStud * (1 - reduction)
end

-- Climb validation --------------------------------------------------------

export type ActiveClimb = { tower: string, startTime: number, paid: boolean }

-- Whether reaching the peak of `tower` at `now` earns a payout.
function Rules.validatePeak(climbCfg: any, active: ActiveClimb?, tower: string, height: number, now: number): (boolean, string?)
	if not active then
		return false, "Start the climb from the bottom of the tower"
	end
	local climb = active :: ActiveClimb
	if climb.tower ~= tower then
		return false, "Start the climb from the bottom of this tower"
	end
	if climb.paid then
		return false, "Already paid - head back down to climb again"
	end
	if now - climb.startTime < height / climbCfg.MaxPlausibleSpeed then
		return false, "Too fast to be real"
	end
	return true, nil
end

-- Daily reward ------------------------------------------------------------

-- Returns newStreak, reward, alreadyClaimed.
function Rules.dailyReward(dailyCfg: any, lastDay: number, streak: number, today: number): (number, number, boolean)
	if lastDay == today then
		return streak, 0, true
	end
	local newStreak = if lastDay == today - 1 then streak + 1 else 1
	local reward = dailyCfg.BaseReward * math.min(newStreak, dailyCfg.MaxStreakMultiplier)
	return newStreak, reward, false
end

-- Trails ------------------------------------------------------------------

function Rules.bestTrail(trails: { any }, climbs: number): any?
	local best = nil
	for _, t in trails do
		if climbs >= t.Climbs then
			best = t
		end
	end
	return best
end

-- Profiles ----------------------------------------------------------------

function Rules.defaultProfile(boostDefs: { any }): any
	local boosts = {}
	for _, def in boostDefs do
		boosts[def.Id] = 0
	end
	return {
		Version = 1,
		Cash = 0,
		Climbs = 0,
		Chalk = 0,
		Boosts = boosts,
		LastDaily = 0,
		Streak = 0,
		BestHeight = 0,
	}
end

-- Fill in anything missing from saved data (new fields added in updates) and
-- clamp values back into range so corrupt saves can't break the game.
function Rules.reconcileProfile(boostDefs: { any }, chalkCfg: any, saved: any): any
	local profile = Rules.defaultProfile(boostDefs)
	if type(saved) ~= "table" then
		return profile
	end
	for key, value in profile do
		if key ~= "Boosts" and type(saved[key]) == type(value) then
			profile[key] = saved[key]
		end
	end
	if type(saved.Boosts) == "table" then
		for _, def in boostDefs do
			local v = saved.Boosts[def.Id]
			if type(v) == "number" then
				profile.Boosts[def.Id] = math.clamp(math.floor(v), 0, def.MaxLevel)
			end
		end
	end
	profile.Cash = math.max(0, math.floor(profile.Cash))
	profile.Climbs = math.max(0, math.floor(profile.Climbs))
	profile.Chalk = math.clamp(math.floor(profile.Chalk), 0, chalkCfg.MaxHeld)
	return profile
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Build</string>
          <string name="Source"><![CDATA[-- Small helpers for creating anchored geometry from code.
local Build = {}

-- Create an instance, apply properties, then parent it last (cheaper replication).
function Build.part(parent: Instance, props: { [string]: any }): BasePart
	local part = Instance.new(props.ClassName or "Part") :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		-- Shape first: changing it afterwards can resize the part.
		(part :: Part).Shape = props.Shape
	end
	for key, value in props do
		if key ~= "ClassName" and key ~= "Attributes" and key ~= "Tags" and key ~= "Shape" then
			(part :: any)[key] = value
		end
	end
	if props.Attributes then
		for key, value in props.Attributes do
			part:SetAttribute(key, value)
		end
	end
	if props.Tags then
		for _, tag in props.Tags do
			part:AddTag(tag)
		end
	end
	part.Parent = parent
	return part
end

-- Decorative strut between two world points. Non-colliding so it never snags climbers.
function Build.beam(parent: Instance, a: Vector3, b: Vector3, thickness: number, props: { [string]: any }): BasePart
	local dir = b - a
	local length = dir.Magnitude
	local up = if math.abs(dir.Unit.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local merged = {
		Size = Vector3.new(thickness, thickness, length),
		CFrame = CFrame.lookAt((a + b) / 2, b, up),
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}
	for key, value in props do
		merged[key] = value
	end
	return Build.part(parent, merged)
end

-- Vertical cylinder centred at `center`.
function Build.cylinder(parent: Instance, center: Vector3, height: number, diameter: number, props: { [string]: any }): BasePart
	local merged = {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)),
	}
	for key, value in props do
		merged[key] = value
	end
	return Build.part(parent, merged)
end

-- Red blinking aviation light (blinking is driven by EnvironmentService).
function Build.aviationLight(parent: Instance, position: Vector3, size: number?): BasePart
	local bulb = Build.part(parent, {
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * (size or 1.6),
		Position = position,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 40, 40),
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Tags = { "AviationLight" },
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 60, 60)
	light.Range = 24
	light.Brightness = 3
	light.Parent = bulb
	return bulb
end

-- Billboard-style sign text on the front face of a part.
function Build.surfaceText(part: BasePart, lines: { { text: string, size: number, color: Color3, font: Enum.Font? } })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local layout = Instance.new("UIListLayout")
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 6)
	layout.Parent = gui
	for i, line in lines do
		local label = Instance.new("TextLabel")
		label.LayoutOrder = i
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, -20, 0, line.size)
		label.Font = line.font or Enum.Font.GothamBlack
		label.Text = line.text
		label.TextColor3 = line.color
		label.TextScaled = true
		label.Parent = gui
	end
	gui.Parent = part
	return gui
end

return Build
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">ClimbService</string>
          <string name="Source"><![CDATA[-- Climb tracking: base/peak zones, payouts, checkpoints, lifts, trails.
--
-- A climb starts when you touch a tower's BaseZone and pays out once when you
-- reach its PeakZone. The peak only pays if the climb started on the same
-- tower and took a physically plausible amount of time.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local ClimbService = {}

type Checkpoint = { tower: string, position: Vector3 }

local active: { [Player]: Rules.ActiveClimb } = {}
local checkpoints: { [Player]: Checkpoint } = {}
local lastRejectNotice: { [Player]: number } = {}
local plazaSpawn: CFrame = CFrame.new(0, 4, 24)

local notify: RemoteEvent

local function playerFromHit(hit: BasePart): (Player?, Humanoid?)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil, nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not player or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return player, humanoid
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function ClimbService.toast(player: Player, text: string, style: string?)
	notify:FireClient(player, "Toast", { text = text, style = style or "info" })
end

function ClimbService.sendToPlaza(player: Player)
	checkpoints[player] = nil
	local character = player.Character
	if character then
		local offset = Vector3.new(math.random(-6, 6), 0, math.random(-4, 4))
		character:PivotTo(plazaSpawn + offset)
	end
end

function ClimbService.equipTrail(player: Player)
	local character = player.Character
	local root = rootOf(player)
	local data = DataService.get(player)
	if not character or not root or not data then
		return
	end
	local best = Rules.bestTrail(Config.Trails, data.Climbs)
	local existing = root:FindFirstChild("ClimbTrail") :: Trail?
	if existing and best and existing:GetAttribute("TrailName") == best.Name then
		return
	end
	if existing then
		existing:Destroy()
	end
	for _, name in { "TrailTop", "TrailBottom" } do
		local old = root:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	if not best then
		return
	end
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailTop"
	a0.Position = Vector3.new(0, 0.8, 0)
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailBottom"
	a1.Position = Vector3.new(0, -0.8, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "ClimbTrail"
	trail:SetAttribute("TrailName", best.Name)
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.6
	trail.LightEmission = 0.6
	trail.FaceCamera = true
	local c = Color3.fromRGB(best.Color[1], best.Color[2], best.Color[3])
	trail.Color = ColorSequence.new(c)
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.Parent = root
end

local function onPeak(tower: Model, player: Player)
	local id = tower:GetAttribute("TowerId") :: string
	local height = tower:GetAttribute("Height") :: number
	local ok, reason = Rules.validatePeak(Config.Climb, active[player], id, height, os.clock())
	if not ok then
		local now = os.clock()
		if now - (lastRejectNotice[player] or 0) > 6 then
			lastRejectNotice[player] = now
			ClimbService.toast(player, reason :: string, "bad")
		end
		return
	end
	local climb = active[player] :: Rules.ActiveClimb
	climb.paid = true
	checkpoints[player] = nil

	local payout = tower:GetAttribute("Payout") :: number
	local before = (DataService.get(player) or {}).Climbs or 0
	DataService.update(player, function(data)
		data.Cash += payout
		data.Climbs += 1
	end)
	local data = DataService.get(player)
	if not data then
		return
	end
	notify:FireClient(player, "Summit", { tower = id, payout = payout, climbs = data.Climbs })

	local oldTrail = Rules.bestTrail(Config.Trails, before)
	local newTrail = Rules.bestTrail(Config.Trails, data.Climbs)
	if newTrail and newTrail ~= oldTrail then
		notify:FireClient(player, "Unlock", { text = newTrail.Name .. " trail unlocked!" })
		ClimbService.equipTrail(player)
	end
end

local function hookTower(tower: Model)
	local id = tower:GetAttribute("TowerId") :: string
	local base = tower:FindFirstChild("BaseZone") :: BasePart
	local peak = tower:FindFirstChild("PeakZone") :: BasePart

	base.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if not player then
			return
		end
		local climb = active[player]
		-- Re-arm when starting fresh, switching tower, or after being paid.
		-- Still at the bottom of the current climb: the timer runs from the last
		-- base touch, which keeps the "too fast" check strict.
		if climb and climb.tower == id and not climb.paid then
			climb.startTime = os.clock()
			return
		end
		active[player] = { tower = id, startTime = os.clock(), paid = false }
		local cp = checkpoints[player]
		if cp and cp.tower ~= id then
			checkpoints[player] = nil
		end
	end)

	peak.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if player then
			onPeak(tower, player)
		end
	end)

	for _, part in tower:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("Checkpoint") then
			part.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				local root = player and rootOf(player)
				if not player or not root then
					return
				end
				local climb = active[player]
				if not climb or climb.tower ~= id or climb.paid then
					return
				end
				-- Only count it when standing on top, not brushing the underside.
				local topY = part.Position.Y + part.Size.Y / 2
				if root.Position.Y < topY then
					return
				end
				local cp = checkpoints[player]
				if not cp or cp.tower ~= id or root.Position.Y > cp.position.Y + 4 then
					checkpoints[player] = { tower = id, position = root.Position + Vector3.new(0, Config.Climb.CheckpointRespawnLift, 0) }
					if cp and cp.tower == id then
						ClimbService.toast(player, "Checkpoint saved", "good")
					end
				end
			end)
		end
	end

	local lift = tower:FindFirstChild("Lift")
	local prompt = lift and lift:FindFirstChild("LiftPrompt") :: ProximityPrompt?
	if prompt then
		prompt.Triggered:Connect(function(player)
			ClimbService.sendToPlaza(player)
			ClimbService.toast(player, "Back at the plaza. Pick your next tower!", "info")
		end)
	end
end

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.BreakJointsOnDeath = false -- we ragdoll on death instead
	humanoid.RequiresNeck = false
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not root then
		return
	end
	task.defer(ClimbService.equipTrail, player)

	local cp = checkpoints[player]
	if cp then
		task.wait(0.1)
		if character.Parent then
			character:PivotTo(CFrame.new(cp.position))
			ClimbService.toast(player, "Respawned at your last checkpoint", "info")
		end
	end
end

function ClimbService.start(towers: Folder, spawnCFrame: CFrame)
	plazaSpawn = spawnCFrame
	notify = Remotes.get("Notify")
	for _, tower in towers:GetChildren() do
		if tower:IsA("Model") and tower:GetAttribute("TowerId") then
			hookTower(tower)
		end
	end

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
		checkpoints[player] = nil
		lastRejectNotice[player] = nil
	end)

	Remotes.get("ResetToPlaza").OnServerEvent:Connect(function(player)
		active[player] = nil
		ClimbService.sendToPlaza(player)
	end)

	-- Track best height reached (shown on the HUD).
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local root = rootOf(player)
				local data = DataService.get(player)
				if root and data and root.Position.Y > data.BestHeight + 1 and root.Position.Y < 2000 then
					DataService.update(player, function(d)
						d.BestHeight = math.floor(root.Position.Y)
					end)
				end
			end
		end
	end)
end

return ClimbService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Player save data.
--
-- Safety rules:
--   * Never save a profile that failed to load. Saving defaults over real data
--     would wipe the player.
--   * Session lock: a profile records which server owns it, so two servers can't
--     overwrite each other when a player hops quickly. A stale lock (server
--     crashed) is taken over after LOCK_TIMEOUT.
--   * Retries with backoff, autosave, and a final save on leave / shutdown.
--
-- In an unpublished place, or with Studio API access off, DataStores fail; the
-- game still runs but progress is not saved and the player is told so.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)

local DataService = {}

local LOCK_TIMEOUT = 180
local RETRIES = 3

type Profile = { data: any, persistent: boolean, dirty: boolean }

local profiles: { [Player]: Profile } = {}
local changedCallbacks: { (Player, any) -> () } = {}

local store: DataStore? = nil
local orderedStore: OrderedDataStore? = nil
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
		orderedStore = DataStoreService:GetOrderedDataStore(Config.LeaderboardStoreName)
	end)
	if not ok then
		warn("[DataService] DataStores unavailable, progress will not save:", err)
	end
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function withRetries<T>(label: string, fn: () -> T): (boolean, T | string)
	local lastErr
	for attempt = 1, RETRIES do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastErr = result
		warn(string.format("[DataService] %s failed (attempt %d): %s", label, attempt, tostring(result)))
		if attempt < RETRIES then
			task.wait(2 ^ attempt)
		end
	end
	return false, lastErr
end

-- Copies the profile onto the player so the client UI can read it.
local function sync(player: Player, data: any)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		(stats:FindFirstChild("Cash") :: IntValue).Value = data.Cash;
		(stats:FindFirstChild("Climbs") :: IntValue).Value = data.Climbs
	end
	for id, lvl in data.Boosts do
		player:SetAttribute("Boost_" .. id, lvl)
	end
	player:SetAttribute("Chalk", data.Chalk)
	player:SetAttribute("Streak", data.Streak)
	player:SetAttribute("BestHeight", math.floor(data.BestHeight))
	for _, cb in changedCallbacks do
		task.spawn(cb, player, data)
	end
end

local function makeLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local climbs = Instance.new("IntValue")
	climbs.Name = "Climbs"
	climbs.Parent = stats
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = stats
	stats.Parent = player
end

function DataService.load(player: Player): any
	makeLeaderstats(player)
	local persistent = false
	local saved = nil

	if store then
		local key = keyFor(player)
		for attempt = 1, RETRIES do
			local lockedElsewhere = false
			local ok, err = withRetries("load " .. key, function()
				return (store :: DataStore):UpdateAsync(key, function(old)
					old = old or {}
					local lock = old._lock
					lockedElsewhere = lock ~= nil
						and lock.job ~= game.JobId
						and os.time() - (lock.time or 0) < LOCK_TIMEOUT
						and attempt < RETRIES -- last attempt takes over the lock
					if lockedElsewhere then
						return nil -- cancel the write; try again shortly
					end
					saved = old
					old._lock = { job = game.JobId, time = os.time() }
					return old
				end)
			end)
			if not ok then
				warn("[DataService] could not load", player.Name, err)
				break
			end
			if not lockedElsewhere then
				persistent = true
				break
			end
			task.wait(5)
		end
	end

	if not player.Parent then
		-- Left while loading: hand the lock back so their next server isn't kept waiting.
		if persistent and store then
			pcall(function()
				(store :: DataStore):UpdateAsync(keyFor(player), function(old)
					if old and old._lock and old._lock.job == game.JobId then
						old._lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return nil
	end

	local data = Rules.reconcileProfile(Config.Boosts, Config.Chalk, saved)
	profiles[player] = { data = data, persistent = persistent, dirty = false }
	sync(player, data)
	player:SetAttribute("DataLoaded", true)
	player:SetAttribute("DataPersistent", persistent)
	return data
end

function DataService.get(player: Player): any?
	local profile = profiles[player]
	return profile and profile.data
end

function DataService.isLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

-- Mutate a player's data through `fn`; changes are mirrored to the client.
function DataService.update(player: Player, fn: (any) -> ())
	local profile = profiles[player]
	if not profile then
		return false
	end
	fn(profile.data)
	profile.dirty = true
	sync(player, profile.data)
	return true
end

function DataService.onChanged(cb: (Player, any) -> ())
	table.insert(changedCallbacks, cb)
end

function DataService.save(player: Player, release: boolean)
	local profile = profiles[player]
	if not profile or not profile.persistent or not store then
		return
	end
	if not profile.dirty and not release then
		return
	end
	local key = keyFor(player)
	local snapshot = table.clone(profile.data)
	snapshot.Boosts = table.clone(profile.data.Boosts)
	local ok = withRetries("save " .. key, function()
		return (store :: DataStore):UpdateAsync(key, function(old)
			old = old or {}
			local lock = old._lock
			if lock and lock.job ~= game.JobId and os.time() - (lock.time or 0) < LOCK_TIMEOUT then
				-- Another server took this profile over; don't clobber its data.
				return nil
			end
			snapshot._lock = if release then nil else { job = game.JobId, time = os.time() }
			return snapshot
		end)
	end)
	if ok then
		profile.dirty = false
	end
	if orderedStore then
		pcall(function()
			(orderedStore :: OrderedDataStore):SetAsync(tostring(player.UserId), profile.data.Climbs)
		end)
	end
end

function DataService.release(player: Player)
	DataService.save(player, true)
	profiles[player] = nil
end

function DataService.start()
	Players.PlayerRemoving:Connect(function(player)
		DataService.release(player)
	end)

	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in profiles do
				task.spawn(DataService.save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

DataService.orderedStore = function()
	return orderedStore
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">EnvironmentService</string>
          <string name="Source"><![CDATA[-- Day/night cycle, blinking aviation lights, street lights and wind gusts.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Shared.Remotes)

local EnvironmentService = {}

local function isNight(clock: number): boolean
	return clock < 6.3 or clock > 17.7
end

local function setStreetLights(on: boolean)
	for _, head in CollectionService:GetTagged("StreetLight") do
		local light = head:FindFirstChildWhichIsA("Light")
		if light then
			light.Enabled = on
		end
		(head :: BasePart).Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
	-- A scattering of skyscraper windows glow at night.
	for _, window in CollectionService:GetTagged("NightWindow") do
		(window :: BasePart).Transparency = if on then 0 else 1
	end
end

function EnvironmentService.start()
	-- Advance the clock a few times a second rather than every frame: ClockTime
	-- replicates to every client, so per-frame writes are needless traffic.
	local hoursPerSecond = 24 / Config.DayLengthSeconds
	local wasNight: boolean? = nil
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.25)
			local now = os.clock()
			Lighting.ClockTime = (Lighting.ClockTime + (now - last) * hoursPerSecond) % 24
			last = now
			local night = isNight(Lighting.ClockTime)
			if night ~= wasNight then
				wasNight = night
				setStreetLights(night)
			end
		end
	end)

	-- Aviation lights: slow red blink, like the real thing.
	task.spawn(function()
		local on = true
		while true do
			task.wait(if on then 1.2 else 0.8)
			on = not on
			for _, bulb in CollectionService:GetTagged("AviationLight") do
				local light = bulb:FindFirstChildOfClass("PointLight")
				if light then
					light.Enabled = on
				end
				(bulb :: BasePart).Transparency = if on then 0 else 0.6
			end
		end
	end)

	-- Wind gusts: warn everyone, then blow. Clients apply the effect to themselves.
	local gust = Remotes.get("Gust")
	local rng = Random.new()
	task.spawn(function()
		while true do
			task.wait(rng:NextNumber(Config.Wind.MinInterval, Config.Wind.MaxInterval))
			local angle = rng:NextNumber(0, math.pi * 2)
			local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
			gust:FireAllClients("warn", dir, Config.Wind.WarningTime)
			task.wait(Config.Wind.WarningTime)
			gust:FireAllClients("start", dir, Config.Wind.Duration)
		end
	end)
end

return EnvironmentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[-- Fills the plaza leaderboard with the all-time top climbers. Falls back to the
-- players in this server when the OrderedDataStore isn't available (Studio).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}

local ROWS = 10
local nameCache: { [number]: string } = {}

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = if ok then name else "Player " .. userId
	nameCache[userId] = result
	return result
end

local function buildBoard(part: BasePart): ({ TextLabel }, TextLabel)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 80)
	title.Font = Enum.Font.GothamBlack
	title.Text = "TOP CLIMBERS"
	title.TextColor3 = Color3.fromRGB(255, 210, 60)
	title.TextScaled = true
	title.Parent = gui
	local subtitle = Instance.new("TextLabel")
	subtitle.BackgroundTransparency = 1
	subtitle.Position = UDim2.fromOffset(0, 80)
	subtitle.Size = UDim2.new(1, 0, 0, 30)
	subtitle.Font = Enum.Font.GothamMedium
	subtitle.Text = ""
	subtitle.TextColor3 = Color3.fromRGB(160, 170, 190)
	subtitle.TextScaled = true
	subtitle.Parent = gui
	local rows = {}
	for i = 1, ROWS do
		local row = Instance.new("TextLabel")
		row.BackgroundTransparency = if i % 2 == 0 then 1 else 0.85
		row.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		row.BorderSizePixel = 0
		row.Position = UDim2.new(0, 20, 0, 120 + (i - 1) * 42)
		row.Size = UDim2.new(1, -40, 0, 40)
		row.Font = Enum.Font.GothamBold
		row.TextColor3 = if i == 1 then Color3.fromRGB(255, 215, 80) else Color3.new(1, 1, 1)
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Text = ""
		row.Parent = gui
		rows[i] = row
	end
	gui.Parent = part
	return rows, subtitle
end

local function render(rows: { TextLabel }, entries: { { name: string, climbs: number } })
	for i, row in rows do
		local entry = entries[i]
		row.Text = if entry then string.format("  #%d  %s  -  %d climbs", i, entry.name, entry.climbs) else ""
	end
end

local function localEntries(): { { name: string, climbs: number } }
	local entries = {}
	for _, player in Players:GetPlayers() do
		local data = DataService.get(player)
		if data then
			table.insert(entries, { name = player.DisplayName, climbs = data.Climbs })
		end
	end
	table.sort(entries, function(a, b)
		return a.climbs > b.climbs
	end)
	return entries
end

function LeaderboardService.start(board: BasePart)
	local rows, subtitle = buildBoard(board)
	task.spawn(function()
		while true do
			local store = DataService.orderedStore()
			local entries = nil
			if store then
				local ok, pages = pcall(function()
					return store:GetSortedAsync(false, ROWS)
				end)
				if ok then
					entries = {}
					for _, item in pages:GetCurrentPage() do
						local userId = tonumber(item.key)
						if userId then
							table.insert(entries, { name = nameFor(userId), climbs = item.value })
						end
					end
				end
			end
			if entries and #entries > 0 then
				subtitle.Text = "All-time tower climbs"
				render(rows, entries)
			else
				subtitle.Text = "Climbs in this server"
				render(rows, localEntries())
			end
			task.wait(Config.LeaderboardRefresh)
		end
	end)
	-- Keep the local fallback lively between store refreshes.
	DataService.onChanged(function()
		if subtitle.Text == "Climbs in this server" then
			render(rows, localEntries())
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="18">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: builds the world and starts every service.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Remotes = require(Shared.Remotes)

Remotes.create()

local WorldBuilder = require(script.Parent.WorldBuilder)
local DataService = require(script.Parent.DataService)
local ClimbService = require(script.Parent.ClimbService)
local RagdollService = require(script.Parent.RagdollService)
local ShopService = require(script.Parent.ShopService)
local EnvironmentService = require(script.Parent.EnvironmentService)
local LeaderboardService = require(script.Parent.LeaderboardService)

local world, towers = WorldBuilder.build()

-- Keep the spawn pad on the plaza even if someone moved it in Studio.
local spawn = Workspace:FindFirstChildOfClass("SpawnLocation")
local spawnCFrame = if spawn then spawn.CFrame + Vector3.new(0, 4, 0) else WorldBuilder.PlazaSpawn

DataService.start()
ClimbService.start(towers, spawnCFrame)
RagdollService.start()
ShopService.start()
EnvironmentService.start()
LeaderboardService.start(world:FindFirstChild("Leaderboard") :: BasePart)

local notify = Remotes.get("Notify")

local function onPlayer(player: Player)
	local data = DataService.load(player)
	if not data then
		return
	end
	ClimbService.equipTrail(player)
	if not player:GetAttribute("DataPersistent") then
		notify:FireClient(player, "Toast", {
			text = "Saving is off here (publish the place and enable API access to keep progress).",
			style = "bad",
		})
	end

	local today = math.floor(os.time() / 86400)
	local streak, reward, claimed = Rules.dailyReward(Config.Daily, data.LastDaily, data.Streak, today)
	if not claimed then
		DataService.update(player, function(d)
			d.LastDaily = today
			d.Streak = streak
			d.Cash += reward
		end)
		notify:FireClient(player, "Daily", { streak = streak, reward = reward })
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayer, player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">RagdollService</string>
          <string name="Source"><![CDATA[-- Server half of the ragdoll: swaps Motor6Ds for BallSocketConstraints so every
-- client sees the floppy body, and applies fall damage when the player gets up.
-- The owning client puts its Humanoid into the Physics state (it owns the
-- character's physics).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local RagdollService = {}

type RagdollState = {
	character: Model,
	startY: number,
	startedAt: number,
	motors: { Motor6D },
	created: { Instance },
	collisions: { [BasePart]: boolean },
}

local states: { [Player]: RagdollState } = {}
local ROOT_JOINTS = { Root = true, RootJoint = true }

local function enableRagdoll(character: Model): ({ Motor6D }, { Instance }, { [BasePart]: boolean })
	local motors, created, collisions = {}, {}, {}
	for _, motor in character:GetDescendants() do
		if motor:IsA("Motor6D") and not ROOT_JOINTS[motor.Name] and motor.Part0 and motor.Part1 then
			local a0 = Instance.new("Attachment")
			a0.Name = "RagdollA0"
			a0.CFrame = motor.C0
			a0.Parent = motor.Part0
			local a1 = Instance.new("Attachment")
			a1.Name = "RagdollA1"
			a1.CFrame = motor.C1
			a1.Parent = motor.Part1
			local socket = Instance.new("BallSocketConstraint")
			socket.Name = "RagdollSocket"
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.LimitsEnabled = true
			socket.UpperAngle = 70
			socket.TwistLimitsEnabled = true
			socket.TwistLowerAngle = -50
			socket.TwistUpperAngle = 50
			socket.Parent = motor.Part0
			motor.Enabled = false
			table.insert(motors, motor)
			table.insert(created, a0)
			table.insert(created, a1)
			table.insert(created, socket)
		end
	end
	for _, part in character:GetChildren() do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			collisions[part] = part.CanCollide
			part.CanCollide = true
		end
	end
	return motors, created, collisions
end

local function disableRagdoll(state: RagdollState)
	for _, motor in state.motors do
		if motor.Parent then
			motor.Enabled = true
		end
	end
	for _, inst in state.created do
		inst:Destroy()
	end
	for part, canCollide in state.collisions do
		if part.Parent then
			part.CanCollide = canCollide
		end
	end
end

local function rootOf(character: Model): BasePart?
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function RagdollService.set(player: Player, ragdolled: boolean, claimedStartY: number?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and rootOf(character)
	if not character or not humanoid or not root then
		return
	end
	local state = states[player]

	if ragdolled and not state then
		if humanoid.Health <= 0 then
			return
		end
		-- Trust the client's fall start only within sane bounds (it can only lie
		-- in its own disfavour by more than this).
		local y = root.Position.Y
		local startY = if typeof(claimedStartY) == "number" and claimedStartY == claimedStartY
			then math.clamp(claimedStartY, y, y + 1500)
			else y
		local motors, created, collisions = enableRagdoll(character)
		states[player] = {
			character = character,
			startY = startY,
			startedAt = os.clock(),
			motors = motors,
			created = created,
			collisions = collisions,
		}
	elseif not ragdolled and state then
		states[player] = nil
		if state.character ~= character then
			return
		end
		disableRagdoll(state)
		local data = DataService.get(player)
		local damage = Rules.fallDamage(Config.Fall, Config.Boosts, data and data.Boosts or {}, state.startY - root.Position.Y)
		if damage > 0 and humanoid.Health > 0 then
			humanoid:TakeDamage(damage)
			Remotes.get("Notify"):FireClient(player, "Hurt", { damage = math.floor(damage) })
		end
	end
end

function RagdollService.start()
	local lastCall: { [Player]: number } = {}
	Remotes.get("Ragdoll").OnServerEvent:Connect(function(player, ragdolled, startY)
		if typeof(ragdolled) ~= "boolean" then
			return
		end
		local now = os.clock()
		if ragdolled and now - (lastCall[player] or 0) < 0.25 then
			return
		end
		lastCall[player] = now
		RagdollService.set(player, ragdolled, if typeof(startY) == "number" then startY else nil)
	end)

	local function onCharacter(player: Player, character: Model)
		states[player] = nil -- old body is gone; nothing to restore
		local humanoid = character:WaitForChild("Humanoid") :: Humanoid
		humanoid.Died:Connect(function()
			-- Ragdoll Engine-style limp death instead of falling apart.
			if not states[player] and character.Parent then
				enableRagdoll(character)
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
		lastCall[player] = nil
	end)

	-- Failsafe: a client that never sends "get up" still gets its joints back.
	task.spawn(function()
		while true do
			task.wait(1)
			for player, state in states do
				if os.clock() - state.startedAt > Config.Fall.MaxRagdollTime + 5 then
					RagdollService.set(player, false)
				end
			end
		end
	end)
end

return RagdollService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Server-authoritative purchases. Clients only ask; every check happens here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local DataService = require(script.Parent.DataService)

local ShopService = {}

local RATE_LIMIT = 0.2
local lastCall: { [Player]: number } = {}

local function allowed(player: Player): boolean
	local now = os.clock()
	if now - (lastCall[player] or 0) < RATE_LIMIT then
		return false
	end
	lastCall[player] = now
	return DataService.isLoaded(player)
end

local function toast(player: Player, text: string, style: string)
	Remotes.get("Notify"):FireClient(player, "Toast", { text = text, style = style })
end

function ShopService.start()
	Remotes.get("BuyBoost").OnServerEvent:Connect(function(player, boostId)
		if typeof(boostId) ~= "string" or #boostId > 32 or not allowed(player) then
			return
		end
		local data = DataService.get(player)
		local def = Rules.boostDef(Config.Boosts, boostId)
		if not data or not def then
			return
		end
		local result = Rules.canBuyBoost(Config.Boosts, boostId, data.Boosts[boostId] or 0, data.Cash)
		if not result.ok then
			toast(player, result.reason :: string, "bad")
			return
		end
		DataService.update(player, function(d)
			d.Cash -= result.cost :: number
			d.Boosts[boostId] = (d.Boosts[boostId] or 0) + 1
		end)
		toast(player, string.format("%s upgraded to level %d!", def.Name, data.Boosts[boostId]), "good")
	end)

	Remotes.get("BuyChalk").OnServerEvent:Connect(function(player)
		if not allowed(player) then
			return
		end
		local data = DataService.get(player)
		if not data then
			return
		end
		local result = Rules.canBuyChalk(Config.Chalk, data.Chalk, data.Cash)
		if not result.ok then
			toast(player, result.reason :: string, "bad")
			return
		end
		DataService.update(player, function(d)
			d.Cash -= result.cost :: number
			d.Chalk += 1
		end)
		toast(player, "Bought chalk (" .. data.Chalk .. " in bag)", "good")
	end)

	Remotes.get("UseChalk").OnServerEvent:Connect(function(player)
		if not allowed(player) then
			return
		end
		local data = DataService.get(player)
		if not data then
			return
		end
		local now = Workspace:GetServerTimeNow()
		if (player:GetAttribute("ChalkUntil") or 0) > now then
			return -- already chalked up; don't waste one
		end
		if data.Chalk <= 0 then
			toast(player, "No chalk left - buy some at the shop", "bad")
			return
		end
		DataService.update(player, function(d)
			d.Chalk -= 1
		end)
		player:SetAttribute("ChalkUntil", now + Config.Chalk.Duration)
	end)

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
	end)
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">TowerBuilder</string>
          <string name="Source"><![CDATA[-- Procedural towers for Grip & Lunge climbing (no ladders).
--
-- Climbable surfaces carry the "Climbable" tag; the client climbing controller
-- raycasts against them. Anything solid that sticks out from a climbable wall
-- (platforms, balconies) blocks you, and you mantle onto it to rest.
--
-- Telecom towers follow real self-supporting lattice towers: four tapering
-- legs, X-bracing, a railed rest platform on top of every section, dishes,
-- panel antennas and aviation lights. Each face of each section has an
-- invisible climb panel lying in the lattice face, so you climb the lattice.
--
-- Skyscrapers are glass towers with a frame grid, a railed maintenance balcony
-- every `BalconyEvery` studs (the only rest spots), rooftop AC units, an
-- optional helipad, and windows that light up at night.

local Build = require(script.Parent.Build)

local TowerBuilder = {}

local WHITE = Color3.fromRGB(235, 235, 235)
local CONCRETE = Color3.fromRGB(170, 168, 160)
local MAX_PART = 2000 -- Roblox parts are capped at 2048 studs per side

local FACES = {
	Vector3.new(0, 0, -1), -- face 0 points at the path
	Vector3.new(1, 0, 0),
	Vector3.new(0, 0, 1),
	Vector3.new(-1, 0, 0),
}

local function faceDir(f: number): Vector3
	return FACES[f % 4 + 1]
end

-- CFrame in tower space where local X points out of face `o`, Y is up and Z runs
-- along the face. (u, v, y) = (outward, along-face, height).
local function faceCF(towerCF: CFrame, o: Vector3, u: number, v: number, y: number): CFrame
	local along = o:Cross(Vector3.yAxis)
	return towerCF * CFrame.fromMatrix(o * u + along * v + Vector3.new(0, y, 0), o, Vector3.yAxis)
end

local function liftKiosk(model: Model, cf: CFrame)
	local kiosk = Build.part(model, {
		Name = "Lift",
		Size = Vector3.new(4, 7, 4),
		CFrame = cf * CFrame.new(0, 3.5, 0),
		Color = Color3.fromRGB(40, 45, 55),
		Material = Enum.Material.DiamondPlate,
	})
	Build.part(model, {
		Name = "LiftLamp",
		Size = Vector3.new(4.2, 0.4, 4.2),
		CFrame = cf * CFrame.new(0, 7.2, 0),
		Color = Color3.fromRGB(80, 255, 140),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LiftPrompt"
	prompt.ActionText = "Ride down"
	prompt.ObjectText = "Service lift"
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = kiosk
	return kiosk
end

local function zones(model: Model, towerCF: CFrame, baseHalf: number, peakY: number, peakHalf: number)
	Build.part(model, {
		Name = "BaseZone",
		Size = Vector3.new(baseHalf * 2, 12, baseHalf * 2),
		CFrame = towerCF * CFrame.new(0, 6, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	Build.part(model, {
		Name = "PeakZone",
		Size = Vector3.new(peakHalf * 2, 10, peakHalf * 2),
		CFrame = towerCF * CFrame.new(0, peakY + 5, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
end

-- Railing around a square platform/balcony of half-size p whose top is at y.
local function railing(model: Model, towerCF: CFrame, p: number, y: number, props: { [string]: any }, postEvery: number)
	for f = 0, 3 do
		local o = faceDir(f)
		local rail = {
			Name = "Rail",
			Size = Vector3.new(0.3, 0.3, p * 2),
			CFrame = faceCF(towerCF, o, p - 0.15, 0, y + 3),
		}
		for k, v in props do
			rail[k] = v
		end
		Build.part(model, rail)
		for v = -p, p, postEvery do
			local post = {
				Name = "RailPost",
				Size = Vector3.new(0.3, 3, 0.3),
				CFrame = faceCF(towerCF, o, p - 0.15, v, y + 1.5),
				CanCollide = false,
				CanQuery = false,
			}
			for k, val in props do
				if post[k] == nil then
					post[k] = val
				end
			end
			Build.part(model, post)
		end
	end
end

-- Telecom lattice tower --------------------------------------------------------

local function buildTelecom(model: Model, towerCF: CFrame, def: any): (number, number)
	local S, n = def.SectionHeight, def.Sections
	local H = S * n
	local paint = Color3.fromRGB(def.Color[1], def.Color[2], def.Color[3])
	local overhang = 4

	local function hw(y: number): number
		return def.BaseHalfWidth + (def.TopHalfWidth - def.BaseHalfWidth) * (y / H)
	end
	local function corner(o: Vector3, side: number, y: number): Vector3
		local along = o:Cross(Vector3.yAxis)
		local h = hw(y)
		return towerCF:PointToWorldSpace(o * h + along * (side * h) + Vector3.new(0, y, 0))
	end

	for k = 0, n - 1 do
		local bottom, top = k * S, (k + 1) * S
		local band = if k % 2 == 0 then paint else WHITE
		local metal = { Color = band, Material = Enum.Material.Metal }

		for f = 0, 3 do
			local o = faceDir(f)
			-- Leg on this face's left corner (four faces -> four legs).
			local leg = Build.beam(model, corner(o, -1, bottom), corner(o, -1, top), 1.4, metal)
			leg.CanCollide = true

			-- X-bracing about every 10 studs, plus a horizontal girt.
			local panels = math.max(1, math.floor(S / 10))
			local panelH = S / panels
			for j = 0, panels - 1 do
				local y0, y1 = bottom + j * panelH, bottom + (j + 1) * panelH
				Build.beam(model, corner(o, -1, y0), corner(o, 1, y1), 0.5, metal)
				Build.beam(model, corner(o, 1, y0), corner(o, -1, y1), 0.5, metal)
				Build.beam(model, corner(o, -1, y0), corner(o, 1, y0), 0.5, metal)
			end

			-- Invisible climb panel lying in the (tapered) lattice face.
			local along = o:Cross(Vector3.yAxis)
			local b = o * hw(bottom) + Vector3.new(0, bottom, 0)
			local t = o * hw(top) + Vector3.new(0, top, 0)
			local slope = t - b
			local normal = slope:Cross(along).Unit
			local width = hw(bottom) + hw(top) -- average full width
			Build.part(model, {
				Name = "ClimbFace",
				Size = Vector3.new(1, slope.Magnitude, width),
				CFrame = towerCF * CFrame.fromMatrix((b + t) / 2 - normal * 0.5, normal, slope.Unit),
				Transparency = 1,
				Tags = { "Climbable" },
			})
		end

		-- Rest platform on top of the section, sticking out past the lattice so
		-- climbers bump into it and mantle up.
		local p = hw(top) + overhang
		Build.part(model, {
			Name = "Platform",
			Size = Vector3.new(p * 2, 1, p * 2),
			CFrame = towerCF * CFrame.new(0, top - 0.5, 0),
			Color = Color3.fromRGB(120, 124, 130),
			Material = Enum.Material.DiamondPlate,
			Attributes = { Checkpoint = true },
		})
		railing(model, towerCF, p, top, { Color = Color3.fromRGB(255, 220, 60), Material = Enum.Material.Metal }, 12)

		-- Microwave dishes on a couple of faces per section.
		if k > 0 and k < n - 1 and k % 2 == 1 then
			for _, f in { k % 4, (k + 2) % 4 } do
				local o = faceDir(f)
				local y = bottom + S * 0.45
				Build.part(model, {
					Name = "Dish",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(1, 7, 7),
					CFrame = faceCF(towerCF, o, hw(y) + 2.2, hw(y) * 0.45, y),
					Color = WHITE,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					CanQuery = false,
				})
			end
		end
		-- Aviation lights every few sections, like the real thing.
		if k % 3 == 2 then
			for _, c in { { 1, 1 }, { -1, -1 } } do
				Build.aviationLight(model, towerCF:PointToWorldSpace(Vector3.new(c[1] * (p - 0.5), top + 0.8, c[2] * (p - 0.5))), 1.2)
			end
		end
	end

	-- Panel antennas just under the summit.
	for f = 0, 3 do
		local o = faceDir(f)
		local y = H - S * 0.4
		for _, side in { -1, 1 } do
			Build.part(model, {
				Name = "PanelAntenna",
				Size = Vector3.new(0.6, 6, 1.6),
				CFrame = faceCF(towerCF, o, hw(y) + 1, side * hw(y) * 0.6, y),
				Color = WHITE,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				CanQuery = false,
			})
		end
	end

	-- Summit: service lift in the middle with the antenna mast on its roof.
	liftKiosk(model, towerCF * CFrame.new(0, H, 0))
	local mastHeight = math.clamp(H * 0.06, 14, 60)
	Build.cylinder(model, towerCF:PointToWorldSpace(Vector3.new(0, H + 7 + mastHeight / 2, 0)), mastHeight, 1, {
		Name = "Antenna",
		Color = paint,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	Build.aviationLight(model, towerCF:PointToWorldSpace(Vector3.new(0, H + 7 + mastHeight + 0.8, 0)), 2)

	return H, hw(H) + overhang
end

-- Glass skyscraper -----------------------------------------------------------------

local function buildSkyscraper(model: Model, towerCF: CFrame, def: any): (number, number)
	local H, h, every = def.Height, def.HalfWidth, def.BalconyEvery
	local glass = Color3.fromRGB(def.Color[1], def.Color[2], def.Color[3])
	local frame = Color3.fromRGB(def.Frame[1], def.Frame[2], def.Frame[3])
	local rng = Random.new(H + h) -- deterministic window pattern per tower
	local balconyDepth = 4

	-- Facade, in segments (part size limit) between balconies.
	for y0 = 0, H - every, every do
		local seg = math.min(every, MAX_PART)
		Build.part(model, {
			Name = "Facade",
			Size = Vector3.new(h * 2, seg, h * 2),
			CFrame = towerCF * CFrame.new(0, y0 + seg / 2, 0),
			Color = glass,
			Material = Enum.Material.Glass,
			Reflectance = 0.2,
			Tags = { "Climbable" },
		})

		-- Corner columns and vertical mullions.
		for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
			Build.part(model, {
				Name = "Column",
				Size = Vector3.new(2.4, seg, 2.4),
				CFrame = towerCF * CFrame.new(c[1] * (h - 0.8), y0 + seg / 2, c[2] * (h - 0.8)),
				Color = frame,
				Material = Enum.Material.Concrete,
				CanQuery = false,
			})
		end
		local count = math.floor(h * 2 / 9)
		local spacing = h * 2 / count
		for f = 0, 3 do
			local o = faceDir(f)
			for i = 1, count - 1 do
				Build.part(model, {
					Name = "Mullion",
					Size = Vector3.new(0.5, seg, 0.6),
					CFrame = faceCF(towerCF, o, h + 0.2, -h + i * spacing, y0 + seg / 2),
					Color = frame,
					Material = Enum.Material.Metal,
					CanCollide = false,
					CanQuery = false,
					CanTouch = false,
				})
			end
		end
		-- Floor bands every 15 studs.
		for y = y0 + 15, y0 + seg - 5, 15 do
			Build.part(model, {
				Name = "FloorBand",
				Size = Vector3.new(h * 2 + 0.6, 1, h * 2 + 0.6),
				CFrame = towerCF * CFrame.new(0, y, 0),
				Color = frame,
				Material = Enum.Material.Concrete,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			})
		end
		-- A few windows that light up at night.
		for _ = 1, 6 do
			local f = rng:NextInteger(0, 3)
			local y = y0 + rng:NextInteger(1, math.floor(seg / 15) - 1) * 15 - 7.5
			local v = -h + (rng:NextInteger(1, count) - 0.5) * spacing
			Build.part(model, {
				Name = "NightWindow",
				Size = Vector3.new(0.2, 11, spacing - 1.2),
				CFrame = faceCF(towerCF, faceDir(f), h + 0.05, v, y),
				Color = Color3.fromRGB(255, 214, 120),
				Material = Enum.Material.Neon,
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				Tags = { "NightWindow" },
			})
		end

		-- Maintenance balcony on top of this segment (the roof for the last one).
		local top = y0 + seg
		if top < H then
			local p = h + balconyDepth
			Build.part(model, {
				Name = "Balcony",
				Size = Vector3.new(p * 2, 1, p * 2),
				CFrame = towerCF * CFrame.new(0, top - 0.5, 0),
				Color = CONCRETE,
				Material = Enum.Material.Concrete,
				Attributes = { Checkpoint = true },
			})
			railing(model, towerCF, p, top, {
				Color = Color3.fromRGB(180, 210, 230),
				Material = Enum.Material.Glass,
				Transparency = 0.4,
			}, 10)
		end
	end

	-- Lobby doors facing the path.
	local front = faceDir(0)
	Build.part(model, {
		Name = "Doors",
		Size = Vector3.new(0.4, 10, 12),
		CFrame = faceCF(towerCF, front, h + 0.25, 0, 5),
		Color = Color3.fromRGB(20, 25, 30),
		Material = Enum.Material.Glass,
		Reflectance = 0.4,
		CanQuery = false,
	})
	Build.part(model, {
		Name = "Canopy",
		Size = Vector3.new(5, 0.6, 18),
		CFrame = faceCF(towerCF, front, h + 2.5, 0, 12),
		Color = frame,
		Material = Enum.Material.Metal,
		CanCollide = false, -- decorative: it would otherwise stop climbers above the doors
		CanQuery = false,
	})

	-- Roof slab and a climbable parapet you climb over onto the roof.
	Build.part(model, {
		Name = "Roof",
		Size = Vector3.new(h * 2 + 1, 1, h * 2 + 1),
		CFrame = towerCF * CFrame.new(0, H - 0.5, 0),
		Color = Color3.fromRGB(110, 112, 118),
		Material = Enum.Material.Concrete,
		Attributes = { Checkpoint = true },
	})
	for f = 0, 3 do
		Build.part(model, {
			Name = "Parapet",
			Size = Vector3.new(1, 2, h * 2 + 1),
			CFrame = faceCF(towerCF, faceDir(f), h, 0, H + 1),
			Color = frame,
			Material = Enum.Material.Concrete,
			Tags = { "Climbable" },
		})
	end

	-- Rooftop AC units, kept well away from the edges so mantling is never blocked.
	local spots = { { -0.45, -0.45 }, { 0.45, -0.45 }, { -0.45, 0.45 }, { 0.45, 0.45 }, { 0, -0.5 } }
	for i, s in spots do
		if not def.Helipad or i <= 4 then
			local pos = Vector3.new(s[1] * h, H, s[2] * h)
			Build.part(model, {
				Name = "ACUnit",
				Size = Vector3.new(7, 4, 6),
				CFrame = towerCF * CFrame.new(pos + Vector3.new(0, 2, 0)),
				Color = Color3.fromRGB(200, 202, 205),
				Material = Enum.Material.Metal,
			})
			Build.cylinder(model, towerCF:PointToWorldSpace(pos + Vector3.new(0, 4.1, 0)), 0.2, 4.5, {
				Name = "ACFan",
				Color = Color3.fromRGB(60, 62, 66),
				Material = Enum.Material.Metal,
				CanCollide = false,
			})
		end
	end

	if def.Helipad then
		local d = math.min(h * 2 - 30, 30)
		Build.cylinder(model, towerCF:PointToWorldSpace(Vector3.new(0, H + 0.1, 0)), 0.2, d, {
			Name = "Helipad",
			Color = Color3.fromRGB(45, 47, 52),
			Material = Enum.Material.Asphalt,
			CanCollide = false,
		})
		Build.cylinder(model, towerCF:PointToWorldSpace(Vector3.new(0, H + 0.15, 0)), 0.2, d - 3, {
			Name = "HelipadRing",
			Color = Color3.fromRGB(240, 240, 240),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
		Build.cylinder(model, towerCF:PointToWorldSpace(Vector3.new(0, H + 0.2, 0)), 0.2, d - 5, {
			Name = "HelipadInner",
			Color = Color3.fromRGB(45, 47, 52),
			Material = Enum.Material.Asphalt,
			CanCollide = false,
		})
		for _, spec in { { -3, 0, 1.5, 11 }, { 3, 0, 1.5, 11 }, { 0, 0, 4.5, 1.5 } } do
			Build.part(model, {
				Name = "HelipadH",
				Size = Vector3.new(spec[3], 0.1, spec[4]),
				CFrame = towerCF * CFrame.new(spec[1], H + 0.3, spec[2]),
				Color = Color3.fromRGB(240, 240, 240),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			})
		end
	end
	for _, c in { { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } } do
		Build.aviationLight(model, towerCF:PointToWorldSpace(Vector3.new(c[1] * (h - 0.8), H + 2.8, c[2] * (h - 0.8))), 1.4)
	end
	liftKiosk(model, towerCF * CFrame.new(0, H, if def.Helipad then h * 0.55 else 0))
	return H, h + 0.5
end

-- Public -------------------------------------------------------------------------

-- Builds one tower. `lotHalf` is the half-size of its fenced lot (used for the
-- base zone and for the client to know which tower you're on).
function TowerBuilder.build(parent: Instance, entry: any, def: any, towerCF: CFrame, lotHalf: number): Model
	local model = Instance.new("Model")
	model.Name = entry.Name

	local height, peakHalf
	if def.Kind == "Telecom" then
		height, peakHalf = buildTelecom(model, towerCF, def)
	else
		height, peakHalf = buildSkyscraper(model, towerCF, def)
	end
	zones(model, towerCF, lotHalf - 2, height, peakHalf)

	model:SetAttribute("TowerId", entry.Name)
	model:SetAttribute("DisplayName", entry.Name)
	model:SetAttribute("Difficulty", entry.Difficulty)
	model:SetAttribute("Kind", def.Kind)
	model:SetAttribute("Height", height)
	model:SetAttribute("Payout", def.Payout)
	model:SetAttribute("DrainMultiplier", def.DrainMultiplier)
	model:SetAttribute("Slippery", def.Slippery)
	model:SetAttribute("Radius", lotHalf)
	model.WorldPivot = towerCF
	model.Parent = parent
	return model
end

return TowerBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- Builds the island map from the top-down design (north = -Z):
--
--   SPAWN / PLAZA (gate, planter, signposts, boards)
--   west column: Skyscraper 1 / 2 / 3      east column: Tutorial / Telecom 1 / 2
--   a dirt path down the middle with branches into each fenced tower lot
--   POWER UP SHOP at the south end
--   all on a fenced, tree-covered cliff island in the sea.
--
-- The island's grass top is at y = 0. Idempotent: if Workspace already has the
-- World/Towers folders (baked into the place), they are reused.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Build = require(script.Parent.Build)
local TowerBuilder = require(script.Parent.TowerBuilder)

local WorldBuilder = {}

local M = Config.Map
local PLAZA = Vector3.new(M.PlazaCenter[1], 0, M.PlazaCenter[2])
local SHOP = Vector3.new(M.ShopCenter[1], 0, M.ShopCenter[2])
local PATH_TOP = PLAZA.Z + 80
local PATH_BOTTOM = SHOP.Z - 80

local DIRT = Color3.fromRGB(196, 140, 86)
local GRASS = Color3.fromRGB(96, 160, 64)
local WOOD = Color3.fromRGB(120, 78, 45)
local DARK_WOOD = Color3.fromRGB(85, 55, 32)
local IRON = Color3.fromRGB(38, 40, 46)
local DIFFICULTY_COLORS = {
	EASY = Color3.fromRGB(90, 230, 110),
	NORMAL = Color3.fromRGB(255, 205, 60),
	HARD = Color3.fromRGB(255, 70, 60),
}

-- Rectangles (x0, z0, x1, z1) that trees and rocks must stay out of.
local keepClear: { { number } } = {}
local function reserve(x0: number, z0: number, x1: number, z1: number)
	table.insert(keepClear, { math.min(x0, x1), math.min(z0, z1), math.max(x0, x1), math.max(z0, z1) })
end
local function isClear(x: number, z: number, margin: number): boolean
	for _, r in keepClear do
		if x > r[1] - margin and x < r[3] + margin and z > r[2] - margin and z < r[4] + margin then
			return false
		end
	end
	return true
end

local function flat(world: Instance, name: string, x0: number, z0: number, x1: number, z1: number, y: number, color: Color3, material: Enum.Material)
	return Build.part(world, {
		Name = name,
		Size = Vector3.new(math.abs(x1 - x0), 0.4, math.abs(z1 - z0)),
		CFrame = CFrame.new((x0 + x1) / 2, y - 0.2, (z0 + z1) / 2),
		Color = color,
		Material = material,
	})
end

-- Props ----------------------------------------------------------------------------

local function lamp(world: Instance, pos: Vector3)
	Build.part(world, {
		Name = "LampPost",
		Size = Vector3.new(0.6, 11, 0.6),
		CFrame = CFrame.new(pos + Vector3.new(0, 5.5, 0)),
		Color = IRON,
		Material = Enum.Material.Metal,
	})
	local head = Build.part(world, {
		Name = "LampHead",
		Size = Vector3.new(1.6, 2, 1.6),
		CFrame = CFrame.new(pos + Vector3.new(0, 12, 0)),
		Color = Color3.fromRGB(255, 200, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Tags = { "StreetLight" },
	})
	local light = Instance.new("PointLight")
	light.Range = 26
	light.Brightness = 1.6
	light.Color = Color3.fromRGB(255, 190, 120)
	light.Enabled = false
	light.Parent = head
end

local function tree(world: Instance, rng: Random, pos: Vector3, scale: number)
	local trunkH = 7 * scale
	Build.cylinder(world, pos + Vector3.new(0, trunkH / 2, 0), trunkH, 1.6 * scale, {
		Name = "Trunk",
		Color = DARK_WOOD,
		Material = Enum.Material.Wood,
	})
	-- Low-poly canopy: a few rotated green blocks.
	local greens = { Color3.fromRGB(70, 150, 50), Color3.fromRGB(90, 170, 60), Color3.fromRGB(60, 130, 45) }
	for i = 1, 3 do
		local s = (9 - i * 1.5) * scale
		Build.part(world, {
			Name = "Leaves",
			Size = Vector3.new(s, s * 0.9, s),
			CFrame = CFrame.new(pos + Vector3.new(rng:NextNumber(-1, 1), trunkH + (i - 0.5) * 3 * scale, rng:NextNumber(-1, 1)))
				* CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, math.pi), rng:NextNumber(-0.3, 0.3)),
			Color = greens[rng:NextInteger(1, #greens)],
			Material = Enum.Material.Grass,
			CanQuery = false,
		})
	end
end

local function rock(world: Instance, rng: Random, pos: Vector3, size: number)
	Build.part(world, {
		Name = "Rock",
		Size = Vector3.new(size, size * rng:NextNumber(0.6, 1), size * rng:NextNumber(0.8, 1.2)),
		CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi), rng:NextNumber(-0.4, 0.4)),
		Color = Color3.fromRGB(120, 124, 132):Lerp(Color3.fromRGB(90, 92, 100), rng:NextNumber()),
		Material = Enum.Material.Slate,
	})
end

local function bench(world: Instance, cf: CFrame)
	Build.part(world, { Name = "BenchSeat", Size = Vector3.new(6, 0.5, 2), CFrame = cf * CFrame.new(0, 1.8, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
	Build.part(world, { Name = "BenchBack", Size = Vector3.new(6, 2, 0.4), CFrame = cf * CFrame.new(0, 3, 0.9), Color = WOOD, Material = Enum.Material.WoodPlanks })
	for _, x in { -2.5, 2.5 } do
		Build.part(world, { Name = "BenchLeg", Size = Vector3.new(0.4, 1.8, 1.8), CFrame = cf * CFrame.new(x, 0.9, 0), Color = IRON, Material = Enum.Material.Metal })
	end
end

-- Straight fence between two points. Gaps are left where `gaps` (positions
-- along the fence, in studs from `a`, with half-widths) say so.
local function fence(world: Instance, a: Vector3, b: Vector3, style: string, gaps: { { number } }?)
	local dir = (b - a).Unit
	local length = (b - a).Magnitude
	local wood = style == "wood"
	local color = if wood then WOOD else IRON
	local material = if wood then Enum.Material.Wood else Enum.Material.Metal
	local step = if wood then 10 else 8
	local function inGap(d: number): boolean
		for _, g in (gaps or {}) :: { { number } } do
			if math.abs(d - g[1]) < g[2] then
				return true
			end
		end
		return false
	end
	local segStart: number? = nil
	local function rail(d0: number, d1: number)
		if d1 - d0 < 0.5 then
			return
		end
		local heights: { number } = if wood then { 1.6, 3.2 } else { 1, 3.6 }
		for _, h in heights do
			Build.part(world, {
				Name = "FenceRail",
				Size = Vector3.new(if wood then 0.5 else 0.25, if wood then 0.6 else 0.25, d1 - d0),
				CFrame = CFrame.lookAt(a + dir * ((d0 + d1) / 2), b) * CFrame.new(0, h, 0),
				Color = color,
				Material = material,
			})
		end
		if not wood then
			-- iron fences get thin pickets
			for d = d0 + 2, d1 - 1, 4 do
				Build.part(world, {
					Name = "Picket",
					Size = Vector3.new(0.15, 4, 0.15),
					CFrame = CFrame.new(a + dir * d + Vector3.new(0, 2, 0)),
					Color = color,
					Material = material,
					CanCollide = false,
					CanQuery = false,
				})
			end
		end
	end
	local d = 0
	while d <= length do
		local gap = inGap(d)
		if not gap then
			Build.part(world, {
				Name = "FencePost",
				Size = Vector3.new(if wood then 1 else 0.5, if wood then 4.2 else 4.6, if wood then 1 else 0.5),
				CFrame = CFrame.new(a + dir * d + Vector3.new(0, if wood then 2.1 else 2.3, 0)),
				Color = color,
				Material = material,
			})
			segStart = segStart or d
		elseif segStart then
			rail(segStart, d - step)
			segStart = nil
		end
		local nextD = d + step
		if not gap and segStart and (nextD > length or inGap(nextD)) then
			rail(segStart, d)
			segStart = nil
		end
		d = nextD
	end
end

local function sign(world: Instance, cf: CFrame, width: number, height: number, lines: { any }, color: Color3?)
	local board = Build.part(world, {
		Name = "Sign",
		Size = Vector3.new(width, height, 0.5),
		CFrame = cf,
		Color = color or Color3.fromRGB(25, 28, 36),
		Material = if color then Enum.Material.WoodPlanks else Enum.Material.SmoothPlastic,
	})
	Build.surfaceText(board, lines)
	return board
end

-- Wooden signpost board at `pos`, readable from the north (spawn side), with a
-- diamond tip pointing the real direction: "west", "east" or "south".
local function arrowBoard(world: Instance, pos: Vector3, text: string, direction: string)
	local cf = CFrame.new(pos) -- Front face (-Z) looks north
	sign(world, cf, 16, 2.6, { { text = text, size = 80, color = Color3.fromRGB(255, 240, 210), font = Enum.Font.GothamBlack } }, WOOD)
	local tip = if direction == "west" then CFrame.new(-8.6, 0, 0) elseif direction == "east" then CFrame.new(8.6, 0, 0) else CFrame.new(0, -1.9, 0)
	Build.part(world, {
		Name = "ArrowTip",
		Size = Vector3.new(1.84, 1.84, 0.5),
		CFrame = cf * tip * CFrame.Angles(0, 0, math.rad(45)),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
	})
end

-- Island --------------------------------------------------------------------------

local function buildIsland(world: Instance, rng: Random)
	local hx, hz = M.IslandHalfX, M.IslandHalfZ
	Build.part(world, {
		Name = "Water",
		Size = Vector3.new(2000, 1, 2000),
		CFrame = CFrame.new(0, M.WaterLevel, 0),
		Color = Color3.fromRGB(40, 140, 210),
		Material = Enum.Material.Glass,
		Transparency = 0.15,
		Reflectance = 0.2,
		Locked = true,
	})
	Build.part(world, {
		Name = "IslandTop",
		Size = Vector3.new(hx * 2, 10, hz * 2),
		CFrame = CFrame.new(0, -5, 0),
		Color = GRASS,
		Material = Enum.Material.Grass,
		Locked = true,
	})
	local depth = -M.WaterLevel + 10
	Build.part(world, {
		Name = "IslandCliff",
		Size = Vector3.new(hx * 2 - 6, depth, hz * 2 - 6),
		CFrame = CFrame.new(0, -10 - depth / 2, 0),
		Color = Color3.fromRGB(110, 100, 92),
		Material = Enum.Material.Slate,
		Locked = true,
	})
	-- Rocky cliff chunks around the shore.
	for _, side in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		local alongZ = side[1] ~= 0
		local span = if alongZ then hz else hx
		for t = -span, span, 26 do
			local pos = if alongZ
				then Vector3.new(side[1] * (hx + rng:NextNumber(-2, 8)), rng:NextNumber(-60, -6), t + rng:NextNumber(-8, 8))
				else Vector3.new(t + rng:NextNumber(-8, 8), rng:NextNumber(-60, -6), side[2] * (hz + rng:NextNumber(-2, 8)))
			rock(world, rng, pos, rng:NextNumber(22, 40))
		end
	end
	-- Wooden perimeter fence, open at the north gate.
	local inset = 6
	fence(world, Vector3.new(-hx + inset, 0, -hz + inset), Vector3.new(hx - inset, 0, -hz + inset), "wood", { { hx - inset, 12 } })
	fence(world, Vector3.new(hx - inset, 0, -hz + inset), Vector3.new(hx - inset, 0, hz - inset), "wood")
	fence(world, Vector3.new(hx - inset, 0, hz - inset), Vector3.new(-hx + inset, 0, hz - inset), "wood", { { hx - inset, 12 } })
	fence(world, Vector3.new(-hx + inset, 0, hz - inset), Vector3.new(-hx + inset, 0, -hz + inset), "wood")
end

-- Plaza ------------------------------------------------------------------------------

local function buildPlaza(world: Instance)
	local x0, x1, z0, z1 = PLAZA.X - 160, PLAZA.X + 160, PLAZA.Z - 120, PLAZA.Z + 80
	reserve(x0, z0, x1, z1)
	flat(world, "Plaza", x0, z0, x1, z1, 0.4, Color3.fromRGB(214, 196, 160), Enum.Material.Pavement)
	-- Path out of the north gate to the island edge.
	flat(world, "GatePath", -12, -M.IslandHalfZ, 12, z0, 0.35, Color3.fromRGB(190, 175, 150), Enum.Material.Cobblestone)
	reserve(-14, -M.IslandHalfZ, 14, z0)

	-- "SPAWN / PLAZA" wooden arch over the north entrance.
	local gateZ = z0 + 4
	for _, x in { -14, 14 } do
		Build.part(world, { Name = "GatePost", Size = Vector3.new(2.5, 20, 2.5), CFrame = CFrame.new(x, 10, gateZ), Color = DARK_WOOD, Material = Enum.Material.Wood })
	end
	Build.part(world, { Name = "GateBeam", Size = Vector3.new(34, 2, 2.5), CFrame = CFrame.new(0, 20, gateZ), Color = DARK_WOOD, Material = Enum.Material.Wood })
	sign(world, CFrame.new(0, 17, gateZ + 1.5) * CFrame.Angles(0, math.pi, 0), 24, 4.5, {
		{ text = "SPAWN / PLAZA", size = 120, color = Color3.fromRGB(255, 240, 210) },
	}, WOOD)

	-- Central planter with a tree, benches around it.
	local planter = PLAZA + Vector3.new(0, 0, 10)
	Build.cylinder(world, planter + Vector3.new(0, 1, 0), 2, 26, { Name = "Planter", Color = Color3.fromRGB(150, 146, 140), Material = Enum.Material.Cobblestone })
	Build.cylinder(world, planter + Vector3.new(0, 2.05, 0), 0.2, 23, { Name = "PlanterSoil", Color = Color3.fromRGB(90, 140, 60), Material = Enum.Material.Grass })
	tree(world, Random.new(7), planter + Vector3.new(0, 2, 0), 1.2)
	for i = 0, 3 do
		local a = i * math.pi / 2 + math.pi / 4
		local p = planter + Vector3.new(math.cos(a), 0, math.sin(a)) * 19
		bench(world, CFrame.lookAt(p, planter) * CFrame.Angles(0, math.pi, 0))
	end

	-- Signposts: west and east.
	local westPost = PLAZA + Vector3.new(-70, 0, 40)
	Build.part(world, { Name = "SignPole", Size = Vector3.new(1.2, 14, 1.2), CFrame = CFrame.new(westPost + Vector3.new(0, 7, 0)), Color = DARK_WOOD, Material = Enum.Material.Wood })
	arrowBoard(world, westPost + Vector3.new(0, 12.5, -0.9), "SKYSCRAPERS", "west")
	arrowBoard(world, westPost + Vector3.new(0, 8.5, -0.9), "POWER UPS", "south")
	local eastPost = PLAZA + Vector3.new(70, 0, 40)
	Build.part(world, { Name = "SignPole", Size = Vector3.new(1.2, 14, 1.2), CFrame = CFrame.new(eastPost + Vector3.new(0, 7, 0)), Color = DARK_WOOD, Material = Enum.Material.Wood })
	arrowBoard(world, eastPost + Vector3.new(0, 12.5, -0.9), "TELECOM TOWERS", "east")
	arrowBoard(world, eastPost + Vector3.new(0, 8.5, -0.9), "TUTORIAL TOWER", "east")

	-- How-to-play and leaderboard boards along the north side, facing south.
	local face = CFrame.Angles(0, math.pi, 0)
	sign(world, CFrame.new(PLAZA + Vector3.new(-105, 7, -70)) * face, 18, 11, {
		{ text = "HOW TO CLIMB", size = 64, color = Color3.fromRGB(255, 210, 60) },
		{ text = "SPACE at a tower: grab on", size = 34, color = Color3.new(1, 1, 1), font = Enum.Font.GothamMedium },
		{ text = "WASD: crawl  ·  SPACE: lunge up  ·  Q: let go", size = 34, color = Color3.new(1, 1, 1), font = Enum.Font.GothamMedium },
		{ text = "Climbing burns stamina. Mantle onto platforms to breathe.", size = 34, color = Color3.new(1, 1, 1), font = Enum.Font.GothamMedium },
		{ text = "Run out and you BLACK OUT and fall.", size = 34, color = Color3.fromRGB(255, 120, 120), font = Enum.Font.GothamMedium },
		{ text = "SPACE while falling: catch the wall!", size = 34, color = Color3.fromRGB(110, 230, 140), font = Enum.Font.GothamBold },
	})
	Build.part(world, {
		Name = "Leaderboard",
		Size = Vector3.new(16, 14, 0.5),
		CFrame = CFrame.new(PLAZA + Vector3.new(105, 8, -70)) * face,
		Color = Color3.fromRGB(20, 22, 30),
		Material = Enum.Material.SmoothPlastic,
	})
	for _, x in { -6, 6 } do
		for _, board in { { -105, 1.2 }, { 105, 1 } } do
			Build.part(world, {
				Name = "BoardLeg",
				Size = Vector3.new(0.6, 2, 0.6),
				CFrame = CFrame.new(PLAZA + Vector3.new(board[1] + x, 1, -69.6)),
				Color = IRON,
				Material = Enum.Material.Metal,
			})
		end
	end

	for _, p in { { -140, -100 }, { 140, -100 }, { -140, 60 }, { 140, 60 }, { -40, -40 }, { 40, -40 } } do
		lamp(world, PLAZA + Vector3.new(p[1], 0.4, p[2]))
	end
end

-- Paths and tower lots ---------------------------------------------------------------

local function towerCFrame(entry: any): CFrame
	local pos = Vector3.new(entry.X, 0, entry.Z)
	-- Face 0 (local -Z) looks at the main path.
	return CFrame.lookAt(pos, Vector3.new(0, 0, entry.Z))
end

local function buildPaths(world: Instance)
	local w = M.PathHalfWidth
	flat(world, "MainPath", -w, PATH_TOP - 4, w, PATH_BOTTOM + 4, 0.3, DIRT, Enum.Material.Ground)
	reserve(-w, PATH_TOP, w, PATH_BOTTOM)
	for z = PATH_TOP + 30, PATH_BOTTOM - 20, 70 do
		lamp(world, Vector3.new(-w - 4, 0, z))
		lamp(world, Vector3.new(w + 4, 0, z + 35))
	end
	for z = PATH_TOP + 120, PATH_BOTTOM - 60, 160 do
		bench(world, CFrame.new(-w - 6, 0, z) * CFrame.Angles(0, -math.pi / 2, 0))
		bench(world, CFrame.new(w + 6, 0, z + 80) * CFrame.Angles(0, math.pi / 2, 0))
	end
	for _, entry in Config.Layout do
		local side = if entry.X < 0 then -1 else 1
		local lotEdge = math.abs(entry.X) - M.LotHalf
		flat(world, "BranchPath", side * w, entry.Z - 9, side * lotEdge, entry.Z + 9, 0.3, DIRT, Enum.Material.Ground)
		reserve(side * w, entry.Z - 10, side * lotEdge, entry.Z + 10)
	end
end

local function buildLot(world: Instance, rng: Random, entry: any, def: any)
	local L = M.LotHalf
	local c = Vector3.new(entry.X, 0, entry.Z)
	reserve(c.X - L, c.Z - L, c.X + L, c.Z + L)
	flat(world, "LotPad", c.X - L, c.Z - L, c.X + L, c.Z + L, 0.2, Color3.fromRGB(150, 140, 128), Enum.Material.Concrete)

	-- Iron fence with a gate facing the path.
	local gateSide = if entry.X < 0 then 1 else -1 -- +1: east edge has the gate
	local corners = {
		Vector3.new(c.X - L, 0, c.Z - L),
		Vector3.new(c.X + L, 0, c.Z - L),
		Vector3.new(c.X + L, 0, c.Z + L),
		Vector3.new(c.X - L, 0, c.Z + L),
	}
	for i = 1, 4 do
		local a, b = corners[i], corners[i % 4 + 1]
		local isGateEdge = (gateSide == 1 and i == 2) or (gateSide == -1 and i == 4)
		fence(world, a, b, "iron", if isGateEdge then { { L, 12 } } else nil)
	end

	-- Utility boxes / equipment shelter.
	local back = -gateSide
	Build.part(world, {
		Name = "Shelter",
		Size = Vector3.new(14, 9, 12),
		CFrame = CFrame.new(c + Vector3.new(back * (L - 12), 4.5, L - 14)),
		Color = Color3.fromRGB(215, 215, 210),
		Material = Enum.Material.Concrete,
	})
	Build.part(world, {
		Name = "UtilityBox",
		Size = Vector3.new(5, 6, 3),
		CFrame = CFrame.new(c + Vector3.new(back * (L - 8), 3, -(L - 10))),
		Color = if entry.Difficulty == "HARD" then Color3.fromRGB(200, 50, 40) else Color3.fromRGB(110, 115, 125),
		Material = Enum.Material.Metal,
	})
	for _, z in { -L + 6, L - 6 } do
		lamp(world, c + Vector3.new(gateSide * (L - 6), 0.2, z))
	end
	rock(world, rng, c + Vector3.new(back * (L - 6), 1, rng:NextNumber(-20, 20)), 5)

	-- Name + difficulty sign by the gate, facing the path.
	local signPos = c + Vector3.new(gateSide * (L + 8), 0, -22)
	local facing = CFrame.lookAt(signPos, Vector3.new(0, 0, signPos.Z))
	for _, x in { -4, 4 } do
		Build.part(world, { Name = "SignLeg", Size = Vector3.new(0.6, 5, 0.6), CFrame = facing * CFrame.new(x, 2.5, 0.3), Color = IRON, Material = Enum.Material.Metal })
	end
	sign(world, facing * CFrame.new(0, 8, 0), 14, 7, {
		{ text = string.upper(entry.Name), size = 70, color = Color3.new(1, 1, 1) },
		{ text = entry.Size .. "  (" .. entry.Difficulty .. ")", size = 56, color = DIFFICULTY_COLORS[entry.Difficulty] or Color3.new(1, 1, 1) },
		{ text = "$" .. def.Payout .. "  ·  drain x" .. def.DrainMultiplier, size = 40, color = Color3.fromRGB(170, 180, 200), font = Enum.Font.GothamBold },
	})
end

-- Shop --------------------------------------------------------------------------------

local function buildShop(world: Instance)
	local s = SHOP
	local x0, x1, z0, z1 = s.X - 110, s.X + 110, s.Z - 70, s.Z + 90
	reserve(x0, z0, x1, z1)
	flat(world, "ShopYard", x0, z0, x1, z1, 0.4, Color3.fromRGB(205, 170, 120), Enum.Material.WoodPlanks)

	-- Fence with string lights, open to the north (path) side.
	fence(world, Vector3.new(x0, 0, z0), Vector3.new(x1, 0, z0), "wood", { { 110, 16 } })
	fence(world, Vector3.new(x1, 0, z0), Vector3.new(x1, 0, z1), "wood")
	fence(world, Vector3.new(x1, 0, z1), Vector3.new(x0, 0, z1), "wood", { { 110, 12 } })
	fence(world, Vector3.new(x0, 0, z1), Vector3.new(x0, 0, z0), "wood")
	for x = x0 + 5, x1 - 5, 7 do
		for _, z in { z0, z1 } do
			Build.part(world, {
				Name = "StringLight",
				Shape = Enum.PartType.Ball,
				Size = Vector3.one * 0.7,
				CFrame = CFrame.new(x, 4.6, z),
				Color = Color3.fromRGB(255, 220, 140),
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
				Tags = { "StreetLight" },
			})
		end
	end

	-- The stall, facing north toward the path.
	local stallCF = CFrame.new(s + Vector3.new(0, 0, 25))
	local counter = Build.part(world, {
		Name = "ShopStall",
		Size = Vector3.new(30, 5, 6),
		CFrame = stallCF * CFrame.new(0, 2.5, -6),
		Color = Color3.fromRGB(150, 100, 60),
		Material = Enum.Material.WoodPlanks,
	})
	Build.part(world, { Name = "StallBack", Size = Vector3.new(32, 16, 2), CFrame = stallCF * CFrame.new(0, 8, 6), Color = Color3.fromRGB(130, 85, 50), Material = Enum.Material.WoodPlanks })
	for _, x in { -15, 15 } do
		Build.part(world, { Name = "StallPost", Size = Vector3.new(1.4, 16, 1.4), CFrame = stallCF * CFrame.new(x, 8, -8), Color = DARK_WOOD, Material = Enum.Material.Wood })
	end
	-- Yellow and white striped awning.
	for i = 0, 7 do
		Build.part(world, {
			Name = "Awning",
			Size = Vector3.new(4.2, 0.5, 15),
			CFrame = stallCF * CFrame.new(-14.7 + i * 4.2, 14, -1) * CFrame.Angles(math.rad(14), 0, 0),
			Color = if i % 2 == 0 then Color3.fromRGB(255, 205, 40) else Color3.fromRGB(250, 250, 245),
			Material = Enum.Material.Fabric,
		})
	end
	sign(world, stallCF * CFrame.new(0, 19, 5.5) * CFrame.Angles(0, math.pi, 0), 26, 6, {
		{ text = "POWER UP SHOP", size = 130, color = Color3.fromRGB(255, 215, 50) },
		{ text = "BUY POWER UPS", size = 70, color = Color3.fromRGB(255, 255, 255), font = Enum.Font.GothamBold },
	}, Color3.fromRGB(90, 55, 30))
	-- Giant lemon on the roof.
	Build.part(world, {
		Name = "Lemon",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 7,
		CFrame = stallCF * CFrame.new(0, 26, 5),
		Color = Color3.fromRGB(255, 220, 40),
		Material = Enum.Material.SmoothPlastic,
	})
	Build.part(world, {
		Name = "LemonLeaf",
		Size = Vector3.new(3.5, 0.4, 1.6),
		CFrame = stallCF * CFrame.new(2.5, 29.5, 5) * CFrame.Angles(0, 0, math.rad(25)),
		Color = Color3.fromRGB(80, 170, 60),
		Material = Enum.Material.SmoothPlastic,
	})
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ShopPrompt"
	prompt.ActionText = "Open shop"
	prompt.ObjectText = "Power Up Shop"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = counter

	-- Picnic tables with yellow umbrellas.
	for _, x in { -60, 60 } do
		local t = s + Vector3.new(x, 0, -20)
		Build.part(world, { Name = "Table", Size = Vector3.new(8, 0.6, 5), CFrame = CFrame.new(t + Vector3.new(0, 3, 0)), Color = WOOD, Material = Enum.Material.WoodPlanks })
		Build.part(world, { Name = "TableLeg", Size = Vector3.new(1, 3, 1), CFrame = CFrame.new(t + Vector3.new(0, 1.5, 0)), Color = DARK_WOOD, Material = Enum.Material.Wood })
		for _, dz in { -4.5, 4.5 } do
			Build.part(world, { Name = "TableBench", Size = Vector3.new(8, 0.5, 1.6), CFrame = CFrame.new(t + Vector3.new(0, 1.8, dz)), Color = WOOD, Material = Enum.Material.WoodPlanks })
		end
		Build.part(world, { Name = "UmbrellaPole", Size = Vector3.new(0.4, 11, 0.4), CFrame = CFrame.new(t + Vector3.new(0, 5.5, 0)), Color = Color3.new(1, 1, 1), Material = Enum.Material.Metal, CanCollide = false })
		Build.cylinder(world, t + Vector3.new(0, 11, 0), 0.8, 14, { Name = "Umbrella", Color = Color3.fromRGB(255, 210, 40), Material = Enum.Material.Fabric, CanCollide = false })
	end
	for _, x in { -100, 100 } do
		for _, z in { z0 + 10, z1 - 10 } do
			lamp(world, Vector3.new(x, 0.4, z))
		end
	end
end

-- Scenery ---------------------------------------------------------------------------

local function scatterTrees(world: Instance, rng: Random)
	local hx, hz = M.IslandHalfX - 14, M.IslandHalfZ - 14
	for x = -hx, hx, 34 do
		for z = -hz, hz, 34 do
			local px, pz = x + rng:NextNumber(-9, 9), z + rng:NextNumber(-9, 9)
			if math.abs(px) < hx and math.abs(pz) < hz and isClear(px, pz, 8) then
				if rng:NextNumber() < 0.75 then
					tree(world, rng, Vector3.new(px, 0, pz), rng:NextNumber(0.9, 1.4))
				elseif rng:NextNumber() < 0.5 then
					rock(world, rng, Vector3.new(px, 1, pz), rng:NextNumber(4, 9))
				end
			end
		end
	end
end

-- Public -------------------------------------------------------------------------------

function WorldBuilder.build()
	local world = Workspace:FindFirstChild("World")
	local towers = Workspace:FindFirstChild("Towers")
	if not world then
		world = Instance.new("Folder")
		world.Name = "World"
		local rng = Random.new(2024)
		buildIsland(world, rng)
		buildPlaza(world)
		buildPaths(world)
		for _, entry in Config.Layout do
			buildLot(world, rng, entry, Config.TowerTypes[entry.Type])
		end
		buildShop(world)
		scatterTrees(world, rng)
		world.Parent = Workspace
	end
	if not towers then
		towers = Instance.new("Folder")
		towers.Name = "Towers"
		for _, entry in Config.Layout do
			TowerBuilder.build(towers, entry, Config.TowerTypes[entry.Type], towerCFrame(entry), M.LotHalf)
		end
		towers.Parent = Workspace
	end
	return world, towers
end

WorldBuilder.PlazaSpawn = CFrame.new(PLAZA + Vector3.new(0, 4, -60))

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="23">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">200</float>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="24">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ClimbController</string>
            <string name="Source"><![CDATA[-- Client climbing: "Grip & Lunge" wall climbing, stamina, blackouts, ragdoll
-- falls, chalk and wind.
--
-- Grip & Lunge:
--   * SPACE facing a tower (anything tagged "Climbable") grabs on. SPACE while
--     falling catches the wall, if you're not falling too fast.
--   * W/S crawl up/down, A/D sideways (touch/gamepad: push toward the wall).
--   * SPACE while climbing lunges: a fast leap up the wall that costs extra stamina.
--   * Q lets go.
--   * Anything solid sticking out of the wall (platforms, balconies) blocks you
--     and you mantle up onto it. Reaching the top of a wall mantles onto the roof.
--
-- The body is held on the wall with AlignPosition/AlignOrientation on the
-- HumanoidRootPart (the client owns its character's physics, so this replicates).
--
-- Stamina runs on the client because only the owning client knows its exact
-- climbing state every frame. That is safe: stamina only limits the player
-- themselves. Everything that has value (cash, climbs, purchases, fall damage)
-- is decided on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Rules = require(ReplicatedStorage.Shared.Rules)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Effects = require(script.Parent.Effects)

local ClimbController = {}

type Mode = "normal" | "fall" | "blackout" | "ragdoll"

local CC = Config.Climb
local ROOT_HEIGHT = 3 -- HumanoidRootPart centre above the floor when standing

local player = Players.LocalPlayer
local ragdollRemote = Remotes.get("Ragdoll")
local rng = Random.new()

local humanoid: Humanoid? = nil
local root: BasePart? = nil
local character: Model? = nil
local stamina = Config.Stamina.Base
local mode: Mode = "normal"
local ragdollTime, settleTime = 0, 0
local airPeakY: number? = nil
local freefallTime = 0
local cooldownUntil = 0
local gustUntil = 0
local gustDir = Vector3.zero
local lastGrounded = true
local lastJumpRequest = 0

-- Climb state
local climbing = false
local anchor = Vector3.zero -- where the root is held
local wallNormal = Vector3.zAxis -- horizontal, pointing out of the wall
local lungeLeft = 0
local lungeReadyAt = 0
local climbMoving = false
local alignPos: AlignPosition? = nil
local alignOri: AlignOrientation? = nil
local climbAttachment: Attachment? = nil
local climbTrack: AnimationTrack? = nil

local ui: any = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local overlapParams = OverlapParams.new()
overlapParams.FilterType = Enum.RaycastFilterType.Exclude

local function boosts(): Rules.Boosts
	local b = {}
	for _, def in Config.Boosts do
		b[def.Id] = player:GetAttribute("Boost_" .. def.Id) or 0
	end
	return b
end

local function currentTower(pos: Vector3): Model?
	local towers = Workspace:FindFirstChild("Towers")
	if not towers then
		return nil
	end
	for _, tower in towers:GetChildren() do
		local radius = tower:GetAttribute("Radius")
		if radius and tower:IsA("Model") then
			local p = tower.WorldPivot.Position
			if math.abs(pos.X - p.X) <= radius and math.abs(pos.Z - p.Z) <= radius then
				return tower
			end
		end
	end
	return nil
end

local function chalkRemaining(): number
	return math.max(0, (player:GetAttribute("ChalkUntil") or 0) - Workspace:GetServerTimeNow())
end

local function horizontal(v: Vector3): Vector3
	local h = Vector3.new(v.X, 0, v.Z)
	return if h.Magnitude > 1e-3 then h.Unit else Vector3.zAxis
end

-- Climbable wall straight "into" the wall from `origin`, or nil.
local function probeWall(origin: Vector3, normal: Vector3): RaycastResult?
	local result = Workspace:Raycast(origin + normal, -normal * (CC.WallOffset + 3), rayParams)
	if result and result.Instance:HasTag("Climbable") and math.abs(result.Normal.Y) < 0.7 then
		return result
	end
	return nil
end

-- Somewhere to stand at or just above the current hold, or nil.
local function findMantle(): Vector3?
	local inward = -wallNormal
	for _, offset in { 0, 1.5, 3, 4.5, 6 } do
		local p = anchor + inward * offset
		local top = Vector3.new(p.X, anchor.Y + CC.MantleReach, p.Z)
		local hit = Workspace:Raycast(top, Vector3.new(0, -(CC.MantleReach + 4), 0), rayParams)
		-- Stand on floors, not on climbable trim like the roof parapet.
		if
			hit
			and hit.Normal.Y > 0.7
			and hit.Instance.CanCollide
			and not hit.Instance:HasTag("Climbable")
			and hit.Position.Y > anchor.Y - ROOT_HEIGHT + 0.5
		then
			local stand = hit.Position + Vector3.new(0, ROOT_HEIGHT, 0)
			local blockers = Workspace:GetPartBoundsInBox(CFrame.new(stand + Vector3.new(0, 0.3, 0)), Vector3.new(2, 4.6, 2), overlapParams)
			local free = true
			for _, part in blockers do
				if part.CanCollide then
					free = false
					break
				end
			end
			if free then
				return stand
			end
		end
	end
	return nil
end

local function playClimbAnimation()
	local hum = humanoid
	local char = character
	if not hum or not char then
		return
	end
	if not climbTrack then
		local animate = char:FindFirstChild("Animate")
		local folder = animate and animate:FindFirstChild("climb")
		local anim = folder and folder:FindFirstChildOfClass("Animation")
		local animator = hum:FindFirstChildOfClass("Animator")
		if anim and animator then
			local ok, track = pcall(animator.LoadAnimation, animator, anim)
			if ok then
				climbTrack = track
				track.Priority = Enum.AnimationPriority.Action
			end
		end
	end
	if climbTrack and not climbTrack.IsPlaying then
		climbTrack:Play(0.15)
	end
end

local function release(push: boolean)
	if not climbing then
		return
	end
	climbing = false
	climbMoving = false
	lungeLeft = 0
	if alignPos then
		alignPos:Destroy()
		alignPos = nil
	end
	if alignOri then
		alignOri:Destroy()
		alignOri = nil
	end
	if climbAttachment then
		climbAttachment:Destroy()
		climbAttachment = nil
	end
	if climbTrack then
		climbTrack:Stop(0.2)
	end
	local hum, rootPart = humanoid, root
	if hum then
		hum.PlatformStand = false
	end
	if rootPart then
		airPeakY = rootPart.Position.Y
		if push then
			rootPart.AssemblyLinearVelocity = wallNormal * 10
		end
	end
	cooldownUntil = os.clock() + 0.3
end

local function grab(): boolean
	local hum, rootPart = humanoid, root
	if climbing or mode ~= "normal" or not hum or not rootPart or hum.Health <= 0 then
		return false
	end
	if rootPart.AssemblyLinearVelocity.Y < -CC.CatchMaxFallSpeed then
		ui.overlay:toast("Falling too fast to grab!", "bad")
		return false
	end
	local look = horizontal(rootPart.CFrame.LookVector)
	local hit: RaycastResult? = nil
	for _, height in { 0, 1.5, -1.5 } do
		local result = Workspace:Raycast(rootPart.Position + Vector3.new(0, height, 0), look * (CC.GripRange + 1), rayParams)
		if result and result.Instance:HasTag("Climbable") and math.abs(result.Normal.Y) < 0.7 then
			hit = result
			break
		end
	end
	if not hit then
		return false
	end
	local wall = hit :: RaycastResult

	wallNormal = horizontal(wall.Normal)
	anchor = wall.Position + wall.Normal * CC.WallOffset
	anchor = Vector3.new(anchor.X, rootPart.Position.Y, anchor.Z)

	local att = Instance.new("Attachment")
	att.Name = "ClimbAttachment"
	att.Parent = rootPart
	local ap = Instance.new("AlignPosition")
	ap.Mode = Enum.PositionAlignmentMode.OneAttachment
	ap.Attachment0 = att
	ap.MaxForce = 200000
	ap.Responsiveness = 60
	ap.Position = anchor
	ap.Parent = rootPart
	local ao = Instance.new("AlignOrientation")
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.MaxTorque = 200000
	ao.Responsiveness = 50
	ao.CFrame = CFrame.lookAt(anchor, anchor - wallNormal)
	ao.Parent = rootPart
	climbAttachment, alignPos, alignOri = att, ap, ao

	hum.PlatformStand = true
	rootPart.AssemblyLinearVelocity = Vector3.zero
	climbing = true
	airPeakY, freefallTime = nil, 0
	playClimbAnimation()
	Effects.sound(Config.Sounds.Grab, 0.5, 1.3)
	return true
end

local function mantle(stand: Vector3)
	local rootPart = root
	release(false)
	if rootPart then
		rootPart.CFrame = CFrame.lookAt(stand, stand - wallNormal)
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end
	local hum = humanoid
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Landed)
	end
	Effects.sound(Config.Sounds.Click, 0.35, 1.2)
end

local function enterRagdoll(kind: Mode, startY: number?)
	release(false)
	local hum, rootPart = humanoid, root
	if mode ~= "normal" or not hum or not rootPart or hum.Health <= 0 then
		return
	end
	mode = kind
	ragdollTime, settleTime = 0, 0
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	ragdollRemote:FireServer(true, startY or rootPart.Position.Y)
	-- A little tumble so it reads as a limp body, not a statue.
	rootPart:ApplyAngularImpulse(
		Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-1, 1)) * rootPart.AssemblyMass * 6
	)
	if kind == "blackout" then
		ui.overlay:blackout(true)
		Effects.sound(Config.Sounds.Bonk, 0.8)
	elseif kind == "fall" then
		Effects.sound(Config.Sounds.Fall, 0.7)
	end
end

local function exitRagdoll()
	if mode == "normal" then
		return
	end
	local wasBlackout = mode == "blackout"
	mode = "normal"
	cooldownUntil = os.clock() + 0.8
	airPeakY, freefallTime = nil, 0
	ragdollRemote:FireServer(false)
	local hum = humanoid
	if hum and hum.Health > 0 then
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		Effects.sound(Config.Sounds.GetUp, 0.6)
	end
	if wasBlackout then
		local max = Rules.maxStamina(Config.Stamina, Config.Boosts, boosts())
		stamina = math.max(stamina, max * Config.Stamina.WakeFraction)
		ui.overlay:blackout(false)
	end
end

function ClimbController.toggleRagdoll()
	if mode == "ragdoll" and ragdollTime > 0.4 then
		exitRagdoll()
	elseif mode == "normal" and root then
		enterRagdoll("ragdoll", (root :: BasePart).Position.Y)
	end
end

function ClimbController.letGo()
	release(true)
end

function ClimbController.isClimbing(): boolean
	return climbing
end

-- SPACE / jump button: grab when free, lunge when climbing.
local function onJump()
	local now = os.clock()
	if now - lastJumpRequest < 0.2 then
		return
	end
	lastJumpRequest = now
	if climbing then
		if now >= lungeReadyAt and lungeLeft <= 0 then
			local tower = root and currentTower((root :: BasePart).Position)
			local b = boosts()
			local rate = Rules.staminaRate(Config.Stamina, Config.Chalk, Config.Wind, Config.Boosts, b, {
				climbing = true,
				moving = true,
				towerMultiplier = if tower then tower:GetAttribute("DrainMultiplier") or 1 else 1,
				slippery = if tower then tower:GetAttribute("Slippery") == true else false,
				chalk = chalkRemaining() > 0,
				gust = now < gustUntil,
			}, false)
			local cost = Rules.lungeCost(CC, rate)
			if stamina > cost then
				stamina -= cost
				lungeLeft = CC.LungeDistance
				lungeReadyAt = now + CC.LungeCooldown
				Effects.sound(Config.Sounds.Click, 0.4, 0.7)
			else
				ui.overlay:toast("Too tired to lunge!", "bad")
			end
		end
	elseif mode == "normal" then
		grab()
	end
end

local function onGust(phase: string, dir: Vector3, duration: number)
	if typeof(dir) ~= "Vector3" or typeof(duration) ~= "number" then
		return
	end
	if phase == "warn" then
		ui.hud:setWind("WIND GUST INCOMING - HOLD ON!")
		task.delay(duration, function()
			if os.clock() >= gustUntil then
				ui.hud:setWind(nil)
			end
		end)
	elseif phase == "start" then
		gustUntil = os.clock() + duration
		gustDir = dir
		ui.hud:setWind("GUST! Stamina drains faster")
		task.delay(duration, function()
			if os.clock() >= gustUntil then
				ui.hud:setWind(nil)
			end
		end)
		local hum, rootPart = humanoid, root
		if not rootPart or not hum or mode ~= "normal" or rootPart.Position.Y < Config.Wind.MinHeight then
			return
		end
		Effects.shake(duration * 0.5, 0.25)
		local max = Rules.maxStamina(Config.Stamina, Config.Boosts, boosts())
		if climbing and stamina < max * Config.Wind.KnockOffFraction then
			-- Too tired to hold on: the wind rips you off the wall.
			local y = rootPart.Position.Y
			enterRagdoll("fall", y)
			rootPart:ApplyImpulse((gustDir + Vector3.new(0, 0.3, 0)) * rootPart.AssemblyMass * Config.Wind.AirPush)
			ui.overlay:toast("The wind blew you off!", "bad")
		elseif not climbing and hum.FloorMaterial == Enum.Material.Air then
			rootPart:ApplyImpulse(gustDir * rootPart.AssemblyMass * Config.Wind.AirPush)
		end
	end
end

-- Input -> (vertical, lateral) along the wall, each in [-1, 1].
local function climbInput(hum: Humanoid): (number, number)
	local W = UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up)
	local S = UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)
	local A = UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left)
	local D = UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right)
	if W or S or A or D then
		return (if W then 1 else 0) - (if S then 1 else 0), (if D then 1 else 0) - (if A then 1 else 0)
	end
	-- Touch / gamepad: push toward the wall to climb.
	local move = hum.MoveDirection
	local right = (-wallNormal):Cross(Vector3.yAxis)
	return math.clamp(move:Dot(-wallNormal), -1, 1), math.clamp(move:Dot(right), -1, 1)
end

-- Moves the hold point along the wall. Returns true if the climber mantled.
local function stepClimb(hum: Humanoid, dt: number, b: Rules.Boosts): boolean
	local vert, lat = climbInput(hum)
	local speed = Rules.climbSpeed(CC, Config.Boosts, b)
	local up = 0
	if lungeLeft > 0 then
		up = math.min(lungeLeft, CC.LungeSpeed * dt)
		lungeLeft -= up
	else
		up = vert * speed * dt
	end
	local side = lat * CC.SideSpeed * dt
	climbMoving = math.abs(up) > 1e-3 or math.abs(side) > 1e-3

	local probe = probeWall(anchor, wallNormal)
	local n = if probe then probe.Normal else wallNormal
	local wallUp = (Vector3.yAxis - n * n:Dot(Vector3.yAxis)).Unit
	local right = (-wallNormal):Cross(Vector3.yAxis)

	-- Going up: blocked by something overhead (platform / balcony) -> mantle.
	if up > 0 then
		local ceiling = Workspace:Raycast(anchor + Vector3.new(0, 2.4, 0), Vector3.new(0, up + 0.6, 0), rayParams)
		if ceiling and ceiling.Instance.CanCollide then
			local stand = findMantle()
			if stand then
				mantle(stand)
				return true
			end
			up = 0
			lungeLeft = 0
		end
	end
	-- Going down: feet reach the ground -> step off.
	if up < 0 then
		local floor = Workspace:Raycast(anchor, Vector3.new(0, -(ROOT_HEIGHT + 0.3 - up), 0), rayParams)
		if floor and floor.Normal.Y > 0.7 then
			release(false)
			return false
		end
	end

	local candidate = anchor + wallUp * up
	if up > 0 and not probeWall(candidate + Vector3.new(0, 1.5, 0), wallNormal) then
		-- The wall ends above us: climb over the top.
		local stand = findMantle()
		if stand then
			mantle(stand)
			return true
		end
		candidate = anchor
		lungeLeft = 0
	end
	local hit = probeWall(candidate, wallNormal)
	if hit then
		candidate = hit.Position + hit.Normal * CC.WallOffset
	else
		candidate = anchor
	end

	if side ~= 0 then
		local sideways = candidate + right * side
		local sideHit = probeWall(sideways, wallNormal)
		if sideHit then
			candidate = sideHit.Position + sideHit.Normal * CC.WallOffset
		end
	end

	if probe then
		wallNormal = horizontal(probe.Normal)
	end
	anchor = candidate
	local ap, ao = alignPos, alignOri
	if ap and ao then
		ap.Position = anchor
		ao.CFrame = CFrame.lookAt(anchor, anchor - wallNormal)
	end
	if climbTrack then
		climbTrack:AdjustSpeed(if climbMoving then 1 + (speed - CC.ClimbSpeed) / CC.ClimbSpeed else 0)
	end
	return false
end

local function statusFor(grounded: boolean, frac: number, nearWall: boolean): (string, Color3?)
	if mode == "blackout" then
		return "Blacked out...", Color3.fromRGB(255, 86, 86)
	elseif mode == "fall" then
		return "Falling! (SPACE to catch the wall)", Color3.fromRGB(255, 86, 86)
	elseif mode == "ragdoll" then
		return "Ragdolling (press R to get up)", Color3.fromRGB(255, 196, 46)
	elseif climbing and frac < Config.Stamina.DangerFraction then
		return "Out of breath! Get to a platform!", Color3.fromRGB(255, 86, 86)
	elseif climbing and climbMoving then
		return "Climbing...  (SPACE: lunge, Q: let go)", nil
	elseif climbing then
		return "Gripping on (still draining)", Color3.fromRGB(255, 200, 60)
	elseif nearWall then
		return "Press SPACE to grab the tower", Color3.fromRGB(255, 196, 46)
	elseif grounded and frac < 0.999 then
		return "Catching your breath...", Color3.fromRGB(88, 224, 132)
	end
	return "Ready to climb", nil
end

local function step(dt: number)
	local hum, rootPart = humanoid, root
	if not hum or not rootPart or not hum.Parent then
		return
	end
	local b = boosts()
	local max = Rules.maxStamina(Config.Stamina, Config.Boosts, b)
	stamina = math.min(stamina, max)
	local now = os.clock()

	if hum.Health <= 0 then
		release(false)
		if mode ~= "normal" then
			mode = "normal"
			ui.overlay:blackout(false)
		end
		return
	end

	local grounded = false
	local nearWall = false
	if mode ~= "normal" then
		ragdollTime += dt
		-- The Humanoid will try to stand up on its own; keep it limp.
		if hum:GetState() ~= Enum.HumanoidStateType.Physics then
			hum:ChangeState(Enum.HumanoidStateType.Physics)
		end
		local speed = rootPart.AssemblyLinearVelocity.Magnitude
		settleTime = if speed < Config.Fall.SettleSpeed then settleTime + dt else 0
		local minTime = if mode == "blackout" then Config.Fall.MinBlackoutTime else Config.Fall.MinRagdollTime
		local settled = settleTime >= Config.Fall.SettleTime
		if ragdollTime >= Config.Fall.MaxRagdollTime or (mode ~= "ragdoll" and ragdollTime >= minTime and settled) then
			exitRagdoll()
		end
	else
		if climbing then
			if stepClimb(hum, dt, b) then
				return -- mantled this frame
			end
		end
		local pos = rootPart.Position
		local state = hum:GetState()
		grounded = not climbing and hum.FloorMaterial ~= Enum.Material.Air

		-- Track how far we've fallen so a big drop turns into a ragdoll.
		if climbing or grounded then
			airPeakY, freefallTime = nil, 0
		else
			airPeakY = math.max(airPeakY or pos.Y, pos.Y)
			if state == Enum.HumanoidStateType.Freefall then
				freefallTime += dt
			end
		end
		if
			not climbing
			and freefallTime >= Config.Fall.AutoRagdollAfter
			and rootPart.AssemblyLinearVelocity.Y < -25
			and now > cooldownUntil
		then
			enterRagdoll("fall", airPeakY)
		end

		local tower = currentTower(pos)
		local ctx: Rules.DrainContext = {
			climbing = climbing,
			moving = climbMoving or lungeLeft > 0,
			towerMultiplier = if tower then tower:GetAttribute("DrainMultiplier") or 1 else 1,
			slippery = if tower then tower:GetAttribute("Slippery") == true else false,
			chalk = chalkRemaining() > 0,
			gust = now < gustUntil and pos.Y > Config.Wind.MinHeight,
		}
		local rate = Rules.staminaRate(Config.Stamina, Config.Chalk, Config.Wind, Config.Boosts, b, ctx, grounded)
		stamina = Rules.stepStamina(stamina, rate, dt, max)

		if climbing and stamina <= 0 then
			enterRagdoll("blackout", pos.Y)
		end
		if grounded and not lastGrounded and stamina < max then
			Effects.sound(Config.Sounds.Click, 0.25, 0.8)
		end
		lastGrounded = grounded

		if not climbing and tower then
			local look = horizontal(rootPart.CFrame.LookVector)
			local hit = Workspace:Raycast(pos, look * (CC.GripRange + 1), rayParams)
			nearWall = hit ~= nil and hit.Instance:HasTag("Climbable")
		end
	end

	-- HUD -----------------------------------------------------------------------
	local pos = rootPart.Position
	local frac = stamina / max
	ui.hud:setStamina(stamina, max, Config.Stamina.DangerFraction, now)
	local text, color = statusFor(grounded, frac, nearWall)
	ui.hud:setStatus(text, color)
	ui.hud:setChalk(player:GetAttribute("Chalk") or 0, math.clamp(chalkRemaining() / Config.Chalk.Duration, 0, 1))
	ui.hud:setClimbing(climbing)

	local tower = currentTower(pos)
	if tower then
		local height = tower:GetAttribute("Height") or 1
		ui.hud:setAltitude(
			pos.Y,
			tower:GetAttribute("DisplayName"),
			string.format("%s  ·  $%s  ·  drain x%s", tostring(tower:GetAttribute("Difficulty")), tostring(tower:GetAttribute("Payout")), tostring(tower:GetAttribute("DrainMultiplier"))),
			pos.Y / height
		)
	else
		ui.hud:setAltitude(pos.Y, nil, nil, nil)
	end

	local breathless = if mode == "blackout" then 1 else math.clamp(1 - frac / 0.35, 0, 1)
	Effects.setBreathless(if climbing or mode == "blackout" then breathless else breathless * 0.4)
end

local function onCharacter(char: Model)
	release(false)
	humanoid, root, character = nil, nil, nil -- stop stepping the old body while the new one loads
	climbTrack = nil
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	local rootPart = char:WaitForChild("HumanoidRootPart") :: BasePart
	humanoid, root, character = hum, rootPart, char
	rayParams.FilterDescendantsInstances = { char }
	overlapParams.FilterDescendantsInstances = { char }
	mode = "normal"
	ragdollTime, settleTime, freefallTime = 0, 0, 0
	airPeakY = nil
	cooldownUntil = os.clock() + 1.5 -- respawning at a checkpoint can start mid-air
	stamina = Rules.maxStamina(Config.Stamina, Config.Boosts, boosts())
	ui.overlay:blackout(false)
	Effects.setBreathless(0)
	hum.Died:Connect(function()
		if humanoid == hum then
			release(false)
			mode = "normal"
			ui.overlay:blackout(false)
			ui.overlay:toast("You died. Respawning...", "bad")
		end
	end)
end

function ClimbController.start(uiRefs: any)
	ui = uiRefs
	Remotes.get("Gust").OnClientEvent:Connect(onGust)
	UserInputService.JumpRequest:Connect(onJump)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	RunService.Heartbeat:Connect(step)
end

return ClimbController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Sounds, confetti, camera shake and the "out of breath" screen effect.
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Effects = {}

function Effects.sound(id: string, volume: number?, pitch: number?)
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.6
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 6)
end

function Effects.confetti(position: Vector3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = position
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 210, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 230, 130)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 160, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 110, 255)),
	})
	emitter.Size = NumberSequence.new(0.5)
	emitter.Lifetime = NumberRange.new(2, 3)
	emitter.Speed = NumberRange.new(25, 45)
	emitter.SpreadAngle = Vector2.new(70, 70)
	emitter.Acceleration = Vector3.new(0, -35, 0)
	emitter.Drag = 1.5
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-300, 300)
	emitter.LightEmission = 0.4
	emitter.Enabled = false
	emitter.Parent = anchor
	anchor.Parent = Workspace
	emitter:Emit(120)
	Debris:AddItem(anchor, 5)
end

-- Shakes the camera through Humanoid.CameraOffset (no camera scripting needed).
local shakeUntil, shakeMagnitude = 0, 0
function Effects.shake(duration: number, magnitude: number)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
	shakeMagnitude = math.max(if os.clock() < shakeUntil then shakeMagnitude else 0, magnitude)
end

-- Low stamina drains the colour from the world and blurs the edges a bit.
local breath = Instance.new("ColorCorrectionEffect")
breath.Name = "OutOfBreath"
local blur = Instance.new("BlurEffect")
blur.Name = "OutOfBreathBlur"
blur.Size = 0

function Effects.setBreathless(amount: number)
	-- amount: 0 = fine, 1 = about to black out
	breath.Saturation = -0.7 * amount
	breath.Contrast = 0.15 * amount
	breath.TintColor = Color3.new(1, 1 - 0.15 * amount, 1 - 0.15 * amount)
	blur.Size = 10 * amount * amount
end

function Effects.start()
	breath.Parent = Lighting
	blur.Parent = Lighting
	local rng = Random.new()
	RunService.RenderStepped:Connect(function()
		local character = Players.LocalPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local now = os.clock()
		if now < shakeUntil then
			local m = shakeMagnitude * math.clamp((shakeUntil - now) * 2, 0, 1)
			humanoid.CameraOffset = Vector3.new(rng:NextNumber(-m, m), rng:NextNumber(-m, m), rng:NextNumber(-m, m))
		elseif humanoid.CameraOffset ~= Vector3.zero then
			humanoid.CameraOffset = Vector3.zero
			shakeMagnitude = 0
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="28">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI, wires input and server notifications.
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Effects = require(script.Parent.Effects)
local ClimbController = require(script.Parent.ClimbController)
local Hud = require(script.Parent.UI.Hud)
local Overlay = require(script.Parent.UI.Overlay)
local Shop = require(script.Parent.UI.Shop)

local player = Players.LocalPlayer

local function useChalk()
	Remotes.get("UseChalk"):FireServer()
end

local shop
local hud = Hud.new({
	shop = function()
		shop:toggle()
	end,
	chalk = useChalk,
	ragdoll = ClimbController.toggleRagdoll,
	letGo = ClimbController.letGo,
	plaza = function()
		Remotes.get("ResetToPlaza"):FireServer()
	end,
})
shop = Shop.new({
	buyBoost = function(id)
		Remotes.get("BuyBoost"):FireServer(id)
	end,
	buyChalk = function()
		Remotes.get("BuyChalk"):FireServer()
	end,
})
local overlay = Overlay.new()

Effects.start()
ClimbController.start({ hud = hud, overlay = overlay })

-- Profile values ----------------------------------------------------------------

local stats = player:WaitForChild("leaderstats")
local cashValue = stats:WaitForChild("Cash") :: IntValue
local climbsValue = stats:WaitForChild("Climbs") :: IntValue

local function boostLevels(): { [string]: number }
	local levels = {}
	for _, def in Config.Boosts do
		levels[def.Id] = player:GetAttribute("Boost_" .. def.Id) or 0
	end
	return levels
end

local function refresh()
	hud:setCash(cashValue.Value)
	hud:setSubline(player:GetAttribute("BestHeight") or 0, player:GetAttribute("Streak") or 0)
	shop:refresh(cashValue.Value, boostLevels(), player:GetAttribute("Chalk") or 0)
end

hud:setClimbs(climbsValue.Value)
climbsValue.Changed:Connect(function(value)
	hud:setClimbs(value, true)
end)
cashValue.Changed:Connect(refresh)
player.AttributeChanged:Connect(function(name)
	if name ~= "ChalkUntil" then
		refresh()
	end
end)
refresh()

-- Input -----------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.B then
		shop:toggle()
	elseif input.KeyCode == Enum.KeyCode.C then
		useChalk()
	elseif input.KeyCode == Enum.KeyCode.Q then
		ClimbController.letGo()
	elseif input.KeyCode == Enum.KeyCode.R then
		ClimbController.toggleRagdoll()
	elseif input.KeyCode == Enum.KeyCode.P then
		Remotes.get("ResetToPlaza"):FireServer()
	elseif input.KeyCode == Enum.KeyCode.Escape and shop:isOpen() then
		shop:close()
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt)
	if prompt.Name == "ShopPrompt" then
		shop:open()
	end
end)

-- Server notifications ----------------------------------------------------------------

Remotes.get("Notify").OnClientEvent:Connect(function(kind, payload)
	if typeof(payload) ~= "table" then
		return
	end
	if kind == "Toast" then
		overlay:toast(tostring(payload.text), payload.style)
	elseif kind == "Summit" then
		overlay:showSummit(tostring(payload.tower), payload.payout or 0, payload.climbs or 0)
		Effects.sound(Config.Sounds.Summit, 0.9)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			Effects.confetti((root :: BasePart).Position + Vector3.new(0, 4, 0))
		end
	elseif kind == "Daily" then
		overlay:toast(string.format("Daily reward: +$%d  (streak %d)", payload.reward or 0, payload.streak or 0), "gold")
	elseif kind == "Unlock" then
		overlay:toast(tostring(payload.text), "gold")
	elseif kind == "Hurt" then
		overlay:hurtFlash(payload.damage or 0)
		Effects.shake(0.4, math.clamp((payload.damage or 0) / 60, 0.1, 0.6))
	end
end)

-- First-time hint.
task.delay(2, function()
	if climbsValue.Value == 0 then
		overlay:toast("Start with the Tutorial Tower: face it and press SPACE to grab on. W to climb, SPACE to lunge!", "info")
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[-- Tiny declarative helpers so the UI code reads as layout, not boilerplate.
local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local C = {}

-- C.new("Frame", { Size = ... }, { child1, child2 })
function C.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if inst:IsA("GuiObject") then
		(inst :: GuiObject).BorderSizePixel = 0
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		(inst :: any).Font = Theme.Body;
		(inst :: any).TextColor3 = Theme.Text;
		(inst :: any).BackgroundTransparency = 1
	end
	local parent = nil
	for key, value in (props or {}) :: { [string]: any } do
		if key == "Parent" then
			parent = value
		else
			(inst :: any)[key] = value
		end
	end
	for _, child in (children or {}) :: { Instance } do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

function C.corner(radius: number?): UICorner
	return C.new("UICorner", { CornerRadius = UDim.new(0, radius or Theme.Radius) })
end

function C.round(): UICorner
	return C.new("UICorner", { CornerRadius = UDim.new(1, 0) })
end

function C.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return C.new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0.85,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function C.padding(x: number, y: number?): UIPadding
	return C.new("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x),
		PaddingBottom = UDim.new(0, y or x),
	})
end

function C.gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return C.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	})
end

-- Dark glass panel used for every HUD element.
function C.panel(props: { [string]: any }, children: { Instance }?): Frame
	local merged = {
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
	}
	for k, v in props do
		merged[k] = v
	end
	local kids = { C.corner(), C.gradient(Color3.new(1, 1, 1), Color3.fromRGB(200, 205, 220)) }
	local hasStroke = false
	for _, child in (children or {}) :: { Instance } do
		hasStroke = hasStroke or child:IsA("UIStroke")
		table.insert(kids, child)
	end
	if not hasStroke then
		-- Only one UIStroke per object renders, so a custom one replaces the default.
		table.insert(kids, C.stroke())
	end
	return C.new("Frame", merged, kids)
end

function C.tween(inst: Instance, time: number, goals: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), goals)
	tween:Play()
	return tween
end

-- Button with hover lift and press squash. `onClick` fires on activation.
function C.button(props: { [string]: any }, onClick: () -> ()): TextButton
	local base = props.BackgroundColor3 or Theme.Card
	local merged = {
		BackgroundColor3 = base,
		BackgroundTransparency = 0,
		AutoButtonColor = false,
		Font = Theme.Bold,
		TextSize = 16,
	}
	for k, v in props do
		merged[k] = v
	end
	local scale = C.new("UIScale")
	local button = C.new("TextButton", merged, { C.corner(10), C.stroke(nil, 1, 0.8), scale })
	button.BackgroundTransparency = merged.BackgroundTransparency
	-- Hover only scales: callers recolour buttons (affordable / maxed) and a
	-- colour tween back to the creation colour would undo that.
	button.MouseEnter:Connect(function()
		C.tween(scale, 0.15, { Scale = 1.05 })
	end)
	button.MouseLeave:Connect(function()
		C.tween(scale, 0.15, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		C.tween(scale, 0.08, { Scale = 0.94 })
	end)
	button.MouseButton1Up:Connect(function()
		C.tween(scale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	button.Activated:Connect(onClick)
	return button
end

-- Returns a full-screen root frame whose contents scale with screen height, so
-- phones and 4K screens get the same layout. The frame is sized 1/scale and
-- then scaled by `scale`, so it always covers exactly the screen and children
-- anchored to its edges stay on the edges. Parent all UI to the returned frame.
function C.autoScale(gui: ScreenGui): Frame
	local root = C.new("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	local scale = C.new("UIScale", { Parent = root })
	local camera = workspace.CurrentCamera
	local function update()
		local s = math.clamp(camera.ViewportSize.Y / 900, 0.6, 1.25)
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	update()
	return root
end

return C
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Always-on HUD: climb counter, cash, stamina, height meter, action buttons,
-- wind warning. Setters only touch the UI when a value actually changes.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local C = require(script.Parent.Components)

local Hud = {}
Hud.__index = Hud

export type Actions = {
	shop: () -> (),
	chalk: () -> (),
	ragdoll: () -> (),
	plaza: () -> (),
	letGo: () -> (),
}

local function label(props: { [string]: any }): TextLabel
	return C.new("TextLabel", props)
end

function Hud.new(actions: Actions)
	local self = setmetatable({}, Hud)
	self._cache = {}

	local gui = C.new("ScreenGui", {
		Name = "HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local root = C.autoScale(gui)
	self.gui = gui

	-- Top centre: the climb counter ---------------------------------------------
	local climbsPanel = C.panel({
		Name = "Climbs",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(320, 64),
		Parent = root,
	}, { C.stroke(Theme.Accent, 2, 0.35) })
	self._climbScale = C.new("UIScale", { Parent = climbsPanel })
	self.climbs = label({
		Size = UDim2.new(1, 0, 0, 38),
		Position = UDim2.fromOffset(0, 6),
		Font = Theme.Title,
		Text = "Tower climbs: 0",
		TextSize = 28,
		Parent = climbsPanel,
	})
	self.subline = label({
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 42),
		Font = Theme.Body,
		Text = "Best height 0  ·  Streak 0",
		TextSize = 14,
		TextColor3 = Theme.Muted,
		Parent = climbsPanel,
	})

	-- Wind warning banner, under the counter.
	self.wind = C.panel({
		Name = "Wind",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 84),
		Size = UDim2.fromOffset(300, 36),
		BackgroundColor3 = Color3.fromRGB(40, 70, 120),
		Visible = false,
		Parent = root,
	})
	self.windText = label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Bold,
		TextSize = 17,
		Text = "",
		Parent = self.wind,
	})

	-- Top left: cash -------------------------------------------------------------
	local cashPanel = C.panel({
		Name = "Cash",
		Position = UDim2.fromOffset(16, 70),
		Size = UDim2.fromOffset(190, 48),
		Parent = root,
	})
	label({
		Size = UDim2.fromOffset(40, 48),
		Position = UDim2.fromOffset(6, 0),
		Font = Theme.Title,
		Text = "$",
		TextSize = 30,
		TextColor3 = Theme.Good,
		Parent = cashPanel,
	})
	self.cash = label({
		Size = UDim2.new(1, -50, 1, 0),
		Position = UDim2.fromOffset(40, 0),
		Font = Theme.Title,
		Text = "0",
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = cashPanel,
	})
	self._cashScale = C.new("UIScale", { Parent = cashPanel })

	-- Left: altitude meter ---------------------------------------------------------
	local meter = C.panel({
		Name = "Altitude",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, 0),
		Size = UDim2.fromOffset(150, 250),
		Parent = root,
	}, { C.padding(12) })
	label({
		Size = UDim2.new(1, 0, 0, 14),
		Font = Theme.Bold,
		Text = "ALTITUDE",
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = meter,
	})
	self.height = label({
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 16),
		Font = Theme.Title,
		Text = "0",
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = meter,
	})
	self.towerName = label({
		Size = UDim2.new(1, -24, 0, 34),
		Position = UDim2.fromOffset(0, 54),
		Font = Theme.Bold,
		Text = "Plaza",
		TextSize = 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = meter,
	})
	self.towerInfo = label({
		Size = UDim2.new(1, -24, 0, 30),
		Position = UDim2.fromOffset(0, 90),
		Font = Theme.Body,
		Text = "",
		TextSize = 12,
		TextColor3 = Theme.Muted,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = meter,
	})
	local track = C.new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Size = UDim2.new(0, 10, 1, -20),
		BackgroundColor3 = Theme.PanelLight,
		Parent = meter,
	}, { C.round() })
	self.progress = C.new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Theme.Accent,
		Parent = track,
	}, { C.round(), C.gradient(Theme.Gold, Theme.AccentDark) })
	self.progressText = label({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, 0),
		Size = UDim2.fromOffset(80, 16),
		Font = Theme.Bold,
		Text = "",
		TextSize = 13,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = meter,
	})

	-- Bottom centre: stamina --------------------------------------------------------
	local staminaPanel = C.panel({
		Name = "Stamina",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(480, 78),
		Parent = root,
	}, { C.padding(14, 10) })
	self.status = label({
		Size = UDim2.new(1, -110, 0, 20),
		Font = Theme.Bold,
		Text = "Ready to climb",
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = staminaPanel,
	})
	self.staminaText = label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(110, 20),
		Font = Theme.Bold,
		Text = "100 / 100",
		TextSize = 15,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = staminaPanel,
	})
	local bar = C.new("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = Theme.PanelLight,
		ClipsDescendants = true,
		Parent = staminaPanel,
	}, { C.round() })
	self.staminaFill = C.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.StaminaHigh,
		Parent = bar,
	}, { C.round(), C.gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)) })
	self.chalkGlow = C.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Chalk,
		BackgroundTransparency = 1,
		Parent = bar,
	}, { C.round() })
	self._barStroke = C.stroke(Theme.Bad, 2, 1)
	self._barStroke.Parent = bar

	-- Right: action buttons -------------------------------------------------------
	local column = C.new("Frame", {
		Name = "Actions",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -16, 0.5, 0),
		Size = UDim2.fromOffset(150, 320),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		C.new("UIListLayout", {
			Padding = UDim.new(0, 10),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local keyHints = not UserInputService.TouchEnabled or UserInputService.KeyboardEnabled
	local function action(order: number, text: string, key: string, color: Color3, fn: () -> ())
		return C.button({
			LayoutOrder = order,
			Size = UDim2.fromOffset(150, 52),
			BackgroundColor3 = color,
			Text = if keyHints then string.format("%s  [%s]", text, key) else text,
			TextSize = 17,
			Parent = column,
		}, fn)
	end
	action(1, "SHOP", "B", Color3.fromRGB(200, 140, 20), actions.shop)
	self.chalkButton = action(2, "CHALK x0", "C", Color3.fromRGB(70, 80, 110), actions.chalk)
	self.letGoButton = action(3, "LET GO", "Q", Color3.fromRGB(70, 80, 110), actions.letGo)
	action(4, "RAGDOLL", "R", Color3.fromRGB(150, 60, 70), actions.ragdoll)
	action(5, "TO PLAZA", "P", Color3.fromRGB(50, 110, 90), actions.plaza)

	return self
end

function Hud:_set(key: string, inst: Instance, prop: string, value: any)
	if self._cache[key] ~= value then
		self._cache[key] = value;
		(inst :: any)[prop] = value
	end
end

local function pop(scale: UIScale, amount: number)
	scale.Scale = amount
	C.tween(scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Elastic)
end

function Hud:setClimbs(n: number, animate: boolean?)
	self:_set("climbs", self.climbs, "Text", "Tower climbs: " .. Theme.formatNumber(n))
	if animate then
		pop(self._climbScale, 1.3)
	end
end

function Hud:setSubline(best: number, streak: number)
	self:_set("sub", self.subline, "Text", string.format("Best height %s  ·  Daily streak %d", Theme.formatNumber(best), streak))
end

function Hud:setCash(n: number)
	local text = Theme.formatNumber(n)
	if self._cache.cash ~= text then
		local up = (self._cache.cashValue or n) < n
		self._cache.cashValue = n
		self:_set("cash", self.cash, "Text", text)
		if up then
			pop(self._cashScale, 1.2)
		end
	end
end

function Hud:setChalk(count: number, activeFraction: number)
	self:_set("chalkCount", self.chalkButton, "Text", (self.chalkButton.Text:gsub("x%d+", "x" .. count)))
	self:_set("chalkGlow", self.chalkGlow, "BackgroundTransparency", 1 - activeFraction * 0.45)
end

-- mode: "normal" | "fall" | "blackout" | "ragdoll"
function Hud:setStamina(current: number, max: number, dangerFraction: number, time: number)
	local frac = if max > 0 then current / max else 0
	self:_set("fill", self.staminaFill, "Size", UDim2.fromScale(math.clamp(frac, 0, 1), 1))
	local color = if frac < dangerFraction
		then Theme.StaminaLow
		elseif frac < 0.5 then Theme.StaminaMid:Lerp(Theme.StaminaLow, 1 - (frac - dangerFraction) / (0.5 - dangerFraction))
		else Theme.StaminaHigh:Lerp(Theme.StaminaMid, 1 - (frac - 0.5) / 0.5)
	self.staminaFill.BackgroundColor3 = color
	self:_set("stext", self.staminaText, "Text", string.format("%d / %d", math.floor(current + 0.5), max))
	-- Pulse the outline red when you're about to black out.
	local pulse = if frac < dangerFraction then 0.5 + 0.5 * math.sin(time * 10) else 1
	self._barStroke.Transparency = pulse
end

function Hud:setStatus(text: string, color: Color3?)
	self:_set("status", self.status, "Text", text)
	self:_set("statusColor", self.status, "TextColor3", color or Theme.Text)
end

function Hud:setAltitude(y: number, towerName: string?, towerInfo: string?, progress: number?)
	self:_set("height", self.height, "Text", Theme.formatNumber(math.max(0, y)) .. " studs")
	self:_set("tower", self.towerName, "Text", towerName or "Plaza")
	self:_set("towerInfo", self.towerInfo, "Text", towerInfo or "Walk to a tower to start a climb.")
	local p = math.clamp(progress or 0, 0, 1)
	self:_set("progress", self.progress, "Size", UDim2.fromScale(1, p))
	self:_set("progressText", self.progressText, "Text", if progress then string.format("%d%%", p * 100) else "")
end

-- Highlight the LET GO button while you're on a wall.
function Hud:setClimbing(on: boolean)
	self:_set("climbing", self.letGoButton, "BackgroundColor3", if on then Color3.fromRGB(60, 130, 220) else Color3.fromRGB(70, 80, 110))
end

function Hud:setWind(text: string?)
	self.wind.Visible = text ~= nil
	if text then
		self.windText.Text = text
	end
end

return Hud
]]></string>
            </Properties>
