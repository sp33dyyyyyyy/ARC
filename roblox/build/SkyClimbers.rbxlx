    <Item class="LocalScript" referent="7">
      <Properties>
        <string name="Name">LoadingScreen</string>
        <string name="Source"><![CDATA[-- Loading screen. Lives in ReplicatedFirst so it shows before anything else
-- loads (and replaces Roblox's default one). It shows what's loading with a
-- progress bar, has a SKIP button, and fades out once the world and your save
-- are ready.
--
-- The server publishes world-building progress on Workspace (LoadStage,
-- LoadProgress, WorldReady); your save sets "DataLoaded" on your player.
-- Self-contained on purpose: nothing else is loaded this early.
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

ReplicatedFirst:RemoveDefaultLoadingScreen()

local player = Players.LocalPlayer
local ACCENT = Color3.fromRGB(255, 196, 46)
local TIPS = {
	"Walk into a tower to grab on, then hold W to climb.",
	"Press F to clip your rope in - it catches you if you fall.",
	"Hang still on a yellow rest bar to get your breath back.",
	"Skyscrapers are harder, but they pay way more.",
	"Press SPACE while climbing to dyno up to a higher hold.",
	"Rain makes every wall slippery. Chalk up with C!",
}

local function new(className: string, props: { [string]: any }, parent: Instance?): any
	local inst = Instance.new(className)
	for k, v in props do
		(inst :: any)[k] = v
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") then
		-- Text always fits its box.
		local fit = Instance.new("UITextSizeConstraint")
		fit.MaxTextSize = (inst :: TextLabel).TextSize
		fit.Parent = inst;
		(inst :: TextLabel).TextScaled = true
	end
	inst.Parent = parent
	return inst
end

local gui = new("ScreenGui", {
	Name = "LoadingScreen",
	IgnoreGuiInset = true,
	DisplayOrder = 100,
	ResetOnSpawn = false,
}, nil)

local background = new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(14, 16, 24),
	BorderSizePixel = 0,
}, gui)
new("UIGradient", {
	Color = ColorSequence.new(Color3.fromRGB(40, 60, 100), Color3.fromRGB(12, 14, 22)),
	Rotation = 90,
}, background)

local center = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.new(0.8, 0, 0, 260),
	BackgroundTransparency = 1,
}, background)
new("UISizeConstraint", { MaxSize = Vector2.new(640, 260) }, center)

new("TextLabel", {
	Size = UDim2.new(1, 0, 0, 70),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	Text = "SKY CLIMBERS",
	TextSize = 64,
	TextColor3 = ACCENT,
}, center)
local stage = new("TextLabel", {
	Position = UDim2.fromOffset(0, 96),
	Size = UDim2.new(1, -70, 0, 26),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "Starting up...",
	TextSize = 20,
	TextColor3 = Color3.fromRGB(240, 242, 248),
	TextXAlignment = Enum.TextXAlignment.Left,
}, center)
local percent = new("TextLabel", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, 0, 0, 96),
	Size = UDim2.fromOffset(70, 26),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "0%",
	TextSize = 20,
	TextColor3 = ACCENT,
	TextXAlignment = Enum.TextXAlignment.Right,
}, center)
local track = new("Frame", {
	Position = UDim2.fromOffset(0, 130),
	Size = UDim2.new(1, 0, 0, 18),
	BackgroundColor3 = Color3.fromRGB(40, 44, 58),
	BorderSizePixel = 0,
	ClipsDescendants = true,
}, center)
new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
local fill = new("Frame", {
	Size = UDim2.fromScale(0, 1),
	BackgroundColor3 = ACCENT,
	BorderSizePixel = 0,
}, track)
new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)
new("UIGradient", {
	Color = ColorSequence.new(Color3.fromRGB(255, 220, 110), Color3.fromRGB(255, 160, 30)),
}, fill)
local tip = new("TextLabel", {
	Position = UDim2.fromOffset(0, 162),
	Size = UDim2.new(1, 0, 0, 22),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamMedium,
	Text = "Tip: " .. TIPS[math.random(1, #TIPS)],
	TextSize = 16,
	TextColor3 = Color3.fromRGB(150, 158, 180),
}, center)

local skip = new("TextButton", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 204),
	Size = UDim2.fromOffset(150, 44),
	BackgroundColor3 = Color3.fromRGB(45, 52, 72),
	AutoButtonColor = true,
	Font = Enum.Font.GothamBold,
	Text = "SKIP",
	TextSize = 18,
	TextColor3 = Color3.fromRGB(240, 242, 248),
	Visible = false,
}, center)
new("UICorner", { CornerRadius = UDim.new(0, 10) }, skip)
new("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.8 }, skip)

gui.Parent = player:WaitForChild("PlayerGui")

-- Close: fade everything out, then remove the screen.
local closed = false
local function close()
	if closed then
		return
	end
	closed = true
	local info = TweenInfo.new(0.6, Enum.EasingStyle.Sine)
	for _, inst in gui:GetDescendants() do
		if inst:IsA("Frame") or inst:IsA("TextButton") then
			TweenService:Create(inst, info, { BackgroundTransparency = 1 }):Play()
		end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			TweenService:Create(inst, info, { TextTransparency = 1 }):Play()
		end
		if inst:IsA("UIStroke") then
			TweenService:Create(inst, info, { Transparency = 1 }):Play()
		end
	end
	task.delay(0.7, function()
		gui:Destroy()
	end)
end
skip.Activated:Connect(close)

-- The SKIP button appears after a moment (so a quick load just plays through).
task.delay(1.5, function()
	if not closed then
		skip.Visible = true
	end
end)


-- Progress: the world build is 90% of the bar, your save the last 10%.
local shown = 0
local readyAt: number? = nil
local connection
connection = RunService.RenderStepped:Connect(function(dt)
	if closed then
		connection:Disconnect()
		return
	end
	local worldProgress = Workspace:GetAttribute("LoadProgress")
	local worldReady = Workspace:GetAttribute("WorldReady") == true
	local dataReady = player:GetAttribute("DataLoaded") == true
	local target = (if worldReady then 1 elseif typeof(worldProgress) == "number" then worldProgress else 0) * 0.9
		+ (if dataReady then 0.1 else 0)

	local text
	if not worldReady then
		local label = Workspace:GetAttribute("LoadStage")
		text = (if typeof(label) == "string" then label else "Connecting to the server") .. "..."
	elseif not dataReady then
		text = "Loading your save..."
	else
		text = "Ready to climb!"
	end
	stage.Text = text

	-- Ease the bar toward the real progress so it fills smoothly.
	shown += (target - shown) * math.min(1, dt * 6)
	fill.Size = UDim2.fromScale(math.clamp(shown, 0, 1), 1)
	percent.Text = string.format("%d%%", math.floor(shown * 100 + 0.5))

	if worldReady and dataReady then
		readyAt = readyAt or os.clock()
		if os.clock() - (readyAt :: number) > 0.6 then
			close()
		end
	end
end)

-- Rotate tips every few seconds.
task.spawn(function()
	while not closed do
		task.wait(4)
		tip.Text = "Tip: " .. TIPS[math.random(1, #TIPS)]
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="8">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Every tunable number in the game lives here. Pure data: no Roblox APIs, so the
-- unit tests can load it outside Studio.

local Config = {}

Config.Stamina = {
	Base = 100,
	DrainPerSecond = 8, -- while actively climbing, before the tower multiplier
	HangDrainFraction = 0.25, -- gripping a wall without moving drains at 25% of climbing
	RecoverPerSecond = 22, -- standing on solid ground
	RestBarRecoveryFraction = 0.7, -- hanging still on a rest bar recovers at 70% of that
	RopeRestFraction = 0.5, -- hanging still on your clipped rope recovers at 50%
	DangerFraction = 0.2, -- HUD pulses red below this
	WakeFraction = 0.4, -- stamina you wake up with after a blackout
}

Config.Fall = {
	SafeDrop = 40, -- studs you can fall without damage
	DamagePerStud = 0.9,
	AutoRagdollAfter = 0.6, -- seconds of freefall before you go limp
	MinRagdollTime = 1.2,
	MinBlackoutTime = 2.5,
	MaxRagdollTime = 8,
	SettleSpeed = 2.5, -- body counts as landed below this speed
	SettleTime = 0.6,
}

Config.Climb = {
	BaseWalkSpeed = 16,
	-- Rock climbing: you climb in discrete moves. Each move one hand reaches for
	-- the next hold (body still), then you pull up (opposite leg pushes).
	ClimbSpeed = 9, -- average studs/second while chaining moves up
	ReachLength = 3, -- height gained per move
	ReachFraction = 0.35, -- share of a move spent reaching before the pull
	SideStep = 2.5, -- studs per traverse move
	SideSpeed = 6, -- studs/second traversing
	GripRange = 3.5, -- SPACE grabs a wall this close
	AutoGripRange = 2.4, -- walking/jumping into a wall this close grabs it
	RegrabDelay = 0.8, -- after letting go, auto-grip waits this long
	WallOffset = 1.6, -- distance kept between the body and the wall
	LungeDistance = 9, -- a leap throws you this far up the wall
	LungeSpeed = 40,
	LungeCooldown = 0.7,
	LungeCostFactor = 1.3, -- leaping costs 30% more than climbing the same distance
	CatchMaxFallSpeed = 70, -- you can only catch the wall if falling slower than this
	MantleReach = 7, -- ledges up to this far above your waist can be climbed onto
	RestBarReach = 1.6, -- hands within this of a rest bar count as resting on it
	-- Anti-cheat: nobody legitimately climbs faster than this (studs/second),
	-- so a peak touched sooner than height / this after the base is rejected.
	MaxPlausibleSpeed = 40,
}

Config.Chalk = {
	Price = 75,
	MaxHeld = 10,
	Duration = 12,
	DrainMultiplier = 0.5,
}

Config.Wind = {
	MinInterval = 110, -- roughly one gust every two minutes
	MaxInterval = 130,
	WarningTime = 4,
	Duration = 3,
	MinHeight = 60, -- gusts only matter above this height
	DrainMultiplier = 1.3,
	KnockOffFraction = 0.15, -- only climbers nearly out of stamina get blown off
	AirPush = 30,
}

Config.DayLengthSeconds = 600

-- Weather cycles between clear skies, fog and rain. Rain soaks every wall, so
-- climbing drains more stamina.
Config.Weather = {
	MinDuration = 90,
	MaxDuration = 180,
	TransitionTime = 10,
	Chances = { Clear = 0.65, Rain = 0.35 }, -- no fog
	RainDrainMultiplier = 1.25,
	States = {
		Clear = { Density = 0.06, Haze = 0, Brightness = 2.6, CloudCover = 0.45, Saturation = 0.12 },
		Rain = { Density = 0.14, Haze = 0.4, Brightness = 1.6, CloudCover = 0.9, Saturation = -0.15 },
	},
}

-- Gamepasses. `GamePassId` is the pass's ID from the Creator Dashboard; leave
-- it 0 until you create the pass (it can still be granted from the admin panel).
-- `Robux` is only the price shown in the shop. Perks are applied in Rules.
Config.GamePasses = {} :: { any }
Config.GamePasses = {
	{ Id = "VIP", Name = "VIP", Description = "Double cash from every summit.", GamePassId = 0, Robux = 199, CashMultiplier = 2 },
	{ Id = "IronLungs", Name = "Iron Lungs", Description = "+50 max stamina.", GamePassId = 0, Robux = 149, StaminaBonus = 50 },
	{ Id = "Featherweight", Name = "Featherweight", Description = "Take half fall damage.", GamePassId = 0, Robux = 99, FallDamageMultiplier = 0.5 },
}

Config.Admin = {
	MaxCodeAttempts = 5, -- per player, per window
	AttemptWindow = 600, -- seconds
	MaxAnnouncementLength = 200,
	BanStoreName = "SkyClimbers_Bans_v1",
	AnnounceTopic = "SkyClimbersAnnounce",
}

-- Emotes use the animations every Roblox avatar's Animate script already has.
-- `Anim` is the folder name inside Animate. Wave is free.
Config.Emotes = {
	{ Id = "Wave", Name = "Wave", Anim = "wave", Price = 0 },
	{ Id = "Point", Name = "Point", Anim = "point", Price = 150 },
	{ Id = "Cheer", Name = "Cheer", Anim = "cheer", Price = 300 },
	{ Id = "Laugh", Name = "Laugh", Anim = "laugh", Price = 500 },
	{ Id = "Dance", Name = "Dance", Anim = "dance", Price = 1000 },
	{ Id = "Dance2", Name = "Dance 2", Anim = "dance2", Price = 2500 },
	{ Id = "Dance3", Name = "Dance 3", Anim = "dance3", Price = 5000 },
}

Config.Daily = {
	BaseReward = 100,
	MaxStreakMultiplier = 7,
}

-- Boost definitions. Order here is the order shown in the shop.
Config.Boosts = {
	{
		Id = "Endurance",
		Name = "Endurance",
		Description = "+25 max stamina per level.",
		BaseCost = 100,
		Growth = 1.6,
		MaxLevel = 10,
		PerLevel = 25,
	},
	{
		Id = "Recovery",
		Name = "Deep Breaths",
		Description = "+25% stamina recovery per level.",
		BaseCost = 150,
		Growth = 1.7,
		MaxLevel = 5,
		PerLevel = 0.25,
	},
	{
		Id = "ClimbSpeed",
		Name = "Quick Hands",
		Description = "+10% climbing speed per level.",
		BaseCost = 250,
		Growth = 1.8,
		MaxLevel = 5,
		PerLevel = 0.1,
	},
	{
		Id = "Grip",
		Name = "Sticky Gloves",
		Description = "-8% drain on slippery glass per level.",
		BaseCost = 400,
		Growth = 1.8,
		MaxLevel = 5,
		PerLevel = 0.08,
	},
	{
		Id = "SoftLanding",
		Name = "Rubber Bones",
		Description = "-15% fall damage per level.",
		BaseCost = 200,
		Growth = 1.7,
		MaxLevel = 5,
		PerLevel = 0.15,
	},
	{
		Id = "Rappel",
		Name = "Rappel Kit",
		Description = "Press V on a wall or at a summit to rappel to the ground.",
		BaseCost = 2500,
		Growth = 1,
		MaxLevel = 1,
		PerLevel = 1,
	},
}

-- Climbing rope. Telecom towers: clip a carabiner onto a horizontal beam.
-- Skyscrapers: stick a suction cup onto the glass. Either way the rope is this
-- long, so you clip in again higher as you climb. While clipped, wind can't
-- knock you off, you can rest hanging on the rope, and a fall is caught.
Config.Rope = {
	Length = 16,
	Reach = 7, -- how far from your hands a clip point can be
	RappelSpeed = 35, -- studs/second sliding down with the Rappel Kit
}

-- Tower archetypes. Telecom towers are tapered lattice towers; skyscrapers are
-- glass boxes. Every face has a yellow rest bar at the top of each telecom
-- section / every `BalconyEvery` studs on a skyscraper: hang still on one to
-- catch your breath. Nothing sticks out far enough to block a climber.
Config.TowerTypes = {
	Tutorial = {
		Kind = "Telecom",
		DisplayName = "Tutorial Tower",
		SectionHeight = 20,
		Sections = 4, -- 80 studs
		BaseHalfWidth = 9,
		TopHalfWidth = 3,
		DrainMultiplier = 1,
		Slippery = false,
		Payout = 50,
		Color = { 200, 45, 40 },
	},
	TelecomMedium = {
		Kind = "Telecom",
		DisplayName = "Telecom Tower",
		SectionHeight = 50,
		Sections = 14, -- 700 studs
		BaseHalfWidth = 28,
		TopHalfWidth = 5,
		DrainMultiplier = 1.3,
		Slippery = false,
		Payout = 600,
		Color = { 205, 40, 35 },
	},
	TelecomTall = {
		Kind = "Telecom",
		DisplayName = "Telecom Tower",
		SectionHeight = 70,
		Sections = 15, -- 1050 studs
		BaseHalfWidth = 36,
		TopHalfWidth = 6,
		DrainMultiplier = 1.8,
		Slippery = false,
		Payout = 2000,
		Color = { 210, 35, 30 },
	},
	SkySmall = {
		Kind = "Skyscraper",
		DisplayName = "Skyscraper",
		Height = 1400,
		HalfWidth = 32,
		BalconyEvery = 100,
		DrainMultiplier = 1.6,
		Slippery = true,
		Payout = 1500,
		Color = { 175, 195, 215 },
		Frame = { 225, 225, 220 },
	},
	SkyMedium = {
		Kind = "Skyscraper",
		DisplayName = "Skyscraper",
		Height = 2100,
		HalfWidth = 38,
		BalconyEvery = 150,
		DrainMultiplier = 2.2,
		Slippery = true,
		Payout = 4000,
		Color = { 60, 95, 150 },
		Frame = { 200, 200, 205 },
	},
	SkyLarge = {
		Kind = "Skyscraper",
		DisplayName = "Skyscraper",
		Height = 2800,
		HalfWidth = 46,
		BalconyEvery = 200,
		DrainMultiplier = 3,
		Slippery = true,
		Payout = 10000,
		Helipad = true,
		Color = { 35, 45, 75 },
		Frame = { 70, 75, 90 },
	},
}

-- Map (top-down, north = -Z): plaza at the north end, a path runs south to the
-- Power Up Shop, skyscrapers down the west side, telecom towers down the east.
Config.Layout = {
	{ Type = "SkySmall", Name = "Skyscraper 1", Size = "SMALL", Difficulty = "EASY", X = -190, Z = -300 },
	{ Type = "SkyMedium", Name = "Skyscraper 2", Size = "MEDIUM", Difficulty = "NORMAL", X = -190, Z = -20 },
	{ Type = "SkyLarge", Name = "Skyscraper 3", Size = "LARGE", Difficulty = "HARD", X = -190, Z = 260 },
	{ Type = "Tutorial", Name = "Tutorial Tower", Size = "SMALL", Difficulty = "EASY", X = 190, Z = -300 },
	{ Type = "TelecomMedium", Name = "Telecom Tower 1", Size = "MEDIUM", Difficulty = "NORMAL", X = 190, Z = -20 },
	{ Type = "TelecomTall", Name = "Telecom Tower 2", Size = "TALL", Difficulty = "HARD", X = 190, Z = 260 },
}

Config.Map = {
	IslandHalfX = 330,
	IslandHalfZ = 680,
	LotHalf = 75,
	PathHalfWidth = 14,
	PlazaCenter = { 0, -540 },
	ShopCenter = { 0, 560 },
	WaterLevel = -90,
}

-- Cosmetic trails, unlocked by total climbs. Highest unlocked one is worn.
Config.Trails = {
	{ Climbs = 5, Name = "Bronze", Color = { 205, 127, 50 } },
	{ Climbs = 15, Name = "Silver", Color = { 200, 210, 225 } },
	{ Climbs = 40, Name = "Gold", Color = { 255, 205, 60 } },
	{ Climbs = 100, Name = "Neon", Color = { 80, 255, 220 } },
}

-- Built-in Roblox content sounds, so the place needs no uploaded assets.
Config.Sounds = {
	Summit = "rbxasset://sounds/electronicpingshort.wav",
	Fall = "rbxasset://sounds/action_falling.mp3",
	GetUp = "rbxasset://sounds/action_get_up.mp3",
	Bonk = "rbxasset://sounds/uuhhh.mp3",
	Click = "rbxasset://sounds/action_jump.mp3",
	Grab = "rbxasset://sounds/action_get_up.mp3",
}

Config.DataStoreName = "SkyClimbers_v1"
Config.LeaderboardStoreName = "SkyClimbers_Climbs_v1"
Config.AutosaveInterval = 120
Config.LeaderboardRefresh = 60

return Config
]]></string>
        </Properties>
