; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Frontline FPV - Garage Warfare"
config/description="Garage drone-factory and FPV combat sim: build, test, maintain and deploy your own drones against fictional targets."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
run/max_fps=144

[autoload]

Settings="*res://scripts/autoload/settings.gd"
SaveData="*res://scripts/autoload/save_data.gd"
Audio="*res://scripts/autoload/audio.gd"
Game="*res://scripts/autoload/game.gd"
Career="*res://scripts/autoload/career.gd"
Pad="*res://scripts/autoload/pad.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/size/mode=0
window/size/initial_position_type=1
window/size/window_width_override=1600
window/size/window_height_override=900

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=10

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.07, 1)
anti_aliasing/quality/msaa_3d=0
